<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Simba.Avalonia.Views.Components.PauseOverlay">
    <Border x:Name="PauseIndicator"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Opacity="0" IsVisible="True"
            IsHitTestVisible="False"
            CornerRadius="{StaticResource radius-lg}" Padding="24"
            Background="{StaticResource AppOverlayLight}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" OffsetY="4" Color="#40000000" />
        </Border.Effect>
        <materialIcons:MaterialIcon Kind="Pause"
              Width="40" Height="40"
              Foreground="{StaticResource OsdForeground}" />
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
            </Transitions>
        </Border.Transitions>
    </Border>
</UserControl>
