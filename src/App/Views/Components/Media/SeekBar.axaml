<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Simba.Avalonia.ViewModels"
             x:Class="Simba.Avalonia.Views.Components.SeekBar"
             x:DataType="vm:MainViewModel"
             x:Name="SeekBarRoot">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{StaticResource space-spacing-1}">

        <!-- Seek Area (hexpand, with chapter markers) -->
        <Grid Grid.Column="0"
              x:Name="SeekArea"
              Height="16"
              Margin="{StaticResource space-h-2}"
              PointerMoved="OnSeekAreaPointerMoved"
              PointerExited="OnSeekAreaPointerExited"
              PointerWheelChanged="OnSeekAreaPointerWheelChanged"
              PointerPressed="OnSeekAreaPointerPressed"
              PointerReleased="OnSeekAreaPointerReleased"
              Background="Transparent">

            <Border x:Name="SeekTrack"
                    Background="{StaticResource AppSurfaceRaised}"
                    Opacity="0.9"
                    CornerRadius="{StaticResource radius-xs}"
                    Height="4"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False" />

            <Border x:Name="SeekFill"
                    Background="{StaticResource AppAccent}"
                    CornerRadius="{StaticResource radius-xs}"
                    Height="4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" OffsetY="0" Color="#33B88C4A" />
                </Border.Effect>
            </Border>

            <Border x:Name="SeekThumb"
                Width="14" Height="14"
                CornerRadius="7"
                Background="{StaticResource AppSurfaceOverlay}"
                BorderBrush="{StaticResource AppAccent}"
                BorderThickness="1.5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" OffsetY="1" Color="#60000000" />
                </Border.Effect>
            </Border>

            <ItemsControl x:Name="ChapterMarkersControl"
                          ItemsSource="{Binding ChapterMarkers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas IsHitTestVisible="False" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="3" Height="12"
                              Background="Transparent">
                            <Rectangle Width="3" Height="12"
                                       Fill="{StaticResource OsdForeground}"
                                       Opacity="0.6"
                                       AutomationProperties.Name="Chapter marker" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="ChapterPreviewPopover"
                    IsVisible="True"
                    Opacity="0"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{StaticResource AppSurfaceOverlay}"
                    BorderBrush="{StaticResource AppBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource radius-sm}"
                    Padding="8,4"
                    BoxShadow="{StaticResource elevation-4}"
                    RenderTransformOrigin="0,0">
                <Border.RenderTransform>
                    <TranslateTransform X="0" Y="-26" />
                </Border.RenderTransform>
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                    </Transitions>
                </Border.Transitions>
                <TextBlock x:Name="ChapterPreviewText"
                           Text="Chapter"
                           Classes="md3-caption"
                           Foreground="{StaticResource OsdForeground}" />
            </Border>
        </Grid>

        <TextBlock Grid.Column="1"
                   x:Name="PositionTimeLabel"
                   Classes="time-label"
                   MinWidth="45"
                   Text="00:00"
                   VerticalAlignment="Center"
                   Margin="{StaticResource space-h-1}"
                   PointerPressed="OnPositionTimeLabelPressed"
                   Cursor="Hand" />

        <Border Grid.Column="2"
                Width="1" Height="18"
                Margin="4,0,4,0"
                CornerRadius="1"
                Background="{StaticResource TimeSeparatorBackground}"
                Opacity="0.3"
                VerticalAlignment="Center" />

        <TextBlock Grid.Column="3"
                   x:Name="DurationTimeLabel"
                   Classes="time-label"
                   MinWidth="45"
                   Text="00:00"
                   Margin="{StaticResource space-h-1}"
                   VerticalAlignment="Center"
                   AutomationProperties.Name="Total duration" />
    </Grid>
</UserControl>
