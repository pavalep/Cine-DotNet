<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="140"
             x:Class="Cine.Avalonia.Views.Components.UpgradeCtaContent"
             MinWidth="200">
    <Border Background="{StaticResource PopoverBackground}"
            CornerRadius="{StaticResource radius-md}"
            Padding="{StaticResource space-5}"
            BorderBrush="#FFA500"
            BorderThickness="1">
        <StackPanel Spacing="12" HorizontalAlignment="Center">
            <!-- Lock icon -->
            <Border Background="{StaticResource AppBorderDim}"
                    CornerRadius="{StaticResource radius-full}"
                    Width="{StaticResource size-button-circular}"
                    Height="{StaticResource size-button-circular}"
                    HorizontalAlignment="Center">
                <TextBlock Text="&#x1F512;"
                           Classes="md3-headline6"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <!-- Heading -->
            <TextBlock Text="Premium Feature"
                       Classes="md3-body1"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource OsdForeground}"
                       HorizontalAlignment="Center" />

            <!-- Description -->
            <TextBlock Text="This feature is available in the full version. Upgrade to unlock all capabilities."
                       Classes="md3-caption"
                       Foreground="{StaticResource AppTextOnDarkSecondary}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <!-- Upgrade button -->
            <Button x:Name="UpgradeBtn"
                    Content="Upgrade Now"
                    Classes="md3-body2"
                    FontWeight="SemiBold"
                    Padding="16 6"
                    Background="#FFA500"
                    Foreground="#1A1A1A"
                    BorderThickness="0"
                    CornerRadius="{StaticResource radius-xs}"
                    Cursor="Hand"
                    HorizontalAlignment="Center"
                    Click="OnUpgradeClick" />
        </StackPanel>
    </Border>
</UserControl>
