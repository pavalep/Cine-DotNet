<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Simba.Avalonia.ViewModels"
             xmlns:containers="using:Simba.Avalonia.Views.Components.Containers"
             x:Class="Simba.Avalonia.Views.Components.Panels.VolumePanel"
             x:DataType="vm:MainViewModel">
    <containers:PanelContainer CornerRadius="12"
                               Width="280">
        <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="Volume" Classes="md3-caption"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="VolumePercentLabel"
                           Text="{Binding VolumeValue, StringFormat='\{0\}%'}"
                           Classes="md3-caption"
                           Foreground="{StaticResource OsdForeground}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="Mute"
                        Classes="text-button-small"
                        Click="OnToggleMute" />
            </Grid>
            <Slider x:Name="VolumeSlider"
                    Minimum="0" Maximum="100"
                    Value="{Binding VolumeValue}"
                    Width="240" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                <Button Content="25%" Classes="text-button-small"
                        HorizontalAlignment="Stretch"
                        Click="OnPresetVolume25" />
                <Button Grid.Column="1" Content="50%" Classes="text-button-small"
                        HorizontalAlignment="Stretch"
                        Click="OnPresetVolume50" />
                <Button Grid.Column="2" Content="100%" Classes="text-button-small"
                        HorizontalAlignment="Stretch"
                        Click="OnPresetVolume100" />
            </Grid>
        </StackPanel>
    </containers:PanelContainer>
</UserControl>
