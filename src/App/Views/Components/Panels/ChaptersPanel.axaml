<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:containers="using:Cine.Avalonia.Views.Components.Containers"
             x:Class="Cine.Avalonia.Views.Components.Panels.ChaptersPanel">
    <containers:PanelContainer CornerRadius="12" Padding="8"
                               Width="320" MaxHeight="400"
                               Background="{StaticResource PopoverBackground}">
        <Grid RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="Chapters" Classes="md3-caption"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="8,4,8,4" />
            <ItemsControl x:Name="TrackList"
                          Grid.Row="1"
                          BorderThickness="0"
                          Background="Transparent" />
        </Grid>
    </containers:PanelContainer>
</UserControl>
