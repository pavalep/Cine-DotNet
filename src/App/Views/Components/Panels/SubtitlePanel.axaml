<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:containers="using:Cine.Avalonia.Views.Components.Containers"
             x:Class="Cine.Avalonia.Views.Components.Panels.SubtitlePanel">
    <containers:PanelContainer CornerRadius="12" Padding="8"
                               Width="300" MaxHeight="400"
                               Background="{StaticResource PopoverBackground}">
        <Grid RowDefinitions="Auto,*,Auto">
            <TextBlock Grid.Row="0" Text="Subtitles" Classes="md3-caption"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="8,4,8,4" />
            <ItemsControl x:Name="TrackList"
                          Grid.Row="1"
                          BorderThickness="0"
                          Background="Transparent" />
            <Button Grid.Row="2" Content="Preferences"
                    Classes="text-button-small"
                    Margin="8,4,8,4"
                    Click="OnPreferencesClick" />
        </Grid>
    </containers:PanelContainer>
</UserControl>
