<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:vm="using:Simba.Avalonia.ViewModels"
        x:Class="Simba.Avalonia.Views.Dialogs.PreferencesDialog"
        x:DataType="vm:MainViewModel"
        Title="Preferences"
        Width="520" MinWidth="400" MaxWidth="640"
        MinHeight="320" MaxHeight="700"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <Grid RowDefinitions="Auto,*,Auto" Margin="0">
        <!-- Header -->
        <Grid Grid.Row="0" Classes="dialog-header" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Preferences" Classes="dialog-title" />
            <Button Grid.Column="1" Classes="dialog-close" Click="OnCloseClick" ToolTip.Tip="Close" AutomationProperties.Name="Close dialog">
                <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource size-dialog-close-icon}" Height="{StaticResource size-dialog-close-icon}"
                    Foreground="{StaticResource OsdForeground}" />
            </Button>
        </Grid>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" Margin="12,4,12,0"
                      MaxHeight="600"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource space-spacing-4}" Margin="0,12">

                <!-- License & Features -->
                <TextBlock Text="License &amp; Features" Classes="md3-subtitle1"
                           Foreground="{StaticResource TextSecondary}" />

                <Border Background="{StaticResource PopoverBackground}"
                        CornerRadius="{StaticResource radius-sm}" Padding="{StaticResource space-2}">
                    <StackPanel Spacing="{StaticResource space-spacing-3}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="License Tier" Classes="md3-body2" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="{Binding LicenseLabel}"
                                           Classes="md3-caption"
                                           Foreground="{StaticResource TextTertiary}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LicenseTierDisplay}"
                                       Classes="md3-body2"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Separator Background="{StaticResource PopoverBorder}" Height="1" Margin="0" />
                        <TextBlock Text="Feature Status" Classes="md3-caption" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextTertiary}" />
                        <ItemsControl ItemsSource="{Binding FeatureStatuses}"
                                      BorderThickness="0"
                                      Background="Transparent">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding StatusIcon}"
                                                   Classes="md3-body2"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Classes="md3-caption"
                                                       Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="{Binding Reason}"
                                                       Classes="md3-caption"
                                                       Foreground="{StaticResource TextTertiary}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding StatusLabel}"
                                                   Classes="md3-caption"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- General -->
                <TextBlock Text="General" Classes="md3-subtitle1"
                           Foreground="{StaticResource TextSecondary}" />

                <Border Background="{StaticResource PopoverBackground}"
                        CornerRadius="{StaticResource radius-sm}" Padding="{StaticResource space-2}">
                    <StackPanel Spacing="{StaticResource space-spacing-3}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Audio Normalization" Classes="md3-body2" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Dynamic range compression for consistent volume"
                                           Classes="md3-caption"
                                           Foreground="{StaticResource TextTertiary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          VerticalAlignment="Center" OnContent="" OffContent=""
                                          IsChecked="{Binding IsAudioNormalizationEnabled, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Dialogue Boost" Classes="md3-body2" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Enhance speech clarity using spectral compression"
                                           Classes="md3-caption"
                                           Foreground="{StaticResource TextTertiary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          VerticalAlignment="Center" OnContent="" OffContent=""
                                          IsChecked="{Binding IsDialogueBoostEnabled, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Rendering -->
                <TextBlock Text="Rendering" Classes="md3-subtitle1"
                           Foreground="{StaticResource TextSecondary}" />

                <Border Background="{StaticResource PopoverBackground}"
                        CornerRadius="{StaticResource radius-sm}" Padding="{StaticResource space-2}">
                    <StackPanel Spacing="{StaticResource space-spacing-3}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Hardware Acceleration" Classes="md3-body1" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Use GPU for video decoding and rendering. Disable if experiencing playback issues."
                                           Classes="md3-caption"
                                           Foreground="{StaticResource TextTertiary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          VerticalAlignment="Center" OnContent="" OffContent=""
                                          IsChecked="{Binding IsHardwareAccelerationEnabled, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Subtitles -->
                <TextBlock Text="Subtitles" Classes="md3-subtitle1"
                           Foreground="{StaticResource TextSecondary}" />

                <Border Background="{StaticResource PopoverBackground}"
                        CornerRadius="{StaticResource radius-sm}" Padding="{StaticResource space-2}">
                    <StackPanel Spacing="{StaticResource space-spacing-3}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Auto-load External Subtitles" Classes="md3-body1" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Automatically scan for .srt / .ass files in media directory"
                                           Classes="md3-caption"
                                           Foreground="{StaticResource TextTertiary}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoLoadSubsToggle"
                                          VerticalAlignment="Center" OnContent="" OffContent="" />
                        </Grid>
                        <StackPanel Spacing="{StaticResource space-spacing-1}">
                            <TextBlock Text="Preferred Languages" Classes="md3-caption" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextTertiary}" />
                            <TextBox x:Name="PreferredLangInput"
                                     Text="eng, jpn, und"
                                     Classes="md3-caption"
                                     Padding="{StaticResource space-1}"
                                     Background="{StaticResource AppBackground}"
                                     BorderBrush="{StaticResource PopoverBorder}"
                                     BorderThickness="1" CornerRadius="{StaticResource radius-xs}"
                                     Foreground="{StaticResource TextPrimary}"
                                     AutomationProperties.Name="Preferred subtitle languages" />
                            <TextBlock Text="Comma-separated language codes. First match is auto-selected."
                                       Classes="md3-caption"
                                       Foreground="{StaticResource TextTertiary}" />
                        </StackPanel>
                        <StackPanel Spacing="{StaticResource space-spacing-1}">
                            <TextBlock Text="External Subtitle Directories" Classes="md3-caption" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextTertiary}" />
                            <TextBox x:Name="SubDirsInput"
                                     Text="./subs, ./subtitles"
                                     Classes="md3-caption"
                                     Padding="{StaticResource space-1}"
                                     Background="{StaticResource AppBackground}"
                                     BorderBrush="{StaticResource PopoverBorder}"
                                     BorderThickness="1" CornerRadius="{StaticResource radius-xs}"
                                     Foreground="{StaticResource TextPrimary}"
                                     AutomationProperties.Name="Subtitle directory paths" />
                            <TextBlock Text="Relative to media file directory. Comma-separated."
                                       Classes="md3-caption"
                                       Foreground="{StaticResource TextTertiary}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Keyboard Shortcuts -->
                <TextBlock Text="Keyboard Shortcuts" Classes="md3-subtitle1"
                           Foreground="{StaticResource TextSecondary}" />

                <Border Background="{StaticResource PopoverBackground}"
                        CornerRadius="{StaticResource radius-sm}" Padding="{StaticResource space-2}">
                    <StackPanel Spacing="{StaticResource space-spacing-1}">
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="Space" FontWeight="SemiBold" Classes="md3-caption"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Grid.Column="1" Text="Play / Pause" Classes="md3-caption"
                                       Foreground="{StaticResource TextSecondary}" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="F / F11" FontWeight="SemiBold" Classes="md3-caption"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Grid.Column="1" Text="Toggle Fullscreen" Classes="md3-caption"
                                       Foreground="{StaticResource TextSecondary}" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="← / →" FontWeight="SemiBold" Classes="md3-caption"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Grid.Column="1" Text="Seek ±5s" Classes="md3-caption"
                                       Foreground="{StaticResource TextSecondary}" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="Ctrl+← / Ctrl+→" FontWeight="SemiBold" Classes="md3-caption"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Grid.Column="1" Text="Prev/Next Chapter" Classes="md3-caption"
                                       Foreground="{StaticResource TextSecondary}" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="Shift+← / Shift+→" FontWeight="SemiBold" Classes="md3-caption"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Grid.Column="1" Text="Seek ±30s" Classes="md3-caption"
                                       Foreground="{StaticResource TextSecondary}" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="↑ / ↓" FontWeight="SemiBold" Classes="md3-caption"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Grid.Column="1" Text="Volume ±5%" Classes="md3-caption"
                                       Foreground="{StaticResource TextSecondary}" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="M" FontWeight="SemiBold" Classes="md3-caption"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Grid.Column="1" Text="Mute Toggle" Classes="md3-caption"
                                       Foreground="{StaticResource TextSecondary}" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="C" FontWeight="SemiBold" Classes="md3-caption"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Grid.Column="1" Text="Cycle Subtitles" Classes="md3-caption"
                                       Foreground="{StaticResource TextSecondary}" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="S / Ctrl+S" FontWeight="SemiBold" Classes="md3-caption"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Grid.Column="1" Text="Screenshot" Classes="md3-caption"
                                       Foreground="{StaticResource TextSecondary}" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="Esc" FontWeight="SemiBold" Classes="md3-caption"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Grid.Column="1" Text="Exit Fullscreen" Classes="md3-caption"
                                       Foreground="{StaticResource TextSecondary}" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="Ctrl+P" FontWeight="SemiBold" Classes="md3-caption"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Grid.Column="1" Text="Playlist" Classes="md3-caption"
                                       Foreground="{StaticResource TextSecondary}" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="Ctrl+O" FontWeight="SemiBold" Classes="md3-caption"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Grid.Column="1" Text="Open File" Classes="md3-caption"
                                       Foreground="{StaticResource TextSecondary}" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="Ctrl+Shift+E" FontWeight="SemiBold" Classes="md3-caption"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Grid.Column="1" Text="Equalizer" Classes="md3-caption"
                                       Foreground="{StaticResource TextSecondary}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Button Content="View All Shortcuts (Ctrl+/)"
                        Classes="primary"
                        HorizontalAlignment="Center"
                        Click="OnViewAllShortcutsClick" />

                <!-- About -->
                <TextBlock Text="About" Classes="md3-subtitle1"
                           Foreground="{StaticResource TextSecondary}" />

                <Border Background="{StaticResource PopoverBackground}"
                        CornerRadius="{StaticResource radius-sm}" Padding="{StaticResource space-2}">
                    <StackPanel Spacing="{StaticResource space-spacing-2}" HorizontalAlignment="Center">
                        <Panel Width="48" Height="48" HorizontalAlignment="Center">
                            <Path Data="M 32 2 A 30 30 0 1 1 32 62 A 30 30 0 1 1 32 2 Z"
                                  Fill="{StaticResource AppHoverSubtle}"
                                  Stroke="{StaticResource AppDivider}"
                                  StrokeThickness="2" />
                            <Path Data="M 25 20 L 45 32 L 25 44 Z"
                                  Fill="{StaticResource OsdForeground}" />
                        </Panel>
                        <TextBlock Text="Simba Media Player" Classes="md3-subtitle1" FontWeight="Bold"
                                   Foreground="{StaticResource OsdForeground}" HorizontalAlignment="Center" />
                        <TextBlock Text="Version 1.0.0" Classes="md3-body2"
                                   Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                        <TextBlock Text="Built with Avalonia UI &amp; libmpv" Classes="md3-caption"
                                   Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Spacing="0">
            <Border Height="1" Background="{StaticResource PopoverBorder}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                <Button Content="Reset to Defaults" Classes="flyout-item destructive"
                        Click="OnResetDefaults" />
                <Button Content="Close" Classes="primary"
                        Click="OnCloseClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
