<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:panels="using:Cine.Avalonia.Views.Components.Panels"
        x:Class="Cine.Avalonia.Views.Dialogs.PreferencesWindow"
        Title="Preferences"
        Width="680" Height="480"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <Window.Styles>
        <Style Selector="ListBoxItem.sidebar-item">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="CornerRadius" Value="{StaticResource radius-sm}" />
        </Style>
        <Style Selector="ListBoxItem.sidebar-item:selected">
            <Setter Property="Background" Value="{StaticResource AppAccentSoft}" />
            <Setter Property="Foreground" Value="{StaticResource OsdForeground}" />
        </Style>
        <Style Selector="ListBoxItem.sidebar-item:pointerover">
            <Setter Property="Background" Value="{StaticResource AppHoverSubtle}" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="200,*">
        <!-- ── Sidebar ── -->
        <Border Grid.Column="0" Background="{StaticResource AppBackgroundAlt}">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Sidebar header -->
                <StackPanel Grid.Row="0" Margin="16,20,16,12">
                    <TextBlock Text="Preferences"
                               Classes="md3-title1"
                               Foreground="{StaticResource OsdForeground}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Appearance &amp; playback settings"
                               Classes="md3-caption"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- Navigation items -->
                <ListBox x:Name="SidebarList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectedIndex="0"
                         SelectionChanged="OnSidebarSelectionChanged">
                    <ListBoxItem x:Name="SidebarGeneral" Classes="sidebar-item" Content="General" />
                    <ListBoxItem x:Name="SidebarAudio" Classes="sidebar-item" Content="Audio" />
                    <ListBoxItem x:Name="SidebarSubtitles" Classes="sidebar-item" Content="Subtitles" />
                    <ListBoxItem x:Name="SidebarEqualizer" Classes="sidebar-item" Content="Equalizer" />
                    <ListBoxItem x:Name="SidebarAbout" Classes="sidebar-item" Content="About" />
                </ListBox>

                <!-- Window close button at bottom -->
                <Button Grid.Row="2" Content="Close"
                        Classes="primary"
                        Margin="12,8,12,12"
                        HorizontalAlignment="Stretch"
                        Click="OnCloseClick" />
            </Grid>
        </Border>

        <!-- ── Content Area ── -->
        <Border Grid.Column="1" Background="{StaticResource AppBackground}" Padding="24">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{StaticResource space-spacing-4}">

                <!-- ════════════════════════════════════════ -->
                <!-- GENERAL                                  -->
                <!-- ════════════════════════════════════════ -->
                <Border x:Name="PanelGeneral" Classes="settings-card"
                        Padding="20">
                    <StackPanel Spacing="{StaticResource space-spacing-4}">
                        <TextBlock Text="General Settings" Classes="md3-subtitle1"
                                   Foreground="{StaticResource OsdForeground}" FontWeight="SemiBold" />

                        <!-- Hardware Acceleration -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Hardware Acceleration" Classes="md3-body2" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Use GPU for video decoding and rendering. Disable if experiencing playback issues."
                                           Classes="md3-caption"
                                           Foreground="{StaticResource TextTertiary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          VerticalAlignment="Center" OnContent="" OffContent="" />
                        </Grid>

                        <Separator Background="{StaticResource AppBorderSubtle}" Height="1" Margin="0" Opacity="0.6" />

                        <!-- Keyboard Shortcuts placeholder -->
                        <TextBlock Text="Keyboard shortcuts are managed via the main window."
                                   Classes="md3-caption"
                                   Foreground="{StaticResource TextTertiary}" />
                    </StackPanel>
                </Border>

                <!-- ════════════════════════════════════════ -->
                <!-- AUDIO                                    -->
                <!-- ════════════════════════════════════════ -->
                <Border x:Name="PanelAudio" Classes="settings-card"
                        Padding="20"
                        IsVisible="False">
                    <StackPanel Spacing="{StaticResource space-spacing-4}">
                        <TextBlock Text="Audio Settings" Classes="md3-subtitle1"
                                   Foreground="{StaticResource OsdForeground}" FontWeight="SemiBold" />

                        <!-- Audio Normalization -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Audio Normalization" Classes="md3-body2" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Dynamic range compression for consistent volume"
                                           Classes="md3-caption"
                                           Foreground="{StaticResource TextTertiary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          VerticalAlignment="Center" OnContent="" OffContent="" />
                        </Grid>

                        <!-- Dialogue Boost -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Dialogue Boost" Classes="md3-body2" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Enhance speech clarity using spectral compression"
                                           Classes="md3-caption"
                                           Foreground="{StaticResource TextTertiary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          VerticalAlignment="Center" OnContent="" OffContent="" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ════════════════════════════════════════ -->
                <!-- SUBTITLES                                -->
                <!-- ════════════════════════════════════════ -->
                <Border x:Name="PanelSubtitles" Classes="settings-card"
                        Padding="20"
                        IsVisible="False">
                    <StackPanel Spacing="{StaticResource space-spacing-4}">
                        <TextBlock Text="Subtitle Settings" Classes="md3-subtitle1"
                                   Foreground="{StaticResource OsdForeground}" FontWeight="SemiBold" />

                        <!-- Auto-load External Subtitles -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Auto-load External Subtitles" Classes="md3-body2" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Automatically scan for .srt / .ass files in media directory"
                                           Classes="md3-caption"
                                           Foreground="{StaticResource TextTertiary}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoLoadSubsToggle"
                                          VerticalAlignment="Center" OnContent="" OffContent="" />
                        </Grid>

                        <Separator Background="{StaticResource AppBorderSubtle}" Height="1" Margin="0" Opacity="0.6" />

                        <!-- Preferred Languages -->
                        <StackPanel Spacing="{StaticResource space-spacing-1}">
                            <TextBlock Text="Preferred Languages" Classes="md3-caption" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextTertiary}" />
                            <TextBox x:Name="PreferredLangInput"
                                     Text="eng, jpn, und"
                                     Classes="md3-caption"
                                     Padding="{StaticResource space-1}"
                                     Background="{StaticResource AppBackground}"
                                     BorderBrush="{StaticResource AppBorderSubtle}"
                                     BorderThickness="1" CornerRadius="{StaticResource radius-xs}"
                                     Foreground="{StaticResource TextPrimary}"
                                     AutomationProperties.Name="Preferred subtitle languages" />
                            <TextBlock Text="Comma-separated language codes. First match is auto-selected."
                                       Classes="md3-caption"
                                       Foreground="{StaticResource TextTertiary}" />
                        </StackPanel>

                        <!-- External Subtitle Directories -->
                        <StackPanel Spacing="{StaticResource space-spacing-1}">
                            <TextBlock Text="External Subtitle Directories" Classes="md3-caption" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextTertiary}" />
                            <TextBox x:Name="SubDirsInput"
                                     Text="./subs, ./subtitles"
                                     Classes="md3-caption"
                                     Padding="{StaticResource space-1}"
                                     Background="{StaticResource AppBackground}"
                                     BorderBrush="{StaticResource AppBorderSubtle}"
                                     BorderThickness="1" CornerRadius="{StaticResource radius-xs}"
                                     Foreground="{StaticResource TextPrimary}"
                                     AutomationProperties.Name="Subtitle directory paths" />
                            <TextBlock Text="Relative to media file directory. Comma-separated."
                                       Classes="md3-caption"
                                       Foreground="{StaticResource TextTertiary}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ════════════════════════════════════════ -->
                <!-- EQUALIZER                                -->
                <!-- ════════════════════════════════════════ -->
                <Border x:Name="PanelEqualizer" Classes="settings-card"
                        Padding="20"
                        IsVisible="False">
                    <panels:EqualizerPanel x:Name="PrefEqualizerPanel" />
                </Border>

                <!-- ════════════════════════════════════════ -->
                <!-- ABOUT                                    -->
                <!-- ════════════════════════════════════════ -->
                <Border x:Name="PanelAbout" Classes="settings-card"
                        Padding="24"
                        IsVisible="False">
                    <StackPanel Spacing="0" HorizontalAlignment="Center" MinWidth="280">
                        <!-- Logo area -->
                        <Border CornerRadius="12" Width="64" Height="64"
                                HorizontalAlignment="Center"
                                Background="{StaticResource AppAccentSoft}"
                                BorderBrush="{StaticResource AppBorderSubtle}"
                                BorderThickness="1">
                            <Path Data="M 24 16 L 48 32 L 24 48 Z"
                                  Fill="{StaticResource AppAccent}" />
                        </Border>

                        <TextBlock Text="Cine Media Player" Classes="md3-subtitle1" FontWeight="Bold"
                                   Foreground="{StaticResource OsdForeground}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,2" />
                        <TextBlock Text="Version 1.0.0" Classes="md3-caption"
                                   Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Built with Avalonia UI &amp; libmpv" Classes="md3-caption"
                                   Foreground="{StaticResource TextTertiary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20" />

                        <!-- Divider -->
                        <Separator Background="{StaticResource AppBorderSubtle}" Height="1"
                                   Margin="0,0,0,20" Opacity="0.6" />

                        <!-- License section -->
                        <TextBlock Text="License" Classes="md3-body2" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Open Source · MIT License"
                                   Classes="md3-caption"
                                   Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="All features active in this build"
                                   Classes="md3-caption"
                                   Foreground="{StaticResource TextTertiary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,20" />

                        <!-- Divider -->
                        <Separator Background="{StaticResource AppBorderSubtle}" Height="1"
                                   Margin="0,0,0,20" Opacity="0.6" />

                        <!-- Reset button -->
                        <Button Content="Reset All Settings to Defaults"
                                Classes="flyout-item destructive"
                                HorizontalAlignment="Center"
                                MinWidth="220"
                                Click="OnResetDefaults" />
                    </StackPanel>
                </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
