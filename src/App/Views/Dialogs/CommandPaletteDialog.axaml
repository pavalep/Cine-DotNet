<Window xmlns="https://github.com/avaloniaui"
        xmlns:dlg="clr-namespace:Simba.Avalonia.Views.Dialogs"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DesignWidth="480" d:DesignHeight="360"
        x:Class="Simba.Avalonia.Views.Dialogs.CommandPaletteDialog"
        Title="Command Palette"
        Width="480" Height="400"
        MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True">

    <Grid RowDefinitions="Auto,Auto,*" Margin="0">
        <!-- Search input -->
        <Border Grid.Row="0" Background="{StaticResource PopoverBackground}"
                BorderBrush="{StaticResource AppAccent}" BorderThickness="2"
                CornerRadius="{StaticResource radius-md}" Margin="16,16,16,0">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="{StaticResource space-2},0">
                <materialIcons:MaterialIcon Grid.Column="0" Kind="Magnify"
                    Foreground="{StaticResource TextTertiary}"
                    Width="20" Height="20"
                    VerticalAlignment="Center" Margin="4,0" />
                <TextBox x:Name="SearchBox" Grid.Column="1"
                         PlaceholderText="Search commands…"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource TextPrimary}"
                         Classes="md3-body1"
                         TextChanged="OnSearchChanged"
                         KeyDown="OnSearchKeyDown" />
                <TextBlock Grid.Column="2" Text="Ctrl+K"
                           Foreground="{StaticResource TextTertiary}"
                           Classes="md3-caption"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Results count -->
        <TextBlock x:Name="ResultsCountText" Grid.Row="1"
                   Foreground="{StaticResource TextTertiary}"
                   Classes="md3-caption" Margin="20,8,20,0" />

        <!-- Results list -->
        <ScrollViewer Grid.Row="2" Margin="{StaticResource space-2}" Background="Transparent">
            <ItemsControl x:Name="CommandsList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="dlg:PaletteCommandEntry">
                        <Border Padding="12,8" CornerRadius="{StaticResource radius-sm}" Margin="{StaticResource space-v-0_5}"
                                Background="Transparent"
                                PointerPressed="OnCommandItemPressed">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Description}"
                                           Foreground="{StaticResource TextPrimary}"
                                           Classes="md3-body2"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
