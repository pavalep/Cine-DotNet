                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <!-- Wordmark -->
                            <TextBlock Text="SIMBA"
                                       FontFamily="Outfit"
                                       FontSize="{StaticResource WordmarkFontSize}"
                                       FontWeight="Bold"
                                       LetterSpacing="8"
                                       Foreground="{StaticResource AppTextPrimary}"
                                       Margin="0,0,0,10" />

                            <!-- Tagline -->
                            <TextBlock Text="Play anything."
                                       FontFamily="Outfit"
                                       FontSize="{StaticResource TaglineFontSize}"
                                       FontWeight="Light"
                                       LetterSpacing="0.3"
                                       Foreground="{StaticResource AppTextOnDarkTertiary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>


                    <!-- ── Glass Panel — col 1, spans all rows, vertically centered ── -->
                    <StackPanel x:Name="GlassPanelWrapper" Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                                VerticalAlignment="Center"
                                MaxWidth="500"
                                Spacing="24">

                            <!-- ════ GLASS PANEL ════ -->
                            <!-- Note: HTML uses backdrop-filter: blur(24px) for the glass frosted effect.
                                 Avalonia doesn't natively support backdrop-filter. The semi-transparent
                                 Background with the DropShadowEffect provides a visual approximation. -->
                            <Border x:Name="MainGlassPanel"
                                    Background="{StaticResource StartGlassBg}"
                                    BorderBrush="{StaticResource StartGlassBorder}"
                                    BorderThickness="0.5"
                                    CornerRadius="{StaticResource radius-xl}">
                                <Border.Effect>
                                    <!-- Approximating HTML 0 16px 48px -12px rgba(0,0,0,0.6) — Avalonia lacks spread, so reduced BlurRadius compensates -->
                                    <DropShadowEffect BlurRadius="36" OffsetX="0" OffsetY="16"
                                                      Color="#000000" Opacity="0.6" />
                                </Border.Effect>
                                <Border.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="BorderBrush" Duration="0:0:0.3" />
                                    </Transitions>
                                </Border.Transitions>

                                <Grid x:Name="GlassPanelGrid" RowDefinitions="Auto,Auto"
                                      Margin="28,32,28,28">

                                    <!-- Inner top highlight stripe (0.5px equivalent via scale) -->
                                    <Border Grid.RowSpan="2"
                                            Background="{StaticResource StartGlassEdge}"
                                            Height="1" VerticalAlignment="Top"
                                            CornerRadius="{StaticResource radius-xl}"
                                            IsHitTestVisible="False"
                                            RenderTransformOrigin="0,0">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleY="0.5" />
                                        </Border.RenderTransform>
                                    </Border>

                                    <!-- ── "Start" label ── -->
                                    <TextBlock Grid.Row="0"
                                               Text="Start"
                                               FontSize="11" FontWeight="Medium"
                                               Classes="md3-caption"
                                               LetterSpacing="1"
                                               Foreground="{StaticResource AppTextOnDarkHint}"
                                               Margin="0,0,0,16" />



                                    <!-- ── Action buttons (flex-fill, equal width) ── -->
                                    <Grid Grid.Row="1"
                                          ColumnDefinitions="*,*"
                                          HorizontalAlignment="Stretch"
                                          ColumnSpacing="10">

                                        <!-- Open Media (primary — glass style, matching HTML .btn-primary) -->
                                        <Button x:Name="BtnOpenFile"
                                                Grid.Column="0"
                                                Height="40"
                                                Padding="20,0"
                                                HorizontalAlignment="Stretch"
                                                CornerRadius="{StaticResource radius-md}"
                                                Background="{StaticResource StartGlassBg}"
                                                BorderThickness="0.5"
                                                BorderBrush="{StaticResource StartGlassBorder}"
                                                Click="BtnOpenFile_Click"
                                                AutomationProperties.Name="Open media file">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="FileOutline"
                                                    Width="16" Height="16"
                                                    Foreground="{StaticResource AppTextOnDarkSecondary}"
                                                    Opacity="0.7" />
                                                <TextBlock Text="Open Media"
                                                           FontSize="13" FontWeight="Medium"
                                                           Foreground="{StaticResource AppTextPrimary}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Open Folder (secondary — ghost, matching HTML .btn-secondary) -->
                                        <Button x:Name="BtnOpenFolder"
                                                Grid.Column="1"
                                                Height="40"
                                                Padding="20,0"
                                                HorizontalAlignment="Stretch"
                                                CornerRadius="{StaticResource radius-md}"
                                                Background="Transparent"
                                                BorderThickness="0.5"
                                                BorderBrush="{StaticResource StartGlassBorder}"
                                                Click="BtnOpenFolder_Click"
                                                AutomationProperties.Name="Open media folder">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="FolderOutline"
                                                    Width="16" Height="16"
                                                    Foreground="{StaticResource AppTextOnDarkSecondary}"
                                                    Opacity="0.7" />
                                                <TextBlock Text="Open Folder"
                                                           FontSize="13" FontWeight="Medium"
                                                           Foreground="{StaticResource AppTextOnDarkSecondary}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                    </Grid>
                                </Grid>
                            </Border>

                    </StackPanel><!-- /Panel+Recent col 1 -->

                    <!-- ── Window Controls — top-right ── -->
                    <StackPanel Grid.Column="2" Grid.Row="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Spacing="0"
                                Margin="0,-8,0,0">
                        <Button x:Name="StartBtnMinimize"
                                Classes="window-control"
                                ToolTip.Tip="Minimize"
                                AutomationProperties.Name="Minimize window"
                                Click="OnStartMinimizeClick">
                            <materialIcons:MaterialIcon Kind="WindowMinimize" Width="12" Height="12"
                                Foreground="{StaticResource AppTextOnDarkSecondary}" />
                        </Button>
                        <Button x:Name="StartBtnMaximizeRestore"
                                Classes="window-control"
                                ToolTip.Tip="Maximize"
                                AutomationProperties.Name="Maximize window"
                                Click="OnStartMaximizeRestoreClick">
                            <materialIcons:MaterialIcon x:Name="StartMaximizeRestoreIcon" Kind="WindowMaximize" Width="12" Height="12"
                                Foreground="{StaticResource AppTextOnDarkSecondary}" />
                        </Button>
                        <Button x:Name="StartBtnClose"
                                Classes="window-control close"
                                ToolTip.Tip="Close"
                                AutomationProperties.Name="Close window"
                                Click="OnStartCloseClick">
                            <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12"
                                Foreground="{StaticResource AppTextOnDarkSecondary}" />
                        </Button>
                    </StackPanel>

                </Grid><!-- /WideLayout -->

                <!-- ════ RECENT SECTION — full-width below WideLayout, hidden in narrow mode ════ -->
                <StackPanel x:Name="RecentSection"
                            Spacing="12"
                            Margin="48,0,48,0"
                            IsVisible="True">

                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,0">
                        <TextBlock Grid.Column="0"
                                   Text="Recent"
                                   FontSize="11" FontWeight="Medium"
                                   Classes="md3-caption"
                                   LetterSpacing="1"
                                   Foreground="{StaticResource AppTextOnDarkHint}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="2"
                                Padding="10,2"
                                CornerRadius="{StaticResource radius-full}"
                                Background="{StaticResource AppHoverSubtle}"
                                BorderThickness="0.5"
                                BorderBrush="{StaticResource StartGlassBorder}"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="RecentCountText"
                                       Text="0"
                                       FontSize="11"
                                       Foreground="{StaticResource AppTextOnDarkHint}" />
                        </Border>
                    </Grid>

                    <!-- Empty state (visible when no recent files) -->
                    <TextBlock x:Name="EmptyStateText"
                               Text="No recent media"
                               Classes="md3-body2"
                               Foreground="{StaticResource AppTextOnDarkHint}"
                               HorizontalAlignment="Center"
                               Padding="0,24,0,24" />

                    <!-- Card track — end-to-end, small horizontal padding -->
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  Padding="0,0,0,6">
                        <StackPanel x:Name="RecentTracks"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    Margin="2,0,2,0" />
                    </ScrollViewer>

                </StackPanel>

                <!-- ═══════════════════════════════════════════════════
                     NARROW LAYOUT  (< 820px) — single centered column
                     Brand centered top, panel below, recent below that
                     Shown/hidden via code-behind (StartPage.axaml.cs)
                     ═══════════════════════════════════════════════════ -->
                <StackPanel x:Name="NarrowLayout"
                            IsVisible="False"
                            HorizontalAlignment="Center"
                            MaxWidth="460"
                            Spacing="24"
                            Margin="20,48,20,32">

                    <!-- ── Window Controls — top-right in narrow layout ── -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Spacing="0"
                                Margin="0,-32,4,0">
                        <Button x:Name="StartBtnMinimizeNarrow"
                                Classes="window-control"
                                ToolTip.Tip="Minimize"
                                AutomationProperties.Name="Minimize window"
                                Click="OnStartMinimizeClick">
                            <materialIcons:MaterialIcon Kind="WindowMinimize" Width="12" Height="12"
                                Foreground="{StaticResource AppTextOnDarkSecondary}" />
                        </Button>
                        <Button x:Name="StartBtnMaximizeRestoreNarrow"
                                Classes="window-control"
                                ToolTip.Tip="Maximize"
                                AutomationProperties.Name="Maximize window"
                                Click="OnStartMaximizeRestoreClick">
                            <materialIcons:MaterialIcon Kind="WindowMaximize" Width="12" Height="12"
                                Foreground="{StaticResource AppTextOnDarkSecondary}" />
                        </Button>
                        <Button x:Name="StartBtnCloseNarrow"
                                Classes="window-control close"
                                ToolTip.Tip="Close"
                                AutomationProperties.Name="Close window"
                                Click="OnStartCloseClick">
                            <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12"
                                Foreground="{StaticResource AppTextOnDarkSecondary}" />
                        </Button>
                    </StackPanel>

                    <!-- Brand — centered -->
                    <StackPanel HorizontalAlignment="Center" Spacing="0">
                        <Border Width="72" Height="72"
                                CornerRadius="{StaticResource radius-xl}"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,12">
                            <Viewbox Stretch="Uniform">
                                <Canvas Width="215" Height="215">
                                    <Ellipse Canvas.Left="0" Canvas.Top="0" Width="214.4" Height="214.4"
                                             Stroke="{StaticResource StartAccent}" StrokeThickness="0.5" Opacity="0.2" />
                                    <Path Fill="{StaticResource StartAccent}" Data="M108.055 140.122c0 1.27 2.13 6.353 5.42 12.933 6.135 12.27 7.791 17.186 8.17 24.24.551 10.281-2.974 18.923-11.16 27.351-1.542 1.585-2.76 2.922-2.708 2.965.232.205 5.324-3.185 7.669-5.104 5.153-4.223 9.422-10.913 11.166-17.507 1.114-4.202 1.132-11.354.043-15.785-1.702-6.925-5.33-13.376-11.956-21.253-1.885-2.24-4.15-5.052-5.034-6.245-.888-1.194-1.61-1.913-1.61-1.595Zm-4.25-28.18c-.389.663-2.341 3.555-4.34 6.429-5.952 8.562-7.907 13.737-8.333 22.027-.269 5.275.48 10.276 2.35 15.64 2.167 6.23 4.723 10.928 12.52 23.037 5.144 7.987 6.622 11.669 6.595 16.455-.016 3.149.119 3.032 1.86-1.585 1.025-2.718 1.138-3.44 1.15-7.278.016-6.343-1.434-11.01-7.371-23.704-5.582-11.94-7.583-17.807-8.342-24.447-.701-6.133-.061-10.552 2.809-19.35 1.487-4.556 2.387-8.427 1.965-8.427-.09 0-.475.541-.863 1.202Z" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="SIMBA"
                                   FontFamily="Outfit"
                                   FontSize="36" FontWeight="Bold" LetterSpacing="6"
                                   Foreground="{StaticResource AppTextPrimary}"
                                   HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Play anything."
                                   FontFamily="Outfit"
                                   FontSize="14" FontWeight="Light"
                                   Foreground="{StaticResource AppTextOnDarkTertiary}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Glass panel (reuses same names — code-behind uses x:Name refs) -->
                    <!-- Note: HTML uses backdrop-filter: blur(24px) for the glass frosted effect.
                         Avalonia doesn't natively support backdrop-filter. The semi-transparent
                         Background with the DropShadowEffect provides a visual approximation. -->
                    <Border x:Name="MainGlassPanelNarrow"
                            Background="{StaticResource StartGlassBg}"
                            BorderBrush="{StaticResource StartGlassBorder}"
                            BorderThickness="0.5"
                            CornerRadius="{StaticResource radius-xl}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="36" OffsetX="0" OffsetY="16" Color="#000000" Opacity="0.6" />
                        </Border.Effect>
                        <Grid x:Name="GlassPanelGridNarrow" RowDefinitions="Auto,Auto" Margin="28,32,28,28">
                            <Border Grid.RowSpan="2" Background="{StaticResource StartGlassEdge}"
                                    Height="1" VerticalAlignment="Top"
                                    CornerRadius="{StaticResource radius-xl}" IsHitTestVisible="False"
                                    RenderTransformOrigin="0,0">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="0.5" />
                                </Border.RenderTransform>
                            </Border>
                            <TextBlock Grid.Row="0" Text="Start" FontSize="11" FontWeight="Medium"
                                       Classes="md3-caption"
                                       LetterSpacing="1" Foreground="{StaticResource AppTextOnDarkHint}"
                                       Margin="0,0,0,14" />

                            <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="8">
                                <Button Height="40" HorizontalAlignment="Stretch"
                                        CornerRadius="{StaticResource radius-md}"
                                        Background="{StaticResource StartGlassBg}"
                                        BorderThickness="0.5" BorderBrush="{StaticResource StartGlassBorder}"
                                        Click="BtnOpenFile_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="FileOutline" Width="16" Height="16"
                                            Foreground="{StaticResource AppTextOnDarkSecondary}" Opacity="0.7" />
                                        <TextBlock Text="Open Media" FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource AppTextPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Height="40" HorizontalAlignment="Stretch"
                                        CornerRadius="{StaticResource radius-md}"
                                        Background="Transparent"
                                        BorderThickness="0.5" BorderBrush="{StaticResource StartGlassBorder}"
                                        Click="BtnOpenFolder_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="FolderOutline" Width="16" Height="16"
                                            Foreground="{StaticResource AppTextOnDarkSecondary}" Opacity="0.7" />
                                        <TextBlock Text="Open Folder" FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource AppTextOnDarkSecondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Recent section narrow -->
                    <StackPanel x:Name="RecentSectionNarrow" Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="Recent" FontSize="11" FontWeight="Medium"
                                       Classes="md3-caption"
                                       LetterSpacing="1" Foreground="{StaticResource AppTextOnDarkHint}" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Padding="10,2" CornerRadius="{StaticResource radius-full}"
                                    Background="{StaticResource AppHoverSubtle}" BorderThickness="0.5"
                                    BorderBrush="{StaticResource StartGlassBorder}" VerticalAlignment="Center">
                                <TextBlock x:Name="RecentCountTextNarrow" Text="0" FontSize="11"
                                           Foreground="{StaticResource AppTextOnDarkHint}" />
                            </Border>
                        </Grid>

                        <!-- Empty state (visible when no recent files) -->
                        <TextBlock x:Name="EmptyStateTextNarrow"
                                   Text="No recent media"
                                   Classes="md3-body2"
                                   Foreground="{StaticResource AppTextOnDarkHint}"
                                   HorizontalAlignment="Center"
                                   Padding="0,24,0,24" />

                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,4">
                            <StackPanel x:Name="RecentTracksNarrow" Orientation="Horizontal" Spacing="8" Margin="0,2,0,2" />
                        </ScrollViewer>
                    </StackPanel>

                </StackPanel><!-- /NarrowLayout -->

                </StackPanel><!-- /outer wrapper -->
                </Panel><!-- /ViewportPanel -->
            </ScrollViewer>

            <!-- ════ KEYBOARD HINT — bottom right ════ -->
            <Border x:Name="KbdHint"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,24,24" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border Padding="6,2" CornerRadius="{StaticResource radius-xs}"
                            Background="{StaticResource AppHoverSubtle}"
                            BorderThickness="0.5" BorderBrush="{StaticResource StartGlassBorder}">
                        <TextBlock x:Name="KbdModifierText" Text="Ctrl" FontSize="10"
                                   Foreground="{StaticResource AppTextOnDarkSecondary}" />
                    </Border>
                    <Border Padding="6,2" CornerRadius="{StaticResource radius-xs}"
                            Background="{StaticResource AppHoverSubtle}"
                            BorderThickness="0.5" BorderBrush="{StaticResource StartGlassBorder}">
                        <TextBlock Text="O" FontSize="10"
                                   Foreground="{StaticResource AppTextOnDarkSecondary}" />
                    </Border>
                    <TextBlock Text="Open file" FontSize="11"
                               Foreground="{StaticResource AppTextOnDarkHint}"
                               VerticalAlignment="Center" Margin="2,0,0,0" />
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</UserControl>
