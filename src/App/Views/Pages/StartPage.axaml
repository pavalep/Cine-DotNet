<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="using:Cine.Avalonia.ViewModels"
             xmlns:pages="using:Cine.Avalonia.ViewModels.Pages"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cine.Avalonia.Views.Components.StartPage"
             x:DataType="pages:StartPageViewModel">

    <UserControl.Resources>
        <Color x:Key="Bronze">#C9A96E</Color>
        <Color x:Key="BronzeLight">#D4B88C</Color>
        <SolidColorBrush x:Key="StartAccent"       Color="{StaticResource Bronze}" />
        <SolidColorBrush x:Key="StartAccentBorder"  Color="#33C9A96E" />
        <SolidColorBrush x:Key="StartAccentDim"     Color="#1FC9A96E" />
        <!-- ── Glass surfaces matching HTML exactly ── -->
        <SolidColorBrush x:Key="StartGlassBg"       Color="#05FFFFFF" />  <!-- rgba(255,255,255,0.02) -->
        <SolidColorBrush x:Key="StartGlassBorder"   Color="#0DFFFFFF" />  <!-- rgba(255,255,255,0.05) -->
        <SolidColorBrush x:Key="StartGlassEdge"     Color="#0AFFFFFF" />  <!-- rgba(255,255,255,0.04) highlight -->
        <SolidColorBrush x:Key="CardGlassBg"        Color="#06FFFFFF" />  <!-- rgba(255,255,255,0.025) -->
        <SolidColorBrush x:Key="CardGlassBorder"    Color="#0FFFFFFF" />  <!-- rgba(255,255,255,0.06) -->

        <RadialGradientBrush x:Key="BgRadialWarm" Center="0.5,0.4" GradientOrigin="0.5,0.4">
            <GradientStop Offset="0"   Color="#0AC9A96E" />
            <GradientStop Offset="0.7" Color="#00C9A96E" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="BgRadialCool" Center="0.7,0.8" GradientOrigin="0.7,0.8">
            <GradientStop Offset="0"   Color="#04FFFFFF" />
            <GradientStop Offset="0.6" Color="#00FFFFFF" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="BgRadialLeft" Center="0.2,0.6" GradientOrigin="0.2,0.6">
            <GradientStop Offset="0"   Color="#06C9A96E" />
            <GradientStop Offset="0.5" Color="#00C9A96E" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="GlowOrbBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5">
            <GradientStop Offset="0"   Color="#14C9A96E" />
            <GradientStop Offset="0.6" Color="#07C9A96E" />
            <GradientStop Offset="1"   Color="#00C9A96E" />
        </RadialGradientBrush>

        <!-- Fluid sizes (Avalonia has no clamp(); these are set per-breakpoint in code) -->
        <sys:Double x:Key="WordmarkFontSize">32</sys:Double>
        <sys:Double x:Key="TaglineFontSize">14</sys:Double>
    </UserControl.Resources>

    <UserControl.Styles>

        <!-- ── App entrance: full fade-in (matching HTML appFadeIn 500ms, 100ms delay) ── -->
        <Style Selector="Border#StartPageRoot">
            <Setter Property="Opacity" Value="0" />
            <Style.Animations>
                <Animation Duration="0:0:0.5" Delay="0:0:0.1" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ── Brand panel: fade + slide in from top ── -->
        <Style Selector="StackPanel#BrandPanel">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="-10" /></Setter.Value></Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.5" Delay="0:0:0.25" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-10" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ── Logo stagger (faster than brand) ── -->
        <Style Selector="Viewbox#BrandLogo">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="-4" /></Setter.Value></Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.4" Delay="0:0:0.15" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-4" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ── Glass panel: materialize from below ── -->
        <Style Selector="Border#MainGlassPanel">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="14" /></Setter.Value></Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.6" Delay="0:0:0.18" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="14" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ── Recent section: fade up ── -->
        <Style Selector="StackPanel#RecentSection">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="10" /></Setter.Value></Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.5" Delay="0:0:0.45" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="10" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ── Glow orb: gentle float matching HTML @keyframes orbFloat (12s, 3 keyframes, scale+translate) ── -->
        <Style Selector="Ellipse#GlowOrb">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <TranslateTransform X="0" Y="0" />
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:12" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="0.6" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="TranslateTransform.X" Value="15" />
                        <Setter Property="TranslateTransform.Y" Value="-15" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1.05" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.05" />
                        <Setter Property="Opacity" Value="0.8" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="0.6" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ── Kbd hint fade in late ── -->
        <Style Selector="Border#KbdHint">
            <Setter Property="Opacity" Value="0" />
            <Style.Animations>
                <Animation Duration="0:0:0.5" Delay="0:0:0.9" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">  <Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ── Focus-visible ring for all buttons ── -->
        <Style Selector="Button:focus-visible">
            <Setter Property="BorderBrush" Value="{StaticResource StartAccent}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>



        <!-- ── Open File button hover/press (matching HTML .btn-primary) ── -->
        <Style Selector="Button#BtnOpenFile">
            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="0"/></Setter.Value></Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="TranslateTransform.Y" Duration="0:0:0.15" Easing="CubicEaseOut" />
                    <BrushTransition  Property="Background"           Duration="0:0:0.15" />
                    <BrushTransition  Property="BorderBrush"          Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button#BtnOpenFile:pointerover">
            <Setter Property="Background" Value="{StaticResource AppHover}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderLight}" />
            <Setter Property="TranslateTransform.Y" Value="-1" />
        </Style>
        <Style Selector="Button#BtnOpenFile:pressed">
            <Setter Property="TranslateTransform.Y" Value="0" />
        </Style>

        <!-- ── Open Folder button hover/press (matching HTML .btn-secondary) ── -->
        <Style Selector="Button#BtnOpenFolder">
            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="0"/></Setter.Value></Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="TranslateTransform.Y" Duration="0:0:0.15" Easing="CubicEaseOut" />
                    <BrushTransition  Property="Background"           Duration="0:0:0.15" />
                    <BrushTransition  Property="BorderBrush"          Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button#BtnOpenFolder:pointerover">
            <Setter Property="Background" Value="{StaticResource StartGlassBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderLight}" />
            <Setter Property="TranslateTransform.Y" Value="-1" />
        </Style>
        <Style Selector="Button#BtnOpenFolder:pressed">
            <Setter Property="TranslateTransform.Y" Value="0" />
        </Style>

        <!-- ── Glass panel hover glow ── -->
        <Style Selector="Border#MainGlassPanel:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource StartAccentBorder}" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="BoxShadow" Value="0 0 24 0 #20C9A96E" />
        </Style>

        <!-- ── Reduced motion ──
             HTML uses @media (prefers-reduced-motion: reduce) to disable animations.
             Avalonia can check System.PlatformInfo?.IsAnimationEnabled at startup
             and toggle a class on the root to disable transitions/animations.
             For now, animations remain enabled by default.
        -->

    </UserControl.Styles>

    <Border x:Name="StartPageRoot" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid>

            <!-- ══ BACKGROUND ══════════════════════════════ -->
            <!-- Base gradient: matches HTML linear-gradient(170deg, #08080A, #0C0C0E 50%, #0F0F12) -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0"   Color="#08080A" />
                        <GradientStop Offset="0.5" Color="#0C0C0E" />
                        <GradientStop Offset="1"   Color="#0F0F12" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Fill="{StaticResource BgRadialWarm}"  IsHitTestVisible="False" />
            <Rectangle Fill="{StaticResource BgRadialCool}"  IsHitTestVisible="False" />
            <Rectangle Fill="{StaticResource BgRadialLeft}"  IsHitTestVisible="False" />

            <!-- Vignette: matching HTML inset box-shadow 0 0 150px 60px rgba(0,0,0,0.4) -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5">
                        <GradientStop Offset="0.35" Color="#00000000" />
                        <GradientStop Offset="1"    Color="#66000000" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Ambient glow orb — top-right, matching HTML top:20%; right:-10% -->
            <Ellipse x:Name="GlowOrb"
                     Width="500" Height="500"
                     Fill="{StaticResource GlowOrbBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-100,-150,0"
                     IsHitTestVisible="False" />

            <!-- Note: HTML uses an SVG noise filter at 2.5% opacity.
                 Avalonia doesn't support SVG filters natively.
                 A pre-rendered noise PNG could be added if desired. -->




            <!-- ══ MAIN CONTENT ══════════════════════════════ -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Styles>
                    <Style Selector="ScrollBar Thumb">
                        <Setter Property="MinHeight" Value="20" />
                    </Style>
                    <Style Selector="ScrollBar">
                        <Style.Resources>
                            <x:Double x:Key="ScrollBarThumbHeight">20</x:Double>
                            <x:Double x:Key="ScrollBarThumbHeightPointerOver">20</x:Double>
                            <x:Double x:Key="ScrollBarThumbHeightPressed">20</x:Double>
                        </Style.Resources>
                    </Style>
                </ScrollViewer.Styles>

                <!-- Full-viewport container — StackPanel wraps WideLayout+Recent+NarrowLayout
                     so total content height drives ScrollViewer overflow -->
                <Panel x:Name="ViewportPanel">
                    <StackPanel>

                <!-- ═══════════════════════════════════════════════════
                     WIDE LAYOUT  (≥ 820px)
                     Brand top-left | Panel+Recent right — matches HTML grid exactly
                     Hidden / replaced by NarrowLayout via code-behind on resize
                     The recent section is now OUTSIDE this grid (below) so the
                     outer ScrollViewer can scroll when content overflows.
                     ═══════════════════════════════════════════════════ -->
                <Grid x:Name="WideLayout"
                      ColumnDefinitions="*,Auto,*"
                      RowDefinitions="Auto,*,Auto"
                      HorizontalAlignment="Stretch"
                      Margin="48,32,48,32">

                    <!-- ── Brand — top-left, align-self: start (row 0) ── -->
                    <StackPanel x:Name="BrandPanel"
                                Grid.Column="0" Grid.Row="0"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Spacing="0">

                            <!-- Lion logo: full SVG, 100×100, bronze fill — no glow (matching HTML) -->
                            <Border Width="100" Height="100"
                                    CornerRadius="{StaticResource radius-xl}"
                                    Margin="0,0,0,16">
                                <Viewbox x:Name="BrandLogo" Width="100" Height="100" Stretch="Uniform">
                                    <Canvas Width="215" Height="215">
                                        <!-- Outer ring -->
                                        <Ellipse Canvas.Left="0" Canvas.Top="0"
                                                 Width="214.4" Height="214.4"
                                                 Stroke="{StaticResource StartAccent}"
                                                 StrokeThickness="0.5"
                                                 Opacity="0.2" />
                                        <!-- Full lion path from HTML -->
                                        <Path Fill="{StaticResource StartAccent}" Data="M108.055 140.122c0 1.27 2.13 6.353 5.42 12.933 6.135 12.27 7.791 17.186 8.17 24.24.551 10.281-2.974 18.923-11.16 27.351-1.542 1.585-2.76 2.922-2.708 2.965.232.205 5.324-3.185 7.669-5.104 5.153-4.223 9.422-10.913 11.166-17.507 1.114-4.202 1.132-11.354.043-15.785-1.702-6.925-5.33-13.376-11.956-21.253-1.885-2.24-4.15-5.052-5.034-6.245-.888-1.194-1.61-1.913-1.61-1.595Zm-4.25-28.18c-.389.663-2.341 3.555-4.34 6.429-5.952 8.562-7.907 13.737-8.333 22.027-.269 5.275.48 10.276 2.35 15.64 2.167 6.23 4.723 10.928 12.52 23.037 5.144 7.987 6.622 11.669 6.595 16.455-.016 3.149.119 3.032 1.86-1.585 1.025-2.718 1.138-3.44 1.15-7.278.016-6.343-1.434-11.01-7.371-23.704-5.582-11.94-7.583-17.807-8.342-24.447-.701-6.133-.061-10.552 2.809-19.35 1.487-4.556 2.387-8.427 1.965-8.427-.09 0-.475.541-.863 1.202Zm-20.709-7.223c-7.66 7.736-12.197 16.2-14.55 27.14-.958 4.441-.95 15.188.015 19.607 1.977 9.062 6.28 17.67 12.078 24.163 2.537 2.843 7.43 6.904 13.59 11.277 2.803 1.99 6.23 4.734 7.623 6.1 1.497 1.471 2.427 2.169 2.283 1.716-1.086-3.424-3.48-6.576-7.947-10.463-5.836-5.077-11.629-12.133-15.053-18.333-1.848-3.348-3.81-8.654-4.762-12.88-3.247-14.423-.924-29.485 7.011-45.453 1.671-3.363 3.011-6.115 2.98-6.115-.033 0-1.502 1.46-3.268 3.241ZM36.02 128.29c-.16.792-.2 4.042-.083 7.225.224 6.169 1.074 10.594 3.036 15.809 4.52 12.005 14.937 22.48 29.821 29.977 2.555 1.288 10.971 4.997 11.335 4.997.086 0-2.304-1.658-5.312-3.684-14.766-9.946-23.732-19.524-30.363-32.444-3.192-6.225-6.574-15.604-7.8-21.65l-.34-1.669-.294 1.439Zm95.74-83.255c0 .082 1.02 1.358 2.262 2.833 2.524 2.996 3.791 4.756 5.46 7.587l1.134 1.921-2.855-2.393c-4.77-4.006-9.517-6.142-15.285-6.882-4.318-.554-8.174-.08-16.553 2.041-11.344 2.867-17.531 3.825-26.017 4.027l-3.52.086 4.077.924c3.61.823 4.911.927 11.481.927 6.29 0 8.021-.128 11.482-.847 2.24-.469 4.407-.949 4.814-1.068.407-.12-.554.648-2.133 1.71-4.21 2.828-7.565 6.904-12.363 15.023-6.62