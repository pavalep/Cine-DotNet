<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="using:Cine.Avalonia.ViewModels"
             xmlns:pages="using:Cine.Avalonia.ViewModels.Pages"
             xmlns:models="using:Cine.Avalonia.Models"
             xmlns:utils="using:Cine.Avalonia.Utilities"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:shapes="clr-namespace:Avalonia.Controls.Shapes;assembly=Avalonia.Controls"
             xmlns:labs="clr-namespace:Avalonia.Labs.Panels;assembly=Avalonia.Labs.Panels"
             x:Class="Cine.Avalonia.Views.Components.StartPage"
             x:Name="root"
             x:DataType="pages:StartPageViewModel">

    <UserControl.Resources>
        <Color x:Key="Bronze">#C9A96E</Color>
        <Color x:Key="BronzeLight">#D4B88C</Color>
        <SolidColorBrush x:Key="StartAccent"       Color="{StaticResource Bronze}" />
        <SolidColorBrush x:Key="StartAccentBorder"  Color="#44C9A96E" />
        <SolidColorBrush x:Key="StartAccentDim"     Color="#1FC9A96E" />
        <!-- ── Glass surfaces ── -->
        <SolidColorBrush x:Key="StartGlassBg"       Color="#09FFFFFF" />
        <SolidColorBrush x:Key="StartGlassBorder"   Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="StartGlassEdge"     Color="#0AFFFFFF" />
        <SolidColorBrush x:Key="CardGlassBg"        Color="#0AFFFFFF" />
        <SolidColorBrush x:Key="CardGlassBorder"    Color="#0FFFFFFF" />

        <RadialGradientBrush x:Key="BgRadialWarm" Center="0.5,0.4" GradientOrigin="0.5,0.4">
            <GradientStop Offset="0"   Color="#12C9A96E" />
            <GradientStop Offset="0.7" Color="#00C9A96E" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="BgRadialCool" Center="0.7,0.8" GradientOrigin="0.7,0.8">
            <GradientStop Offset="0"   Color="#04FFFFFF" />
            <GradientStop Offset="0.6" Color="#00FFFFFF" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="BgRadialLeft" Center="0.2,0.6" GradientOrigin="0.2,0.6">
            <GradientStop Offset="0"   Color="#06C9A96E" />
            <GradientStop Offset="0.5" Color="#00C9A96E" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="GlowOrbBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5">
            <GradientStop Offset="0"   Color="#14C9A96E" />
            <GradientStop Offset="0.6" Color="#07C9A96E" />
            <GradientStop Offset="1"   Color="#00C9A96E" />
        </RadialGradientBrush>

        <!-- ── Card dimensions (fixed width — horizontal scrolling handles overflow) ── -->
        <sys:Double x:Key="CardWidth">180</sys:Double>
        <sys:Double x:Key="ThumbWidth">156</sys:Double>
        <sys:Double x:Key="ThumbHeight">97.5</sys:Double>
        <utils:NegateBoolConverter x:Key="NegateConverter" />
        <Thickness x:Key="StartCardPadding">0</Thickness>
        <sys:Double x:Key="StartPlayIconSize">20</sys:Double>

        <!-- Thumb gradient brush -->
        <LinearGradientBrush x:Key="ThumbGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#1EFFFFFF" />
            <GradientStop Offset="1" Color="#08FFFFFF" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <UserControl.Styles>

        <!-- ── App entrance: full fade-in ── -->
        <Style Selector="Border#StartPageRoot">
            <Setter Property="Opacity" Value="0" />
            <Style.Animations>
                <Animation Duration="0:0:0.5" Delay="0:0:0.1" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">  <Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ── Brand panel: fade + slide in ── -->
        <Style Selector="StackPanel#BrandPanel">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="-10" /></Setter.Value></Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.5" Delay="0:0:0.25" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-10" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ── Logo stagger ── -->
        <Style Selector="Svg#BrandLogo">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="-4" /></Setter.Value></Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.4" Delay="0:0:0.15" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-4" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ── Button panel: materialize from below with scale ── -->
        <Style Selector="StackPanel#ButtonPanel">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <TranslateTransform Y="12" />
                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.6" Delay="0:0:0.2" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="12" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.97" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.97" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ── Premium button base styles ── -->
        <Style Selector="Button.PremiumBtn">
            <Setter Property="Padding" Value="28,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="{StaticResource radius-md}" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="0"/></Setter.Value></Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition     Property="TranslateTransform.Y" Duration="0:0:0.2" Easing="CubicEaseOut" />
                    <BrushTransition      Property="Background"           Duration="0:0:0.2" />
                    <BrushTransition      Property="BorderBrush"          Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.PremiumBtn:pointerover">
            <Setter Property="TranslateTransform.Y" Value="-2" />
        </Style>
        <Style Selector="Button.PremiumBtn:pressed">
            <Setter Property="TranslateTransform.Y" Value="0" />
        </Style>

        <!-- Primary premium button -->
        <Style Selector="Button.BtnPrimary">
            <Setter Property="Background" Value="{StaticResource StartGlassBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource StartAccentBorder}" />
        </Style>
        <Style Selector="Button.BtnPrimary:pointerover">
            <Setter Property="Background"  Value="#18C9A96E" />
            <Setter Property="BorderBrush" Value="{StaticResource StartAccent}" />
        </Style>

        <!-- Secondary premium button -->
        <Style Selector="Button.BtnSecondary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource StartGlassBorder}" />
        </Style>
        <Style Selector="Button.BtnSecondary:pointerover">
            <Setter Property="Background" Value="{StaticResource StartGlassBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource StartAccentBorder}" />
        </Style>

        <!-- ── Recent section: fade up ── -->
        <Style Selector="Grid#RecentSection">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="10" /></Setter.Value></Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.5" Delay="0:0:0.45" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="10" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ── Glow orb: gentle float ── -->
        <Style Selector="Ellipse#GlowOrb">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <TranslateTransform X="0" Y="0" />
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:12" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="0.6" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="TranslateTransform.X" Value="15" />
                        <Setter Property="TranslateTransform.Y" Value="-15" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1.05" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.05" />
                        <Setter Property="Opacity" Value="0.8" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="0.6" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ── Window controls styling ── -->
        <Style Selector="Button.WindowCtrl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.WindowCtrl:pointerover">
            <Setter Property="Background" Value="{StaticResource WindowButtonHoverBackground}" />
        </Style>
        <Style Selector="Button.WindowCtrl.close:pointerover">
            <Setter Property="Background" Value="{StaticResource WindowCloseButtonHoverBackground}" />
        </Style>

        <!-- ── Kbd hint fade in ── -->
        <Style Selector="Border#KbdHint">
            <Setter Property="Opacity" Value="0" />
            <Style.Animations>
                <Animation Duration="0:0:0.5" Delay="0:0:0.9" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">  <Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Button:focus-visible">
            <Setter Property="BorderBrush" Value="{StaticResource StartAccent}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!-- ── Recent card styles ── -->
        <Style Selector="Button.RecentCard">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut" />
                    <BrushTransition              Property="BorderBrush"      Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.RecentCard:pointerover">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="-4" />
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource StartAccentBorder}" />
        </Style>

    </UserControl.Styles>

    <Border x:Name="StartPageRoot" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid x:Name="PageRootGrid">

            <!-- ══ BACKGROUND ══ -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0"   Color="#08080A" />
                        <GradientStop Offset="0.5" Color="#0C0C0E" />
                        <GradientStop Offset="1"   Color="#0F0F12" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Fill="{StaticResource BgRadialWarm}"  IsHitTestVisible="False" />
            <Rectangle Fill="{StaticResource BgRadialCool}"  IsHitTestVisible="False" />
            <Rectangle Fill="{StaticResource BgRadialLeft}"  IsHitTestVisible="False" />

            <!-- Vignette -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5">
                        <GradientStop Offset="0.35" Color="#00000000" />
                        <GradientStop Offset="1"    Color="#66000000" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Top-edge sheen (Apple-style subtle top highlight) -->
            <Rectangle IsHitTestVisible="False" VerticalAlignment="Top" Height="120">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                        <GradientStop Offset="0"   Color="#0AFFFFFF" />
                        <GradientStop Offset="1"   Color="#00000000" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Ambient glow orb -->
            <Ellipse x:Name="GlowOrb"
                     Width="260"
                     Height="260"
                     Fill="{StaticResource GlowOrbBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-80,-100,0"
                     IsHitTestVisible="False" />

            <!-- ══ DRAG OVERLAY ══ -->
            <Border Background="Transparent" PointerPressed="OnDragPointerPressed" />

            <!-- ══ MAIN CONTENT (Grid-based layout) ══
                 Row 0: Brand — natural height (Auto)
                 Row 1: Buttons — natural height (Auto)
                 Row 2: Recent — fills remaining space (*) -->
            <Grid x:Name="MainContentPanel"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  RowDefinitions="Auto,Auto,*"
                  Margin="36,24,36,36">

                <!-- ── Brand Section (Row 0) ── -->
                <StackPanel x:Name="BrandPanel"
                            Grid.Row="0"
                            Orientation="Vertical"
                            Spacing="4"
                            Margin="0,32,0,12">

                    <!-- Lion logo -->
                    <Border x:Name="BrandLogoBorder"
                            CornerRadius="{StaticResource radius-xl}"
                            HorizontalAlignment="Center"
                            Width="64"
                            Height="64">
                        <svg:Svg x:Name="BrandLogo"
                                 Stretch="Uniform"
                                 Path="/Assets/simba-logo.svg"
                                 CurrentColor="{StaticResource Bronze}"
                                 Width="64"
                                 Height="64" />
                    </Border>

                    <!-- Wordmark -->
                    <TextBlock x:Name="WordmarkText"
                               Text="SIMBA"
                               FontFamily="{StaticResource font-family-display}"
                               FontWeight="Bold"
                               FontSize="30"
                               LetterSpacing="6"
                               TextAlignment="Center"
                               Foreground="{StaticResource AppTextPrimary}">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              OffsetX="0" OffsetY="0"
                                              Color="#C9A96E"
                                              Opacity="0.25" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Tagline -->
                    <TextBlock x:Name="TaglineText" Text="Play anything."
                               FontFamily="{StaticResource font-family-display}"
                               FontWeight="Light"
                               FontSize="13"
                               LetterSpacing="0.3"
                               TextAlignment="Center"
                               Foreground="{StaticResource AppTextOnDarkHint}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- ── Action Buttons (Row 1) ── -->
                <StackPanel x:Name="ButtonPanel"
                            Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,8">

                    <!-- Open Media -->
                    <Button x:Name="BtnOpenFile"
                            Classes="PremiumBtn BtnPrimary"
                            Click="BtnOpenFile_Click"
                            AutomationProperties.Name="Open media file"
                            Width="190"
                            Height="42">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon x:Name="BtnOpenFileIcon" Kind="PlayCircleOutline"
                                Width="17"
                                Height="17"
                                Foreground="{StaticResource StartAccent}" />
                            <TextBlock x:Name="BtnOpenFileLabel" Text="Open Media"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextPrimary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Open Folder -->
                    <Button x:Name="BtnOpenFolder"
                            Classes="PremiumBtn BtnSecondary"
                            Click="BtnOpenFolder_Click"
                            AutomationProperties.Name="Open media folder"
                            Width="190"
                            Height="42">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon x:Name="BtnOpenFolderIcon" Kind="FolderOutline"
                                Width="17"
                                Height="17"
                                Foreground="{StaticResource AppTextOnDarkSecondary}" />
                            <TextBlock x:Name="BtnOpenFolderLabel" Text="Open Folder"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextOnDarkSecondary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- ── Recent Section (Row 2 — fills remaining space) ── -->
                <Grid x:Name="RecentSection"
                      Grid.Row="2"
                      RowDefinitions="Auto,Auto,Auto"
                      Margin="0,8,0,0">

                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="2,0">
                        <TextBlock x:Name="RecentHeaderText" Grid.Column="0"
                                   Text="Recent"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Classes="md3-caption"
                                   LetterSpacing="1"
                                   Foreground="{StaticResource AppTextOnDarkHint}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="2"
                                Padding="10,2"
                                CornerRadius="{StaticResource radius-full}"
                                Background="{StaticResource AppHoverSubtle}"
                                BorderThickness="0.5"
                                BorderBrush="{StaticResource StartGlassBorder}"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="RecentCountText"
                                       FontSize="11"
                                       Text="{Binding RecentFileItems.Count}"
                                       Foreground="{StaticResource AppTextOnDarkHint}" />
                        </Border>
                    </Grid>

                    <!-- Empty state -->
                    <TextBlock Grid.Row="1"
                               x:Name="EmptyStateText"
                               Text="No recent media"
                               Classes="md3-body2"
                               Foreground="{StaticResource AppTextOnDarkHint}"
                               HorizontalAlignment="Center"
                               Padding="0,20,0,20"
                               IsVisible="{Binding HasRecentFiles, Converter={StaticResource NegateConverter}}" />

                    <!-- Horizontal card track with right-edge fade hint -->
                    <ScrollViewer Grid.Row="2"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  Padding="0,8,0,4">
                        <ItemsRepeater x:Name="RecentTracks"
                                       ItemsSource="{Binding RecentFileItems}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="10" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:RecentFileItem">
                                    <Button Classes="RecentCard"
                                            Width="{Binding CardWidth, ElementName=root}"
                                            Padding="{StaticResource StartCardPadding}"
                                            CornerRadius="{StaticResource radius-lg}"
                                            Background="{StaticResource CardGlassBg}"
                                            BorderBrush="{StaticResource CardGlassBorder}"
                                            BorderThickness="0.5"
                                            Cursor="Hand"
                                            Command="{Binding #root.DataContext.OpenRecentFileCommand}"
                                            CommandParameter="{Binding FilePath}">
                                        <labs:FlexPanel Direction="Column" ColumnSpacing="6">
                                            <!-- Thumb area -->
                                            <Border Width="{Binding ThumbWidth, ElementName=root}"
                                                    Height="{Binding ThumbHeight, ElementName=root}"
                                                    CornerRadius="{StaticResource radius-md}"
                                                    Background="{StaticResource ThumbGradient}"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Border Background="#0A000000" IsHitTestVisible="False" />
                                                    <Panel HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                        <shapes:Path Data="M8 5v14l11-7z"
                                                                     Width="20" Height="20"
                                                                     Stretch="Uniform"
                                                                     Opacity="0.65"
                                                                     Fill="White"
                                                                     IsVisible="{Binding IsVideo}">
                                                            <shapes:Path.Effect>
                                                                <DropShadowEffect BlurRadius="8" OffsetX="0" OffsetY="2"
                                                                                  Color="Black" Opacity="0.5" />
                                                            </shapes:Path.Effect>
                                                        </shapes:Path>
                                                        <shapes:Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                                                     Width="20" Height="20"
                                                                     Stretch="Uniform"
                                                                     Opacity="0.65"
                                                                     Fill="White"
                                                                     IsVisible="{Binding IsVideo, Converter={StaticResource NegateConverter}}">
                                                            <shapes:Path.Effect>
                                                                <DropShadowEffect BlurRadius="8" OffsetX="0" OffsetY="2"
                                                                                  Color="Black" Opacity="0.5" />
                                                            </shapes:Path.Effect>
                                                        </shapes:Path>
                                                    </Panel>
                                                </Grid>
                                            </Border>
                                            <!-- Title -->
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AppTextPrimary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="{Binding ThumbWidth, ElementName=root}" />
                                            <!-- Meta row -->
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Border CornerRadius="3"
                                                        Background="#14FFFFFF"
                                                        Padding="4,1">
                                                    <Grid>
                                                        <TextBlock Text="Video"
                                                                   FontSize="9"
                                                                   FontWeight="Medium"
                                                                   Foreground="{StaticResource AppTextOnDarkHint}"
                                                                   IsVisible="{Binding IsVideo}" />
                                                        <TextBlock Text="Audio"
                                                                   FontSize="9"
                                                                   FontWeight="Medium"
                                                                   Foreground="{StaticResource AppTextOnDarkHint}"
                                                                   IsVisible="{Binding IsVideo, Converter={StaticResource NegateConverter}}" />
                                                    </Grid>
                                                </Border>
                                                <Border CornerRadius="3"
                                                        Padding="4,1"
                                                        IsVisible="{Binding IsVideo}">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="#19C9A96E" />
                                                    </Border.Background>
                                                    <TextBlock Text="{Binding Extension}"
                                                               FontSize="9"
                                                               FontWeight="Medium"
                                                               Foreground="{StaticResource AppTextOnDarkHint}" />
                                                </Border>
                                                <Border CornerRadius="3"
                                                        Padding="4,1"
                                                        IsVisible="{Binding IsVideo, Converter={StaticResource NegateConverter}}">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="#196EC9A9" />
                                                    </Border.Background>
                                                    <TextBlock Text="{Binding Extension}"
                                                               FontSize="9"
                                                               FontWeight="Medium"
                                                               Foreground="{StaticResource AppTextOnDarkHint}" />
                                                </Border>
                                            </StackPanel>
                                        </labs:FlexPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>

                    <!-- Right-edge fade hint for card overflow -->
                    <Rectangle Grid.Row="2"
                               HorizontalAlignment="Right"
                               Width="48"
                               IsHitTestVisible="False"
                               ZIndex="1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                <GradientStop Offset="0" Color="#00000000" />
                                <GradientStop Offset="1" Color="#FF0C0C0E" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                </Grid>

            </Grid>

            <!-- ══ WINDOW CONTROLS ══ Always top-right, overlay -->
            <StackPanel x:Name="WindowControls"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Spacing="0"
                        Margin="0,10,14,0">
                <Button x:Name="StartMinimizeBtn"
                        Classes="WindowCtrl"
                        Click="OnStartMinimizeClick"
                        AutomationProperties.Name="Minimize window">
                    <materialIcons:MaterialIcon Kind="WindowMinimize"
                                                Width="10" Height="10"
                                                Foreground="{StaticResource AppTextOnDarkSecondary}" />
                </Button>
                <Button x:Name="StartMaximizeRestoreBtn"
                        Classes="WindowCtrl"
                        Click="OnStartMaximizeRestoreClick"
                        AutomationProperties.Name="Maximize or restore window">
                    <materialIcons:MaterialIcon x:Name="StartMaximizeRestoreIcon"
                                                Kind="WindowMaximize"
                                                Width="10" Height="10"
                                                Foreground="{StaticResource AppTextOnDarkSecondary}" />
                </Button>
                <Button x:Name="StartCloseBtn"
                        Classes="WindowCtrl close"
                        Click="OnStartCloseClick"
                        AutomationProperties.Name="Close window">
                    <materialIcons:MaterialIcon Kind="Close"
                                                Width="10" Height="10"
                                                Foreground="{StaticResource AppTextOnDarkSecondary}" />
                </Button>
            </StackPanel>

            <!-- ══ KEYBOARD HINT ══ -->
            <Border x:Name="KbdHint"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20"
                    Padding="12,6,12,6"
                    CornerRadius="{StaticResource radius-full}"
                    Background="{StaticResource AppHoverSubtle}"
                    BorderThickness="0.5"
                    BorderBrush="{StaticResource StartGlassBorder}"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border Padding="4,1"
                            CornerRadius="3"
                            Background="#14FFFFFF">
                        <TextBlock x:Name="KbdModifierText"
                                   Text="Ctrl"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextOnDarkSecondary}" />
                    </Border>
                    <TextBlock x:Name="KbdPlusText" Text="+"
                               FontSize="10"
                               Foreground="{StaticResource AppTextOnDarkSecondary}" />
                    <Border Padding="4,1"
                            CornerRadius="3"
                            Background="#14FFFFFF">
                        <TextBlock x:Name="KbdOLetterText" Text="O"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextOnDarkSecondary}" />
                    </Border>
                    <TextBlock x:Name="KbdToOpenText" Text="to open"
                               FontSize="10"
                               Foreground="{StaticResource AppTextOnDarkHint}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</UserControl>