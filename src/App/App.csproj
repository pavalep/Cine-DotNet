<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- MSIX: packaged externally via MakeAppx in CI pipeline. Keep framework-dependent. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationTitle>Cine</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Media\Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\resources\libmpv-2_x86-64\libmpv-2.dll" Condition="Exists('..\\..\\resources\\libmpv-2_x86-64\\libmpv-2.dll')" Link="libmpv-2.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\resources\libmpv-2_x86-64\libEGL.dll" Condition="Exists('..\\..\\resources\\libmpv-2_x86-64\\libEGL.dll')" Link="libEGL.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\resources\libmpv-2_x86-64\libGLESv2.dll" Condition="Exists('..\\..\\resources\\libmpv-2_x86-64\\libGLESv2.dll')" Link="libGLESv2.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- MSIX manifest (used by MakeAppx; not copied to runtime output) -->
    <None Include="Package.appxmanifest" />
    <None Include="Msix.AppInstaller.Data\MSIXAppInstallerData.xml" />

    <!-- MSIX visual assets (generated by generate-app-icons.ps1; copied to publish output) -->
    <Content Include="Assets\**\*.png" Condition="Exists('Assets')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="UI\Resources\**\*" />
    <EmbeddedResource Include="UI\Constants\Colors.json" />
    <EmbeddedResource Include="Application\Features\feature-definitions.json" />
  </ItemGroup>
</Project>
