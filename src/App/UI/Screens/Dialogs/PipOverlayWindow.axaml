<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Cine.Avalonia.Views.Dialogs.PipOverlayWindow"
        Title="Cine — PiP Overlay"
        Width="480" Height="320"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        Background="Transparent"
        IsHitTestVisible="True"
        PointerMoved="OnOverlayPointerMoved">

    <Window.Styles>
        <Style Selector="Grid.pip-top-bar">
            <Setter Property="Background" Value="#AA000000" />
        </Style>
        <Style Selector="Grid.pip-bottom-bar">
            <Setter Property="Background" Value="#AA000000" />
        </Style>
        <Style Selector="Button.pip-top-btn">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.pip-top-btn:pointerover">
            <Setter Property="Background" Value="#2BFFFFFF" />
        </Style>
        <Style Selector="Button.pip-close-btn:pointerover">
            <Setter Property="Background" Value="#E81123" />
        </Style>
        <Style Selector="Button.pip-center-play">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#33000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.pip-center-play:pointerover">
            <Setter Property="Background" Value="#55000000" />
        </Style>
        <Style Selector="Border.pip-seek-thumb">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Border.pip-seek-thumb:pointerover">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style Selector="Button.pip-mute-btn">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.pip-mute-btn:pointerover">
            <Setter Property="Background" Value="#2BFFFFFF" />
        </Style>
        <Style Selector="Border.pip-file-badge">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#AA000000" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </Window.Styles>

    <!-- FLAT Grid — all children overlap, positioned via VerticalAlignment + ZIndex -->
    <Grid Background="Transparent">

        <!-- Top bar — Z10, pinned to TOP -->
        <Grid Classes="pip-top-bar"
              VerticalAlignment="Top" Height="48"
              ZIndex="10"
              ColumnDefinitions="Auto,*,Auto,Auto,Auto"
              PointerEntered="OnTopBarPointerEntered"
              PointerExited="OnTopBarPointerExited">
            <Border Grid.Column="0"
                    Width="28" Height="28"
                    CornerRadius="6"
                    Background="#2BFFFFFF"
                    VerticalAlignment="Center"
                    Margin="10,0,8,0">
                <materialIcons:MaterialIcon Kind="MovieOpenOutline"
                    Width="16" Height="16"
                    Foreground="White"
                    Opacity="0.87"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="FileNameLabel"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="White"
                           Opacity="0.87"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="Cine PIP" />
                <TextBlock x:Name="FileSubtitleLabel"
                           FontSize="10"
                           Foreground="White"
                           Opacity="0.53"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="" />
            </StackPanel>
            <Button Grid.Column="2" x:Name="PinButton"
                    Classes="pip-top-btn"
                    ToolTip.Tip="Keep on top"
                    Click="OnPinToggle">
                <materialIcons:MaterialIcon x:Name="PinIcon"
                    Kind="PinOutline" Width="16" Height="16"
                    Foreground="White"
                    Opacity="0.4" />
            </Button>
            <Button Grid.Column="3" x:Name="ExpandButton"
                    Classes="pip-top-btn"
                    ToolTip.Tip="Return to Main Window"
                    Click="OnExpandClick">
                <materialIcons:MaterialIcon Kind="PictureInPictureBottomRightOutline"
                    Width="16" Height="16"
                    Foreground="White" />
            </Button>
            <Button Grid.Column="4"
                    Classes="pip-top-btn pip-close-btn"
                    ToolTip.Tip="Close (Esc)"
                    Margin="0,0,6,0"
                    Click="OnCloseClick">
                <materialIcons:MaterialIcon Kind="Close"
                    Width="16" Height="16"
                    Foreground="White" />
            </Button>
        </Grid>

        <!-- Center play/pause — Z10, pinned to CENTER -->
        <Button x:Name="PlayPauseButton"
                Classes="pip-center-play"
                ZIndex="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                PointerEntered="OnCenterPointerEntered"
                PointerExited="OnCenterPointerExited"
                Click="OnPlayPauseClick">
            <materialIcons:MaterialIcon x:Name="PlayPauseIcon"
                Kind="Play" Width="22" Height="22"
                Foreground="White" />
        </Button>

        <!-- Bottom bar — Z10, pinned to BOTTOM -->
        <Grid Classes="pip-bottom-bar"
              VerticalAlignment="Bottom"
              ZIndex="10"
              ColumnDefinitions="*,Auto,Auto"
              PointerEntered="OnBottomBarPointerEntered"
              PointerExited="OnBottomBarPointerExited">
            <Grid Grid.Column="0" x:Name="SeekArea"
                  Height="28"
                  Margin="10,4,4,4"
                  Background="Transparent"
                  PointerMoved="OnSeekPointerMoved"
                  PointerPressed="OnSeekPointerPressed"
                  PointerReleased="OnSeekPointerReleased"
                  PointerExited="OnSeekPointerExited"
                  Cursor="Hand">
                <Border x:Name="SeekTrack"
                        Height="4" CornerRadius="2"
                        Background="#40FFFFFF"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False" />
                <Border x:Name="SeekFill"
                        Height="4" CornerRadius="2"
                        HorizontalAlignment="Left"
                        Background="White"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False" />
                <Border x:Name="SeekThumb"
                        Classes="pip-seek-thumb"
                        IsVisible="False" />
                <Border x:Name="SeekPreviewDot"
                        Width="10" Height="10"
                        CornerRadius="5"
                        Background="#88FFFFFF"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsVisible="False"
                        IsHitTestVisible="False" />
            </Grid>
            <TextBlock Grid.Column="1" x:Name="TimeLabel"
                       FontSize="11"
                       Foreground="#AAFFFFFF"
                       VerticalAlignment="Center"
                       FontFamily="Consolas, monospace"
                       Margin="6,0,0,0"
                       Text="00:00 / 00:00" />
            <Button Grid.Column="2" x:Name="MuteButton"
                    Classes="pip-mute-btn"
                    ToolTip.Tip="Toggle mute"
                    Margin="0,0,6,0"
                    Click="OnMuteToggle">
                <materialIcons:MaterialIcon x:Name="MuteIcon"
                    Kind="VolumeHigh"
                    Width="18" Height="18"
                    Foreground="White" />
            </Button>
        </Grid>

        <!-- File badge — Z20, top-left, visible when controls hidden -->
        <Border Classes="pip-file-badge"
                x:Name="FileBadge"
                ZIndex="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Margin="10,10,0,0">
            <TextBlock x:Name="BadgeLabel"
                       Text=""
                       FontSize="11"
                       Foreground="White"
                       Opacity="0.87"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="140" />
        </Border>
    </Grid>
</Window>
