<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Cine.Avalonia.Views.Dialogs.PipWindow"
        KeyDown="OnKeyDown"
        Title="Cine — PIP"
        Width="480" Height="320"
        MinWidth="240" MinHeight="160"
        MaxWidth="1920" MaxHeight="1080"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        TransparencyLevelHint="None"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="False"
        Background="#1E1E2E">

    <Grid RowDefinitions="Auto,*" Background="#1E1E2E">
        <!-- Title bar -->
        <Border Grid.Row="0"
                x:Name="TitleBar"
                Background="#2A2A3E"
                Height="34"
                Padding="8,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <!-- File name -->
                <TextBlock Grid.Column="0"
                           x:Name="PipFileNameLabel"
                           Text="Cine PIP"
                           FontSize="12"
                           Foreground="#E5E5E5"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="220" />

                <!-- Pin button -->
                <Button Grid.Column="2"
                        x:Name="PinButton"
                        Classes="circular-menu"
                        ToolTip.Tip="Keep on top"
                        Width="26" Height="26"
                        Click="OnPinToggle">
                    <Path x:Name="PinIcon"
                          Data="{StaticResource PinIcon}"
                          Width="12" Height="12" Stretch="Uniform"
                          Fill="#E5E5E5" />
                </Button>

                <!-- Close button -->
                <Button Grid.Column="4"
                        x:Name="CloseButton"
                        Classes="circular-menu"
                        ToolTip.Tip="Close PIP"
                        Width="26" Height="26"
                        Click="OnCloseClick">
                    <Path Data="{StaticResource CloseIcon}"
                          Width="12" Height="12" Stretch="Uniform"
                          Fill="#E5E5E5" />
                </Button>
            </Grid>
        </Border>

        <!-- Video frame area — simple Image control, no D3D11VideoHost -->
        <Border Grid.Row="1"
                Background="#111118"
                ClipToBounds="True">
            <Image x:Name="PipFrameImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        </Border>

        <!-- Bottom overlay controls (volume, label) -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    Spacing="4"
                    Opacity="0.8">
            <Grid ColumnDefinitions="Auto,*" Width="160">
                <materialIcons:MaterialIcon Kind="VolumeHigh"
                                           Foreground="#E5E5E5"
                                           Width="16" Height="16"
                                           VerticalAlignment="Center" />
                <Slider Grid.Column="1"
                        x:Name="PipVolumeSlider"
                        Minimum="0" Maximum="200"
                        Height="16"
                        Margin="4,0,0,0"
                        IsVisible="False" />
            </Grid>
            <TextBlock x:Name="PipSyncLabel"
                       Text="live"
                       FontSize="10"
                       Foreground="#88FFFFFF"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
