<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Cine.Avalonia.Views.Dialogs.PipWindow"
        Title="Cine — PIP"
        Width="480" Height="320"
        MinWidth="280" MinHeight="180"
        MaxWidth="1920" MaxHeight="1080"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        WindowDecorations="None"
        Background="#FF0D0D0D"
        PointerMoved="OnPipWindowPointerMoved">

    <Window.Styles>
        <Style Selector="Border.pip-container">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BoxShadow" Value="0 6 32 0 #AA000000, 0 0 0 1 #25FFFFFF" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.pip-resize-edge">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
    </Window.Styles>

    <!-- Flat Grid — video container + resize handles -->
    <Grid>
        <!-- Video container (DWM thumbnail target) -->
        <Border Classes="pip-container" ZIndex="0">
            <Grid>
                <Border x:Name="VideoArea"
                        Background="Transparent"
                        ClipToBounds="True"
                        CornerRadius="12" />
                <Border x:Name="LoadingOverlay"
                        Background="#99000000"
                        IsVisible="False"
                        IsHitTestVisible="False"
                        CornerRadius="12">
                    <TextBlock Text="Starting Picture-in-Picture&#x2026;"
                               Foreground="White"
                               FontSize="13"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Resize handles -->
        <Border Classes="pip-resize-edge" ZIndex="30"
                HorizontalAlignment="Stretch" VerticalAlignment="Top"
                Height="8" Cursor="SizeNorthSouth"
                PointerPressed="OnTopEdgePointerPressed" />
        <Border Classes="pip-resize-edge" ZIndex="30"
                HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                Height="8" Cursor="SizeNorthSouth"
                PointerPressed="OnBottomEdgePointerPressed" />
        <Border Classes="pip-resize-edge" ZIndex="30"
                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                Width="8" Cursor="SizeWestEast"
                PointerPressed="OnLeftEdgePointerPressed" />
        <Border Classes="pip-resize-edge" ZIndex="30"
                HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Width="8" Cursor="SizeWestEast"
                PointerPressed="OnRightEdgePointerPressed" />
        <Border Classes="pip-resize-edge" ZIndex="30"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Width="14" Height="14" Cursor="TopLeftCorner"
                PointerPressed="OnTopLeftCornerPointerPressed" />
        <Border Classes="pip-resize-edge" ZIndex="30"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="14" Height="14" Cursor="TopRightCorner"
                PointerPressed="OnTopRightCornerPointerPressed" />
        <Border Classes="pip-resize-edge" ZIndex="30"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Width="14" Height="14" Cursor="BottomLeftCorner"
                PointerPressed="OnBottomLeftCornerPointerPressed" />
        <Border Classes="pip-resize-edge" ZIndex="30"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Width="14" Height="14" Cursor="BottomRightCorner"
                PointerPressed="OnBottomRightCornerPointerPressed" />
    </Grid>
</Window>
