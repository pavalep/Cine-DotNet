<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Cine.Avalonia.Views.Dialogs.PipWindow"
        Title="Cine — PIP"
        Width="480" Height="320"
        MinWidth="240" MinHeight="160"
        MaxWidth="1920" MaxHeight="1080"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="False"
        Background="Transparent">

    <Window.Styles>
        <!-- PIP-specific styles -->
        <Style Selector="Border.pip-container">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BoxShadow" Value="0 4 24 0 #80000000, 0 0 0 1 #3A3A5E" />
            <Setter Property="Background" Value="#1E1E2E" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="Border.pip-titlebar">
            <Setter Property="Background" Value="#252540CC" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0,4,0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.pip-title-button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.pip-title-button:pointerover">
            <Setter Property="Background" Value="#2BFFFFFF" />
        </Style>
        <Style Selector="Button.pip-title-button:pressed">
            <Setter Property="Background" Value="#40FFFFFF" />
        </Style>
        <Style Selector="Button.pip-close-button:pointerover">
            <Setter Property="Background" Value="#E81123" />
        </Style>

        <Style Selector="TextBlock.pip-title-text">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#E5E5E5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Hover overlay -->
        <Style Selector="Border.pip-hover-overlay">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.pip-hover-overlay:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.pip-center-play">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#33000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.pip-center-play:pointerover">
            <Setter Property="Background" Value="#55000000" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.08" ScaleY="1.08" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.pip-center-play:pressed">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Live badge -->
        <Style Selector="Border.pip-live-badge">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#00FF8822" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style Selector="TextBlock.pip-live-text">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#FF00FF88" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Seek bar -->
        <Style Selector="Border.pip-seek-container">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style Selector="TextBlock.pip-time-text">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#AAFFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource NumericFont}" />
        </Style>

        <!-- Resize grip -->
        <Style Selector="Border.pip-resize-grip">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Window.Styles>

    <Border Classes="pip-container" x:Name="RootContainer">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- ═══ ROW 0: TITLE BAR ═══ -->
            <Border Grid.Row="0" Classes="pip-titlebar" x:Name="TitleBar">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <!-- Film icon + filename -->
                    <TextBlock Grid.Column="0"
                               x:Name="PipFileNameLabel"
                               Classes="pip-title-text"
                               Text="Cine PIP"
                               Margin="4,0,8,0" />

                    <!-- Spacer -->
                    <Border Grid.Column="1" />

                    <!-- Minimize -->
                    <Button Grid.Column="2"
                            x:Name="MinimizeButton"
                            Classes="pip-title-button"
                            ToolTip.Tip="Minimize"
                            Click="OnMinimizeClick">
                        <Path Data="{StaticResource MinimizeIcon}"
                              Width="10" Height="10" Stretch="Uniform"
                              Fill="{StaticResource AppTextPrimary}" />
                    </Button>

                    <!-- Pin toggle -->
                    <Button Grid.Column="3"
                            x:Name="PinButton"
                            Classes="pip-title-button"
                            ToolTip.Tip="Keep on top"
                            Click="OnPinToggle">
                        <Path x:Name="PinIcon"
                              Data="{StaticResource PinIcon}"
                              Width="12" Height="12" Stretch="Uniform"
                              Fill="{StaticResource AppTextPrimary}" />
                    </Button>

                    <!-- Close -->
                    <Button Grid.Column="4"
                            x:Name="CloseButton"
                            Classes="pip-title-button pip-close-button"
                            ToolTip.Tip="Close PIP (Esc)"
                            Click="OnCloseClick">
                        <Path Data="{StaticResource CloseIcon}"
                              Width="10" Height="10" Stretch="Uniform"
                              Fill="{StaticResource AppTextPrimary}" />
                    </Button>
                </Grid>
            </Border>

            <!-- ═══ ROW 1: VIDEO + OVERLAYS ═══ -->
            <Grid Grid.Row="1">
                <!-- Layer 0: DWM video surface (transparent) -->
                <Border Background="Transparent" ClipToBounds="True"
                        x:Name="VideoArea" />

                <!-- Layer 1: Hover controls -->
                <Border Classes="pip-hover-overlay"
                        x:Name="HoverOverlay"
                        PointerEntered="OnHoverOverlayPointerEntered"
                        PointerExited="OnHoverOverlayPointerExited">
                    <Grid RowDefinitions="*,Auto">

                        <!-- Play/Pause center button -->
                        <Button Grid.Row="0"
                                x:Name="PlayPauseButton"
                                Classes="pip-center-play"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="OnPlayPauseClick">
                            <Path x:Name="PlayPauseIcon"
                                  Data="{StaticResource PlayIcon}"
                                  Width="22" Height="22" Stretch="Uniform"
                                  Fill="{StaticResource AppTextPrimary}" />
                        </Button>

                        <!-- Seek bar + time -->
                        <Border Grid.Row="1" Classes="pip-seek-container">
                            <Grid ColumnDefinitions="*,Auto">
                                <Slider Grid.Column="0"
                                        x:Name="PipSeekSlider"
                                        Minimum="0" Maximum="1000"
                                        Value="0"
                                        IsEnabled="True"
                                        Classes="seek-slider" />
                                <TextBlock Grid.Column="1"
                                           x:Name="PipTimeLabel"
                                           Classes="pip-time-text"
                                           Text="00:00 / 00:00"
                                           Margin="8,0,0,0" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Layer 2: File info badge (top-left, always visible) -->
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="8,8,0,0"
                        CornerRadius="6"
                        Background="#66000000"
                        Padding="8,3">
                    <Grid ColumnDefinitions="Auto,Auto">
                        <Border Classes="pip-live-badge" Grid.Column="0">
                            <TextBlock Classes="pip-live-text" Text="live" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   x:Name="PipBadgeLabel"
                                   Text="Cine PIP"
                                   FontSize="11"
                                   Foreground="{StaticResource AppTextOnDarkPrimary}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="140" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ ROW 2: RESIZE GRIP ═══ -->
            <Border Grid.Row="2" Classes="pip-resize-grip">
                <Path Data="M 0 16 L 16 0 L 16 16 Z"
                      Fill="{StaticResource AppIconLight}"
                      Width="16" Height="16" Stretch="Uniform" />
            </Border>
        </Grid>
    </Border>
</Window>