<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DesignWidth="340" d:DesignHeight="180"
        x:Class="Cine.Avalonia.Views.Dialogs.GoToTimeDialog"
        Title="Go to Time"
        Width="340" Height="180"
        MinWidth="280" MinHeight="160"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <Grid RowDefinitions="Auto,*,Auto" Margin="0">
        <!-- Header -->
        <Grid Grid.Row="0" Classes="dialog-header" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Go to Time" Classes="dialog-title" />
            <Button Grid.Column="1" Classes="dialog-close"
                    Click="OnCloseClick" ToolTip.Tip="Close" AutomationProperties.Name="Close dialog">
                <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource size-dialog-close-icon}" Height="{StaticResource size-dialog-close-icon}"
                    Foreground="{StaticResource OsdForeground}" />
            </Button>
        </Grid>

        <!-- Body -->
        <StackPanel Grid.Row="1" Spacing="{StaticResource space-spacing-3}" Margin="16,12,16,0"
                    VerticalAlignment="Top">
            <TextBlock Text="Enter time (HH:MM:SS or MM:SS)" Classes="md3-caption"
                       Foreground="{StaticResource TextTertiary}" />
            <TextBox x:Name="TimeTextBox"
                     Text=""
                     PlaceholderText="e.g. 1:23:45 or 3:30"
                     Classes="md3-headline4"
                     FontWeight="Bold"
                     Foreground="{StaticResource OsdForeground}"
                     Background="{StaticResource PopoverBackground}"
                     BorderBrush="{StaticResource PopoverBorder}"
                     BorderThickness="1"
                     CornerRadius="{StaticResource radius-md}"
                     Padding="12,8"
                     HorizontalContentAlignment="Center"
                     KeyDown="OnTimeTextBoxKeyDown"
                     AutomationProperties.Name="Enter time to seek" />
        </StackPanel>

        <!-- Footer -->
        <Button Grid.Row="2"
                x:Name="GoButton"
                Content="Go"
                Classes="primary"
                HorizontalAlignment="Stretch"
                Margin="16,0,16,12"
                Click="OnGoClick" />
    </Grid>
</Window>
