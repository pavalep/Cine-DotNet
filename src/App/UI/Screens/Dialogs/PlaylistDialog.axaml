<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Cine.Avalonia.ViewModels"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
        x:Class="Cine.Avalonia.Views.Dialogs.PlaylistDialog"
        x:DataType="vm:MainViewModel"
        Title="Cine — Playlist"
        Width="520" Height="420"
        MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0">
        <!-- Header -->
        <Grid Grid.Row="0" Classes="dialog-header" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">
            <Button Grid.Column="0"
                    Classes="flat"
                    Margin="4,0"
                    Click="OnAddFilesClick"
                    ToolTip.Tip="Add Files" AutomationProperties.Name="Add files to playlist">
                <materialIcons:MaterialIcon Kind="PlaylistPlus" Width="14" Height="14"
                    Foreground="{StaticResource OsdForeground}" />
            </Button>
            <TextBlock Grid.Column="1" Text="Playlist" Classes="dialog-title" />
            <Button Grid.Column="3"
                    Classes="flat"
                    Margin="0,0,2,0"
                    x:Name="SortBtn"
                    Click="OnSortClick"
                    ToolTip.Tip="Sort by Title">
                <materialIcons:MaterialIcon Kind="SortAlphabeticalAscending" Width="14" Height="14"
                    Foreground="{StaticResource OsdForeground}" />
            </Button>
            <Button Grid.Column="4"
                    Classes="flat"
                    Margin="0,0,2,0"
                    x:Name="QueueBtn"
                    Click="OnQueueModeClick"
                    ToolTip.Tip="Queue Mode: Add files after current">
                <materialIcons:MaterialIcon Kind="PlaylistPlay" Width="14" Height="14"
                    Foreground="{StaticResource OsdForeground}" />
            </Button>
            <Button Grid.Column="5"
                    Classes="flat"
                    Margin="0,0,2,0"
                    Click="OnClearPlaylistClick"
                    ToolTip.Tip="Clear All">
                <materialIcons:MaterialIcon Kind="PlaylistRemove" Width="14" Height="14"
                    Foreground="{StaticResource OsdForeground}" />
            </Button>
            <Button Grid.Column="6"
                    Classes="flat"
                    Margin="0,0,2,0"
                    Click="OnSavePlaylistClick"
                    ToolTip.Tip="Save Playlist (.m3u8)" AutomationProperties.Name="Save playlist">
                <materialIcons:MaterialIcon Kind="ContentSave" Width="14" Height="14"
                    Foreground="{StaticResource OsdForeground}" />
            </Button>
            <Button Grid.Column="7" 
                    Classes="flat" 
                    Margin="0,0,8,0"
                    Click="OnCloseClick"
                    ToolTip.Tip="Close">
                <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14"
                    Foreground="{StaticResource OsdForeground}" />
            </Button>
        </Grid>

        <!-- Search Bar (P3.3) -->
        <Border Grid.Row="1" Height="36" Margin="8,4,8,0"
                Background="{StaticResource PopoverBackground}"
                CornerRadius="6"
                BorderBrush="{StaticResource PopoverBorder}"
                BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0">
                <materialIcons:MaterialIcon Grid.Column="0" Kind="Magnify" Width="14" Height="14"
                    Foreground="{StaticResource OsdForeground}"
                    VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         x:Name="SearchTextBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource OsdForeground}"
                         PlaceholderText="Search playlist..."
                         FontSize="13"
                         Margin="8,0,0,0"
                         VerticalAlignment="Center"
                         TextChanged="OnSearchTextChanged" />
                <Button Grid.Column="2"
                        x:Name="SearchClearButton"
                        Classes="flat"
                        Width="20" Height="20"
                        IsVisible="False"
                        Click="OnSearchClearClick"
                        ToolTip.Tip="Clear">
                    <materialIcons:MaterialIcon Kind="CloseCircle" Width="12" Height="12"
                        Foreground="{StaticResource OsdForeground}" />
                </Button>
            </Grid>
        </Border>

        <!-- List -->
        <ListBox Grid.Row="2" x:Name="PlaylistListBox"
                 ItemsSource="{Binding PlaylistItems}"
                 Background="Transparent"
                 BorderThickness="0"
                 PointerPressed="OnPlaylistListBoxPointerPressed"
                 PointerMoved="OnPlaylistListBoxPointerMoved"
                 PointerReleased="OnPlaylistListBoxPointerReleased">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="8,4"
                          IsVisible="{Binding IsVisible}">
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Play" Command="{Binding Play}" />
                                <MenuItem Header="Play Next (Queue)">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="PlaylistPlay" Width="14" Height="14"
                                            Foreground="{StaticResource OsdForeground}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Remove from Playlist" Command="{Binding Remove}" />
                                <MenuItem Header="Reveal in File Explorer"
                                          Click="OnItemRevealClick" />
                                <Separator />
                                <MenuItem Header="File Properties..."
                                          Click="OnItemPropertiesClick" />
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <TextBlock Grid.Column="0" Text="▶" FontSize="10"
                                   Foreground="{StaticResource OsdForeground}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                   FontSize="13" Foreground="{StaticResource OsdForeground}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" 
                                Classes="circular-transport" 
                                Click="OnItemPlayClick"
                                Width="32" Height="32"
                                Margin="8,0,0,0">
                            <materialIcons:MaterialIcon Kind="Play" Width="12" Height="12"
                                Foreground="{StaticResource OsdForeground}" />
                        </Button>
                        <Button Grid.Column="3" 
                                Classes="circular-transport" 
                                Click="OnItemRemoveClick"
                                Width="32" Height="32"
                                ToolTip.Tip="Remove">
                            <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12"
                                Foreground="{StaticResource OsdForeground}" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty State (no items at all) -->
        <Border Grid.Row="2" x:Name="EmptyStateOverlay"
                Background="Transparent" IsVisible="False" ZIndex="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <materialIcons:MaterialIcon Kind="PlaylistPlus" Width="64" Height="64"
                    Foreground="{StaticResource OsdForeground}" />
                <TextBlock Text="Add to Playlist" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- No Results (P3.6) -->
        <Border Grid.Row="2" x:Name="NoResultsOverlay"
                Background="Transparent" IsVisible="False" ZIndex="2">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <materialIcons:MaterialIcon Kind="MagnifyClose" Width="48" Height="48"
                    Foreground="{StaticResource OsdForeground}" Opacity="0.7" />
                <TextBlock Text="No matching items" FontSize="18" FontWeight="Medium"
                           Foreground="{StaticResource OsdForeground}" Opacity="0.7" HorizontalAlignment="Center" />
                <TextBlock Text="Try a different search term" Classes="md3-caption"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource OsdForeground}" Opacity="0.5" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
