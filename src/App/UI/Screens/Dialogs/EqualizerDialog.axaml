<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Cine.Avalonia.Views.Dialogs.EqualizerDialog"
        Title="Audio Equalizer"
        Width="520" Height="420"
        MinWidth="400" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <Grid RowDefinitions="Auto,*,Auto" Margin="0">
        <!-- Header -->
        <Grid Grid.Row="0" Height="40" ColumnDefinitions="*,Auto"
              Background="{StaticResource PopoverBackground}">
            <TextBlock Grid.Column="0" Text="Audio Equalizer" FontWeight="Bold" FontSize="16"
                       Margin="16,0" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="flat" Margin="0,0,8,0"
                    Click="OnCloseClick" ToolTip.Tip="Close">
                <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14"
                    Foreground="{StaticResource OsdForeground}" />
            </Button>
        </Grid>

        <!-- Preset buttons -->
        <WrapPanel Grid.Row="1" Margin="16,12,16,0">
            <Button Content="Flat" Classes="eq-preset" Click="OnPresetClick"
                    Tag="Flat" Margin="2" />
            <Button Content="Classical" Classes="eq-preset" Click="OnPresetClick"
                    Tag="Classical" Margin="2" />
            <Button Content="Rock" Classes="eq-preset" Click="OnPresetClick"
                    Tag="Rock" Margin="2" />
            <Button Content="Pop" Classes="eq-preset" Click="OnPresetClick"
                    Tag="Pop" Margin="2" />
            <Button Content="Jazz" Classes="eq-preset" Click="OnPresetClick"
                    Tag="Jazz" Margin="2" />
            <Button Content="Bass Boost" Classes="eq-preset" Click="OnPresetClick"
                    Tag="Bass Boost" Margin="2" />
        </WrapPanel>

        <!-- Sliders -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled"
                      Margin="16,50,16,8" Background="Transparent">
            <StackPanel x:Name="SlidersStack" Orientation="Horizontal" Spacing="4" />
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Height="1" Background="{StaticResource PopoverBorder}" />
        <TextBlock Grid.Row="2" x:Name="PresetLabel" Text="Flat"
                   Foreground="{StaticResource OsdForeground}" FontSize="11" Opacity="0.5"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4" />
    </Grid>
</Window>
