<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:vm="using:Cine.Avalonia.ViewModels"
        x:Class="Cine.Avalonia.Views.Dialogs.PreferencesDialog"
        x:DataType="vm:MainViewModel"
        Title="Preferences"
        Width="520" MinWidth="400" MaxWidth="640"
        MinHeight="320" MaxHeight="700"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <Grid RowDefinitions="Auto,*,Auto" Margin="0">
        <!-- Header -->
        <Grid Grid.Row="0" Classes="dialog-header" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Preferences" Classes="dialog-title" />
            <Button Grid.Column="1" Classes="dialog-close" Click="OnCloseClick" ToolTip.Tip="Close" AutomationProperties.Name="Close dialog">
                <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource size-dialog-close-icon}" Height="{StaticResource size-dialog-close-icon}"
                    Foreground="White" />
            </Button>
        </Grid>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" Margin="12,4,12,0"
                      MaxHeight="600"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="0,12">

                <!-- General -->
                <TextBlock Text="General" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource OsdForeground}" Opacity="0.7" />

                <Border Background="{StaticResource PopoverBackground}"
                        CornerRadius="6" Padding="14,12">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Audio Normalization" FontSize="13" FontWeight="Medium"
                                           Foreground="{StaticResource OsdForeground}" />
                                <TextBlock Text="Dynamic range compression for consistent volume"
                                           FontSize="12" Classes="md3-caption" Opacity="0.5"
                                           Foreground="{StaticResource OsdForeground}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          VerticalAlignment="Center" OnContent="" OffContent=""
                                          IsChecked="{Binding IsAudioNormalizationEnabled, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Dialogue Boost" FontSize="13" FontWeight="Medium"
                                           Foreground="{StaticResource OsdForeground}" />
                                <TextBlock Text="Enhance speech clarity using spectral compression"
                                           FontSize="12" Classes="md3-caption" Opacity="0.5"
                                           Foreground="{StaticResource OsdForeground}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          VerticalAlignment="Center" OnContent="" OffContent=""
                                          IsChecked="{Binding IsDialogueBoostEnabled, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Rendering -->
                <TextBlock Text="Rendering" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource OsdForeground}" Opacity="0.7" />

                <Border Background="{StaticResource PopoverBackground}"
                        CornerRadius="6" Padding="14,12">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Hardware Acceleration" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource OsdForeground}" />
                                <TextBlock Text="Use GPU for video decoding and rendering. Disable if experiencing playback issues."
                                           FontSize="12" Classes="md3-caption" Opacity="0.5"
                                           Foreground="{StaticResource OsdForeground}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          VerticalAlignment="Center" OnContent="" OffContent=""
                                          IsChecked="{Binding IsHardwareAccelerationEnabled, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Subtitles -->
                <TextBlock Text="Subtitles" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource OsdForeground}" Opacity="0.7" />

                <Border Background="{StaticResource PopoverBackground}"
                        CornerRadius="6" Padding="14,12">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Auto-load External Subtitles" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource OsdForeground}" />
                                <TextBlock Text="Automatically scan for .srt / .ass files in media directory"
                                           FontSize="12" Classes="md3-caption" Opacity="0.5"
                                           Foreground="{StaticResource OsdForeground}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoLoadSubsToggle"
                                          VerticalAlignment="Center" OnContent="" OffContent="" />
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Preferred Languages" FontSize="12" Classes="md3-caption" FontWeight="SemiBold"
                                       Foreground="{StaticResource OsdForeground}" Opacity="0.5" />
                            <TextBox x:Name="PreferredLangInput"
                                     Text="eng, jpn, und"
                                     FontSize="12"
                                     Padding="12,6"
                                     Background="{StaticResource AppBackground}"
                                     BorderBrush="{StaticResource PopoverBorder}"
                                     BorderThickness="1" CornerRadius="4"
                                     Foreground="{StaticResource OsdForeground}" />
                            <TextBlock Text="Comma-separated language codes. First match is auto-selected."
                                       FontSize="12" Opacity="0.5"
                                       Foreground="{StaticResource OsdForeground}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="External Subtitle Directories" FontSize="12" Classes="md3-caption" FontWeight="SemiBold"
                                       Foreground="{StaticResource OsdForeground}" Opacity="0.5" />
                            <TextBox x:Name="SubDirsInput"
                                     Text="./subs, ./subtitles"
                                     FontSize="12"
                                     Padding="12,6"
                                     Background="{StaticResource AppBackground}"
                                     BorderBrush="{StaticResource PopoverBorder}"
                                     BorderThickness="1" CornerRadius="4"
                                     Foreground="{StaticResource OsdForeground}" />
                            <TextBlock Text="Relative to media file directory. Comma-separated."
                                       FontSize="12" Opacity="0.5"
                                       Foreground="{StaticResource OsdForeground}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Keyboard Shortcuts -->
                <TextBlock Text="Keyboard Shortcuts" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource OsdForeground}" Opacity="0.7" />

                <Border Background="{StaticResource PopoverBackground}"
                        CornerRadius="6" Padding="14,12">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="Space" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource OsdForeground}" />
                            <TextBlock Grid.Column="1" Text="Play / Pause" FontSize="12"
                                       Foreground="{StaticResource OsdForeground}" Opacity="0.7" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="F / F11" FontWeight="SemiBold" Classes="md3-caption"
                                       Foreground="{StaticResource OsdForeground}" />
                            <TextBlock Grid.Column="1" Text="Toggle Fullscreen" Classes="md3-caption"
                                       Opacity="0.7" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="← / →" FontWeight="SemiBold" Classes="md3-caption" />
                                       Foreground="{StaticResource OsdForeground}" />
                            <TextBlock Grid.Column="1" Text="Seek ±5s" FontSize="12"
                                       Foreground="{StaticResource OsdForeground}" Opacity="0.7" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="Ctrl+← / Ctrl+→" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource OsdForeground}" />
                            <TextBlock Grid.Column="1" Text="Prev/Next Chapter" Classes="md3-caption"
                                       Opacity="0.7" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="Shift+← / Shift+→" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource OsdForeground}" />
                            <TextBlock Grid.Column="1" Text="Seek ±30s" Classes="md3-caption"
                                       Opacity="0.7" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="↑ / ↓" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource OsdForeground}" />
                            <TextBlock Grid.Column="1" Text="Volume ±5%" FontSize="12"
                                       Foreground="{StaticResource OsdForeground}" Opacity="0.7" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="M" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource OsdForeground}" />
                            <TextBlock Grid.Column="1" Text="Mute Toggle" FontSize="12"
                                       Foreground="{StaticResource OsdForeground}" Opacity="0.7" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="C" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource OsdForeground}" />
                            <TextBlock Grid.Column="1" Text="Cycle Subtitles" FontSize="12"
                                       Foreground="{StaticResource OsdForeground}" Opacity="0.7" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="S / Ctrl+S" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource OsdForeground}" />
                            <TextBlock Grid.Column="1" Text="Screenshot" FontSize="12"
                                       Foreground="{StaticResource OsdForeground}" Opacity="0.7" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="Esc" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource OsdForeground}" />
                            <TextBlock Grid.Column="1" Text="Exit Fullscreen" FontSize="12"
                                       Foreground="{StaticResource OsdForeground}" Opacity="0.7" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="Ctrl+P" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource OsdForeground}" />
                            <TextBlock Grid.Column="1" Text="Playlist" FontSize="12"
                                       Foreground="{StaticResource OsdForeground}" Opacity="0.7" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="Ctrl+O" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource OsdForeground}" />
                            <TextBlock Grid.Column="1" Text="Open File" FontSize="12"
                                       Foreground="{StaticResource OsdForeground}" Opacity="0.7" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="Ctrl+Shift+E" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource OsdForeground}" />
                            <TextBlock Grid.Column="1" Text="Equalizer" FontSize="12"
                                       Foreground="{StaticResource OsdForeground}" Opacity="0.7" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Button Content="View All Shortcuts (Ctrl+/)" Margin="0,4,0,0"
                        Background="{StaticResource OsdForeground}"
                        Foreground="{StaticResource Black}" CornerRadius="20"
                        Padding="16,8" FontSize="13" FontWeight="SemiBold"
                        BorderThickness="0"
                        HorizontalAlignment="Center"
                        Click="OnViewAllShortcutsClick" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Height="1" Background="{StaticResource PopoverBorder}"
                Margin="0,4,0,0" />
        <Button Grid.Row="2" Content="Close" HorizontalAlignment="Center"
                Margin="0,8,0,12" Padding="48,8"
                Click="OnCloseClick"
                Background="{StaticResource OsdForeground}"
                Foreground="{StaticResource Black}" CornerRadius="20"
                FontWeight="SemiBold"
                BorderThickness="0" />
    </Grid>
</Window>
