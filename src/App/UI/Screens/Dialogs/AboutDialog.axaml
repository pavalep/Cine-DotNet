<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Cine.Avalonia.Views.Dialogs.AboutDialog"
        Title="About Cine"
        Width="380" Height="240"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <Grid RowDefinitions="*,Auto" Margin="{StaticResource space-5}">
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{StaticResource space-spacing-2}">
            <Panel Width="64" Height="64" HorizontalAlignment="Center">
                <Path Data="M 32 2 A 30 30 0 1 1 32 62 A 30 30 0 1 1 32 2 Z"
                      Fill="{StaticResource AppHoverSubtle}"
                      Stroke="{StaticResource AppDivider}"
                      StrokeThickness="2" />
                <Path Data="M 25 20 L 45 32 L 25 44 Z"
                      Fill="{StaticResource OsdForeground}" />
            </Panel>
            <TextBlock Text="Cine Media Player" Classes="md3-headline6" FontWeight="Bold" Foreground="{StaticResource OsdForeground}" HorizontalAlignment="Center" />
            <TextBlock Text="Version 1.0.0" Classes="md3-body2" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
            <TextBlock Text="Built with Avalonia UI &amp; libmpv" Classes="md3-caption" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" />
        </StackPanel>

        <Button Grid.Row="1" Content="Close" HorizontalAlignment="Center"
                Classes="primary"
                Click="OnCloseClick" />
    </Grid>
</Window>
