<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cine.Avalonia.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cine.Avalonia.Controls.FullscreenHeaderControl"
             x:DataType="vm:MainViewModel">
    <Border x:Name="FullscreenHeader"
            VerticalAlignment="Top" Height="{StaticResource size-fullscreen-header}"
            IsVisible="False"
            Background="{StaticResource HeaderGradient}"
            ZIndex="25">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="{StaticResource space-h-3}">
            <TextBlock Grid.Column="0"
                       Text="{Binding Title}"
                       Foreground="{StaticResource OsdForeground}"
                       FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource space-spacing-1}">
                <Button x:Name="BtnFullscreenMenu"
                        Classes="circular-menu"
                        ToolTip.Tip="Menu"
                        AutomationProperties.Name="Fullscreen menu">
                    <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="18" Height="18"
                        Foreground="{StaticResource OsdForeground}" />
                    <Button.Flyout>
                        <Flyout Placement="Bottom"
                                Opened="TrackFlyoutOpened" Closed="TrackFlyoutClosed" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
