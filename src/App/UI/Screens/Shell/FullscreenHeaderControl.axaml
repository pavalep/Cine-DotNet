<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cine.Avalonia.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cine.Avalonia.Controls.FullscreenHeaderControl"
             x:DataType="vm:MainViewModel">
    <Border x:Name="FullscreenHeader"
            VerticalAlignment="Top" Height="44"
            IsVisible="False"
            Background="{StaticResource HeaderGradient}"
            ZIndex="25">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0">
            <TextBlock Grid.Column="0"
                       Text="{Binding Title}"
                       Foreground="{StaticResource OsdForeground}"
                       FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <Button x:Name="BtnFullscreenExit"
                        Classes="circular-menu" Width="30" Height="30"
                        Click="OnExitFullscreen"
                        ToolTip.Tip="Exit Fullscreen (F)">
                    <materialIcons:MaterialIcon Kind="FullscreenExit" Width="12" Height="12"
                        Foreground="{StaticResource OsdForeground}" />
                </Button>
                <Button x:Name="BtnFullscreenMenu"
                        Classes="circular-menu" Width="30" Height="30"
                        ToolTip.Tip="Menu">
                    <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="12" Height="12"
                        Foreground="{StaticResource OsdForeground}" />
                    <Button.Flyout>
                        <Flyout Placement="Bottom"
                                Opened="TrackFlyoutOpened" Closed="TrackFlyoutClosed" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
