<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cine.Avalonia.ViewModels"
             xmlns:controls="clr-namespace:Cine.Avalonia.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cine.Avalonia.Controls.ControlsBoxControl"
             x:DataType="vm:MainViewModel"
             x:Name="ControlsBoxRoot">
    <Border x:Name="ControlsBox" Classes="controls-box"
            Background="{StaticResource ControlsGradient}"
            HorizontalAlignment="Stretch"
            IsHitTestVisible="True"
            IsVisible="False"
            ZIndex="15">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
            </Transitions>
        </Border.Transitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ROW 0: TRANSPORT BUTTONS -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="{StaticResource space-h-3},8,{StaticResource space-h-3},4"
                        HorizontalAlignment="Center">
                <StackPanel.Styles>
                    <Style Selector="Button, ToggleButton">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </StackPanel.Styles>

                <!-- Group 1: Transport -->
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="BtnPrevious"
                            Classes="circular-transport"
                            Click="OnPrevious"
                            ToolTip.Tip="Previous (Shift+P)"
                            AutomationProperties.Name="Previous track">
                        <materialIcons:MaterialIcon Kind="SkipPrevious" Width="22" Height="22"
                            Foreground="{StaticResource OsdForeground}" />
                    </Button>
                    <Button x:Name="BtnPlayPause"
                            Classes="circular-play"
                            Click="OnPlayPause"
                            ToolTip.Tip="Play/Pause (Space)"
                            AutomationProperties.Name="Play or pause">
                        <materialIcons:MaterialIcon x:Name="PlayPauseIconPath" Kind="Play" Width="24" Height="24"
                            Foreground="{StaticResource OsdForeground}" />
                    </Button>
                    <Button x:Name="BtnNext"
                            Classes="circular-transport"
                            Click="OnNext"
                            ToolTip.Tip="Next (P)"
                            AutomationProperties.Name="Next track">
                        <materialIcons:MaterialIcon Kind="SkipNext" Width="22" Height="22"
                            Foreground="{StaticResource OsdForeground}" />
                    </Button>
                </StackPanel>

                <!-- Separator -->
                <Rectangle Width="1" Height="20" Fill="{StaticResource AppDivider}"
                           VerticalAlignment="Center" Margin="{StaticResource space-h-2}" IsHitTestVisible="False" />

                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="BtnVolumeMenu"
                            Classes="circular-menu"
                            ToolTip.Tip="Volume (M)"
                            PointerWheelChanged="OnVolumeButtonScroll">
                        <Panel Width="22" Height="22">
                            <materialIcons:MaterialIcon x:Name="VolumeIconPath" Kind="VolumeHigh" Width="22" Height="22"
                                Foreground="{StaticResource OsdForeground}" />
                        </Panel>
                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <Border Classes="volume-popover-content"
                                        Background="{StaticResource PopoverBackground}"
                                        BorderBrush="{StaticResource PopoverBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource radius-sm}"
                                        Padding="12,8">
                                    <StackPanel Orientation="Vertical" Spacing="6" Width="180"
                                                HorizontalAlignment="Center">
                                        <!-- Label row -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="Volume"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource OsdForeground}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       x:Name="VolumePercentLabel"
                                                       Text="{Binding VolumeValue, StringFormat='{}{0:F0}%'}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource OsdForeground}" />
                                        </Grid>
                                        <!-- Horizontal slider -->
                                        <Slider x:Name="VolumeSlider"
                                                Minimum="0" Maximum="150"
                                                Value="{Binding VolumeValue}"
                                                Orientation="Horizontal"
                                                Height="24"
                                                HorizontalAlignment="Stretch"
                                                PointerPressed="OnVolumeSliderPointerPressed">
                                            <Slider.Resources>
                                                <SolidColorBrush x:Key="SliderTrackFill">#39FFFFFF</SolidColorBrush>
                                                <SolidColorBrush x:Key="SliderTrackFillPointerOver">#50FFFFFF</SolidColorBrush>
                                                <SolidColorBrush x:Key="SliderTrackFillPressed">#50FFFFFF</SolidColorBrush>
                                                <SolidColorBrush x:Key="SliderTrackValueFill">White</SolidColorBrush>
                                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver">White</SolidColorBrush>
                                                <SolidColorBrush x:Key="SliderTrackValueFillPressed">White</SolidColorBrush>
                                                <SolidColorBrush x:Key="SliderThumbBackground">White</SolidColorBrush>
                                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver">#E5E5E5</SolidColorBrush>
                                                <SolidColorBrush x:Key="SliderThumbBackgroundPressed">#D6D6D6</SolidColorBrush>
                                            </Slider.Resources>
                                        </Slider>
                                        <!-- Volume presets row -->
                                        <Grid ColumnDefinitions="*,*,*,*" Margin="0,2,0,0">
                                            <Button Grid.Column="0" Classes="circular-sm" 
                                                    ToolTip.Tip="Mute" 
                                                    Click="OnToggleMute"
                                                    HorizontalAlignment="Stretch"
                                                    Padding="2">
                                                <materialIcons:MaterialIcon x:Name="MuteToggleIcon" Kind="VolumeOff" Width="14" Height="14"
                                                    Foreground="{StaticResource OsdForeground}" />
                                            </Button>
                                            <Button Grid.Column="1" Classes="circular-sm"
                                                    Click="OnPresetVolume25"
                                                    HorizontalAlignment="Stretch"
                                                    Padding="2">
                                                <TextBlock Text="25%" FontSize="11"
                                                    Foreground="{StaticResource OsdForeground}"
                                                    HorizontalAlignment="Center" />
                                            </Button>
                                            <Button Grid.Column="2" Classes="circular-sm"
                                                    Click="OnPresetVolume50"
                                                    HorizontalAlignment="Stretch"
                                                    Padding="2">
                                                <TextBlock Text="50%" FontSize="11"
                                                    Foreground="{StaticResource OsdForeground}"
                                                    HorizontalAlignment="Center" />
                                            </Button>
                                            <Button Grid.Column="3" Classes="circular-sm"
                                                    Click="OnPresetVolume100"
                                                    HorizontalAlignment="Stretch"
                                                    Padding="2">
                                                <TextBlock Text="100%" FontSize="11"
                                                    Foreground="{StaticResource OsdForeground}"
                                                    HorizontalAlignment="Center" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="BtnEqualizer"
                            Classes="circular-menu"
                            ToolTip.Tip="Equalizer"
                            Click="OnEqualizerClick"
                            AutomationProperties.Name="Equalizer">
                        <materialIcons:MaterialIcon Kind="Tune" Width="20" Height="20"
                            Foreground="{StaticResource OsdForeground}" />
                    </Button>
                    <Button x:Name="BtnVideoMenu"
                            Classes="circular-menu"
                            ToolTip.Tip="Video Track"
                            AutomationProperties.Name="Video track menu"
                            IsVisible="{Binding HasMultipleVideoTracks}"
                            Click="OnVideoMenuClick">
                        <materialIcons:MaterialIcon Kind="Video" Width="20" Height="20"
                            Foreground="{StaticResource OsdForeground}" />
                    </Button>
                </StackPanel>

                <!-- Separator -->
                <Rectangle Width="1" Height="20" Fill="{StaticResource AppDivider}"
                           VerticalAlignment="Center" Margin="{StaticResource space-h-2}" IsHitTestVisible="False" />

                <!-- Group 3: Mode -->
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton x:Name="BtnShufflePlaylist"
                                  Classes="circular-toggle"
                                  IsChecked="{Binding IsShuffleEnabled}"
                                  IsVisible="{Binding HasMultiplePlaylistItems}"
                                  Click="OnToggleShuffle"
                                  ToolTip.Tip="Shuffle Playlist"
                                  AutomationProperties.Name="Shuffle playlist">
                        <materialIcons:MaterialIcon Kind="ShuffleVariant" Width="18" Height="18"
                            Foreground="{StaticResource OsdForeground}" />
                    </ToggleButton>
                    <ToggleButton x:Name="BtnLoopFile"
                                  Classes="circular-toggle"
                                  IsChecked="{Binding IsLoopFileEnabled}"
                                  Click="OnToggleLoopFile"
                                  ToolTip.Tip="Loop File (L)"
                                  AutomationProperties.Name="Loop current file">
                        <materialIcons:MaterialIcon Kind="RepeatOnce" Width="18" Height="18"
                            Foreground="{StaticResource OsdForeground}" />
                    </ToggleButton>
                    <Button x:Name="BtnPlaylistDialog"
                            Classes="circular-menu"
                            Click="OnOpenPlaylistDialog"
                            ToolTip.Tip="Playlist"
                            AutomationProperties.Name="Playlist dialog">
                        <materialIcons:MaterialIcon Kind="PlaylistMusic" Width="18" Height="18"
                            Foreground="{StaticResource OsdForeground}" />
                    </Button>
                </StackPanel>

                <!-- Separator -->
                <Rectangle Width="1" Height="20" Fill="{StaticResource AppDivider}"
                           VerticalAlignment="Center" Margin="{StaticResource space-h-2}" IsHitTestVisible="False" />

                <!-- Group 4: Tools -->
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="BtnChaptersMenu"
                            Classes="circular-menu"
                            IsVisible="{Binding HasChapters}"
                            ToolTip.Tip="Chapters"
                            Click="OnChaptersMenuClick">
                        <materialIcons:MaterialIcon Kind="BookmarkOutline" Width="18" Height="18"
                            Foreground="{StaticResource OsdForeground}" />
                    </Button>
                    <Button x:Name="BtnVideoEqualizer"
                            Classes="circular-menu"
                            ToolTip.Tip="Video Equalizer"
                            Click="OnVideoEqualizerClick">
                        <materialIcons:MaterialIcon Kind="Palette" Width="18" Height="18"
                            Foreground="{StaticResource OsdForeground}" />
                    </Button>
                    <controls:SubtitleOverlayControl x:Name="SubOverlayCtrl"
                                                     Width="40" Height="40"
                                                     Padding="0"
                                                     VerticalAlignment="Center" />
                    <controls:AudioTrackSelectorControl x:Name="AudioOverlayCtrl"
                                                        Width="40" Height="40"
                                                        Padding="0"
                                                        VerticalAlignment="Center" />
                    <ToggleButton x:Name="BtnFullscreen"
                                  Classes="circular-toggle"
                                  Click="OnToggleFullscreen"
                                  ToolTip.Tip="Fullscreen (F)">
                        <materialIcons:MaterialIcon x:Name="FullscreenIconPath" Kind="Fullscreen" Width="18" Height="18"
                            Foreground="{StaticResource OsdForeground}" />
                    </ToggleButton>
                </StackPanel>
            </StackPanel>

            <!-- ROW 1: SEEK BAR + TIME -->
            <controls:SeekBarControl Grid.Row="1"
                                     x:Name="SeekBar"
                                     Margin="{StaticResource space-h-3}" />
        </Grid>
    </Border>
</UserControl>
