<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cine.Avalonia.ViewModels"
             xmlns:components="using:Cine.Avalonia.Components"
             xmlns:controls="clr-namespace:Cine.Avalonia.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cine.Avalonia.Controls.ControlsBoxControl"
             x:DataType="vm:MainViewModel"
             x:Name="ControlsBoxRoot">
    <Border x:Name="ControlsBox" Classes="controls-box"
            Background="{StaticResource ControlsGradient}"
            HorizontalAlignment="Stretch"
            IsHitTestVisible="True"
            ZIndex="15">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
            </Transitions>
        </Border.Transitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ROW 0: TRANSPORT BUTTONS -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="13,10,13,4"
                        HorizontalAlignment="Center">
                <StackPanel.Styles>
                    <Style Selector="Button, ToggleButton">
                        <Setter Property="Width" Value="34" />
                        <Setter Property="Height" Value="34" />
                        <Setter Property="Margin" Value="2" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </StackPanel.Styles>

                <!-- Group 1: Transport -->
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="BtnPrevious"
                            Classes="circular-transport"
                            Click="OnPrevious"
                            ToolTip.Tip="Previous (Shift+P)">
                        <materialIcons:MaterialIcon Kind="SkipPrevious" Width="18" Height="18"
                            Foreground="{StaticResource OsdForeground}" />
                    </Button>
                    <Button x:Name="BtnPlayPause"
                            Classes="circular-transport"
                            Click="OnPlayPause"
                            ToolTip.Tip="Play/Pause (Space)">
                        <materialIcons:MaterialIcon x:Name="PlayPauseIconPath" Kind="Play" Width="18" Height="18"
                            Foreground="{StaticResource OsdForeground}" />
                    </Button>
                    <Button x:Name="BtnNext"
                            Classes="circular-transport"
                            Click="OnNext"
                            ToolTip.Tip="Next (P)">
                        <materialIcons:MaterialIcon Kind="SkipNext" Width="18" Height="18"
                            Foreground="{StaticResource OsdForeground}" />
                    </Button>
                </StackPanel>

                <!-- Separator -->
                <Rectangle Width="1" Height="20" Fill="#26FFFFFF"
                           VerticalAlignment="Center" Margin="8,0" IsHitTestVisible="False" />

                <!-- Group 2: Audio/Subtitle -->
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="BtnVolumeMenu"
                            Classes="circular-menu"
                            ToolTip.Tip="Volume (M)"
                            PointerWheelChanged="OnVolumeButtonScroll">
                        <Panel Width="18" Height="18">
                            <materialIcons:MaterialIcon x:Name="VolumeIconPath" Kind="VolumeHigh" Width="18" Height="18"
                                Foreground="{StaticResource OsdForeground}" />
                            <materialIcons:MaterialIcon x:Name="VolumeArcsPath" Kind="VolumeMedium" Width="18" Height="18"
                                Foreground="{StaticResource OsdForeground}"
                                Opacity="0" />
                            <materialIcons:MaterialIcon x:Name="VolumeMuteCrossPath" Kind="VolumeOff" Width="18" Height="18"
                                Foreground="{StaticResource OsdForeground}"
                                IsVisible="False" />
                        </Panel>
                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <Border Classes="volume-popover-content"
                                        Background="{StaticResource PopoverBackground}"
                                        BorderBrush="{StaticResource PopoverBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="8">
                                    <StackPanel Orientation="Vertical" Spacing="10" Width="64"
                                                HorizontalAlignment="Center">
                                        <ToggleButton x:Name="BtnMuteToggle"
                                                      Classes="circular-toggle"
                                                      IsChecked="{Binding IsMuted}"
                                                      Click="OnToggleMute"
                                                      ToolTip.Tip="Mute"
                                                      Width="40" Height="40"
                                                      HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="VolumeHigh" Width="20" Height="20"
                                                Foreground="{StaticResource OsdForeground}" />
                                        </ToggleButton>
                                        <Slider x:Name="VolumeSlider"
                                                Classes="volume-slider"
                                                Minimum="0" Maximum="130"
                                                Value="{Binding VolumeValue}"
                                                Orientation="Vertical"
                                                Height="120"
                                                HorizontalAlignment="Center"
                                                PointerPressed="OnVolumeSliderPointerPressed" />
                                        <TextBlock x:Name="VolumePercentLabel"
                                                   Text="{Binding VolumeValue, StringFormat='{}{0:F0} / 130%'}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource OsdForeground}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="BtnSubtitlesMenu"
                            Classes="circular-menu"
                            ToolTip.Tip="Subtitles"
                            Click="OnSubtitlesMenuClick">
                        <materialIcons:MaterialIcon x:Name="SubtitleIconPath" Kind="Subtitles" Width="18" Height="18"
                            Foreground="{StaticResource OsdForeground}" />
                    </Button>
                    <Button x:Name="BtnAudioMenu"
                            Classes="circular-menu"
                            ToolTip.Tip="Audio Tracks"
                            Click="OnAudioMenuClick">
                        <materialIcons:MaterialIcon x:Name="AudioIconPath" Kind="Music" Width="18" Height="18"
                            Foreground="{StaticResource OsdForeground}" />
                    </Button>
                    <Button x:Name="BtnVideoMenu"
                            Classes="circular-menu"
                            ToolTip.Tip="Video Tracks"
                            IsVisible="{Binding HasMultipleVideoTracks}"
                            Click="OnVideoMenuClick">
                        <materialIcons:MaterialIcon Kind="Video" Width="18" Height="18"
                            Foreground="{StaticResource OsdForeground}" />
                    </Button>
                </StackPanel>

                <!-- Separator -->
                <Rectangle Width="1" Height="20" Fill="#26FFFFFF"
                           VerticalAlignment="Center" Margin="8,0" IsHitTestVisible="False" />

                <!-- Group 3: Mode -->
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton x:Name="BtnShufflePlaylist"
                                  Classes="circular-toggle"
                                  IsChecked="{Binding IsShuffleEnabled}"
                                  IsVisible="{Binding HasMultiplePlaylistItems}"
                                  Click="OnToggleShuffle"
                                  ToolTip.Tip="Shuffle Playlist">
                        <materialIcons:MaterialIcon Kind="ShuffleVariant" Width="16" Height="16"
                            Foreground="{StaticResource OsdForeground}" />
                    </ToggleButton>
                    <ToggleButton x:Name="BtnLoopPlaylist"
                                  Classes="circular-toggle"
                                  IsChecked="{Binding IsLoopPlaylistEnabled}"
                                  IsVisible="{Binding HasMultiplePlaylistItems}"
                                  Click="OnToggleLoopPlaylist"
                                  ToolTip.Tip="Loop Playlist">
                        <materialIcons:MaterialIcon Kind="Repeat" Width="16" Height="16"
                            Foreground="{StaticResource OsdForeground}" />
                    </ToggleButton>
                    <ToggleButton x:Name="BtnLoopFile"
                                  Classes="circular-toggle"
                                  IsChecked="{Binding IsLoopFileEnabled}"
                                  Click="OnToggleLoopFile"
                                  ToolTip.Tip="Loop File (L)">
                        <materialIcons:MaterialIcon Kind="RepeatOnce" Width="14" Height="14"
                            Foreground="{StaticResource OsdForeground}" />
                    </ToggleButton>
                    <Button x:Name="BtnPlaylistDialog"
                            Classes="circular-menu"
                            Click="OnOpenPlaylistDialog"
                            ToolTip.Tip="Playlist">
                        <materialIcons:MaterialIcon Kind="PlaylistMusic" Width="16" Height="16"
                            Foreground="{StaticResource OsdForeground}" />
                    </Button>
                </StackPanel>

                <!-- Separator -->
                <Rectangle Width="1" Height="20" Fill="#26FFFFFF"
                           VerticalAlignment="Center" Margin="8,0" IsHitTestVisible="False" />

                <!-- Group 4: Tools -->
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <components:OptionsMenuButton x:Name="BtnOptionsMenu" />
                    <ToggleButton x:Name="BtnFullscreen"
                                  Classes="circular-toggle"
                                  Click="OnToggleFullscreen"
                                  ToolTip.Tip="Fullscreen (F)">
                        <materialIcons:MaterialIcon x:Name="FullscreenIconPath" Kind="Fullscreen" Width="14" Height="14"
                            Foreground="{StaticResource OsdForeground}" />
                    </ToggleButton>
                </StackPanel>
            </StackPanel>

            <!-- ROW 1: SEEK BAR + TIME -->
            <controls:SeekBarControl Grid.Row="1"
                                     x:Name="SeekBar"
                                     Margin="3,0,20,5" />
        </Grid>
    </Border>
</UserControl>
