<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cine.Avalonia.ViewModels"
             xmlns:components="using:Cine.Avalonia.Components"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cine.Avalonia.Controls.HeaderBarControl"
             x:DataType="vm:MainViewModel"
             x:Name="HeaderBarRoot">
    <Border x:Name="HeaderBar" Classes="header-bar"
            Background="{StaticResource HeaderGradient}"
            BorderBrush="{StaticResource AppBorderDim}"
            BorderThickness="0,0,0,1"
            VerticalAlignment="Top"
            HorizontalAlignment="Stretch"
            Height="{StaticResource size-header-bar}"
            IsHitTestVisible="True"
            ZIndex="20"
            PointerPressed="OnHeaderPointerPressed">
        <Grid x:Name="HeaderGrid" Margin="{StaticResource space-h-2}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Col 0: Open Menu Button -->
            <Button Grid.Column="0"
                    x:Name="BtnOpenMenu"
                    IsVisible="False"
                    VerticalAlignment="Center"
                    Margin="{StaticResource space-h-l2-r1}"
                    Background="{StaticResource AppHover}"
                    CornerRadius="99"
                    BorderThickness="0"
                    Padding="14,6">
                <Button.Styles>
                    <Style Selector="Button#BtnOpenMenu /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="Button#BtnOpenMenu:pointerover">
                        <Setter Property="Background" Value="{StaticResource AppHoverStrong}" />
                    </Style>
                    <Style Selector="Button#BtnOpenMenu:pressed">
                        <Setter Property="Background" Value="{StaticResource AppPressed}" />
                    </Style>
                </Button.Styles>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource space-spacing-1}">
                    <TextBlock Text="Open"
                               Foreground="{StaticResource OsdForeground}"
                               Classes="md3-body2"
                               VerticalAlignment="Center" />
                    <materialIcons:MaterialIcon Kind="MenuDown" Width="8" Height="8"
                        Foreground="{StaticResource OsdForeground}"
                        Opacity="0.7"
                        VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft"
                            Opened="TrackFlyoutOpened" Closed="TrackFlyoutClosed">
                        <Border Background="{StaticResource PopoverBackground}"
                                BorderBrush="{StaticResource PopoverBorder}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource radius-sm}"
                                Padding="{StaticResource space-1}">
                            <StackPanel Width="{StaticResource size-dialog-min-width-menu}">
                                <StackPanel.Styles>
                                    <Style Selector="Button.flyout-item">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="10,7" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </Style>
                                    <Style Selector="Button.flyout-item:pointerover">
                                        <Setter Property="Background" Value="{StaticResource AppHoverSubtle}" />
                                    </Style>
                                    <Style Selector="Button.flyout-item TextBlock">
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="FontWeight" Value="500" />
                                        <Setter Property="Foreground" Value="{StaticResource OsdForeground}" />
                                    </Style>
                                </StackPanel.Styles>
                                <Button Classes="flyout-item"
                                        Command="{Binding OpenFilesCommand}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <materialIcons:MaterialIcon Kind="Play" Width="14" Height="14"
                                            Foreground="{StaticResource OsdForeground}" />
                                        <TextBlock Grid.Column="1" Text="Open Files" Margin="{StaticResource space-left-10}" />
                                    </Grid>
                                </Button>
                                <Button Classes="flyout-item"
                                        Command="{Binding OpenFolderCommand}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <materialIcons:MaterialIcon Kind="Folder" Width="14" Height="14"
                                            Foreground="{StaticResource OsdForeground}" />
                                        <TextBlock Grid.Column="1" Text="Open Folder" Margin="{StaticResource space-left-10}" />
                                    </Grid>
                                </Button>
                                <Separator Background="{StaticResource PopoverBorder}" />
                                <Button Classes="flyout-item"
                                        Command="{Binding AddFilesCommand}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14"
                                            Foreground="{StaticResource OsdForeground}" />
                                        <TextBlock Grid.Column="1" Text="Add Files" Margin="{StaticResource space-left-10}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- Col 1: Window Title (centered) -->
            <Border Grid.Column="1"
                    CornerRadius="{StaticResource radius-xs}"
                    Background="{StaticResource AppOverlayLight}"
                    Padding="{StaticResource space-3}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Cine"
                           Foreground="{StaticResource OsdForeground}"
                           Classes="md3-subtitle1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="300" />
            </Border>

            <!-- Col 2: PIP + Menu + Window Controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="0">
                <ToggleButton x:Name="BtnPip" IsVisible="False"
                              Classes="circular-menu"
                              Margin="{StaticResource space-right-1}"
                              Click="OnTogglePip"
                              ToolTip.Tip="Picture-in-Picture"
                              AutomationProperties.Name="Picture in Picture">
                    <materialIcons:MaterialIcon Kind="PictureInPictureBottomRight" Width="18" Height="18"
                        Foreground="{StaticResource OsdForeground}" />
                </ToggleButton>

                <!-- Primary Menu Button -->
                <Button x:Name="BtnPrimaryMenu" IsVisible="False"
                        Classes="circular-menu"
                        ToolTip.Tip="Main Menu"
                        Margin="{StaticResource space-right-1}"
                        AutomationProperties.Name="Main menu">
                    <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="18" Height="18"
                        Foreground="{StaticResource OsdForeground}" />
                    <Button.Flyout>
                        <Flyout Placement="Bottom"
                                Opened="TrackFlyoutOpened" Closed="TrackFlyoutClosed" />
                    </Button.Flyout>
                </Button>

                <!-- Fullscreen Close Button -->
                <Button x:Name="BtnFullscreenClose"
                        Classes="circular-menu"
                        ToolTip.Tip="Close"
                        Click="OnFullscreenCloseClick"
                        IsVisible="False"
                        Margin="{StaticResource space-right-1}">
                    <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18"
                        Foreground="{StaticResource OsdForeground}" />
                </Button>

                <!-- Native Window Controls -->
                <StackPanel Orientation="Horizontal" Spacing="0"
                            IsVisible="True" x:Name="WindowControlsPanel"
                            Margin="{StaticResource space-right-1}">
                    <Button x:Name="BtnMinimize" Click="OnMinimizeClick"
                            Classes="window-control"
                            ToolTip.Tip="Minimize">
                        <materialIcons:MaterialIcon Kind="WindowMinimize" Width="14" Height="14"
                            Foreground="{StaticResource OsdForeground}" />
                    </Button>
                    <Button x:Name="BtnMaximizeRestore" Click="OnMaximizeRestoreClick"
                            Classes="window-control"
                            ToolTip.Tip="Maximize">
                        <materialIcons:MaterialIcon x:Name="MaximizeRestoreIconPath" Kind="WindowMaximize" Width="12" Height="12"
                            Foreground="{StaticResource OsdForeground}" />
                    </Button>
                    <Button x:Name="BtnClose" Click="OnCloseClick"
                            Classes="window-control close"
                            ToolTip.Tip="Close">
                        <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12"
                            Foreground="{StaticResource OsdForeground}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
