<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <!-- ======================== -->
    <!--  BASE COLORS             -->
    <!-- ======================== -->
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="White">#FFFFFF</Color>
    
    <!-- ======================== -->
    <!--  GRAY SCALE              -->
    <!-- ======================== -->
    <Color x:Key="Gray100">#E5E5E5</Color>
    <Color x:Key="Gray200">#D6D6D6</Color>
    <Color x:Key="Gray300">#B0B0B0</Color>
    <Color x:Key="Gray400">#808080</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#555555</Color>
    <Color x:Key="Gray700">#3D3D3D</Color>
    <Color x:Key="Gray800">#2D2D30</Color>
    <Color x:Key="Gray900">#1E1E1E</Color>
    <Color x:Key="Gray950">#131313</Color>
    
    <!-- ======================== -->
    <!--  PRIMARY ACCENT          -->
    <!-- ======================== -->
    <Color x:Key="Accent">#0078D4</Color>
    <Color x:Key="AccentHover">#106EBE</Color>
    <Color x:Key="AccentPressed">#005A9E</Color>
    
    <!-- ======================== -->
    <!--  OSD (On-Screen Display)  -->
    <!--  Matches reference       -->
    <!--  code_for_reference/     -->
    <!--  src/style.css exactly   -->
    <!-- ======================== -->
    <SolidColorBrush x:Key="OsdForeground" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="OsdBackground" Color="#CC000000" />
    
    <!-- Reference: linear-gradient(180deg, rgba(0,0,0,0.14) 0%, rgba(0,0,0,0.08) 40%, rgba(0,0,0,0) 100%)
         Canvas spec: rgba(0,0,0,.30)→.15→0 at 17%  -->
    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#C0102035" />
        <GradientStop Offset="0.05" Color="#55001830" />
        <GradientStop Offset="0.17" Color="#00000000" />
    </LinearGradientBrush>
    
    <!-- Reference: linear-gradient(0deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.1) 40%, rgba(0,0,0,0) 100%)
         Canvas spec: rgba(0,0,0,.40)→.23→0 at 35% -->
    <LinearGradientBrush x:Key="ControlsGradient" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Offset="0" Color="#D0081420" />
        <GradientStop Offset="0.1" Color="#88001830" />
        <GradientStop Offset="0.35" Color="#22000000" />
    </LinearGradientBrush>

    <!-- Reference: header+controls combined gradient from style.css -->
    <LinearGradientBrush x:Key="HeaderAndControlsGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#B00A1625" />
        <GradientStop Offset="0.05" Color="#44001528" />
        <GradientStop Offset="0.17" Color="#00000000" />
        <GradientStop Offset="0.65" Color="#00000000" />
        <GradientStop Offset="0.9" Color="#88001830" />
        <GradientStop Offset="1" Color="#D0081420" />
    </LinearGradientBrush>

    <!-- Playback background: radial-gradient(ellipse at 58% 42%, #192848→#090e1d→#000) -->
    <RadialGradientBrush x:Key="PlaybackRadialBackground" Center="0.58,0.42" GradientOrigin="0.58,0.42">
        <GradientStop Offset="0" Color="#FF192848" />
        <GradientStop Offset="0.55" Color="#FF090E1D" />
        <GradientStop Offset="1" Color="#FF000000" />
    </RadialGradientBrush>

    <!-- Vignette: radial-gradient(center, transparent 40%, rgba(0,0,0,.45)) -->
    <RadialGradientBrush x:Key="VignetteOverlay" Center="0.5,0.5" GradientOrigin="0.5,0.5">
        <GradientStop Offset="0" Color="#00000000" />
        <GradientStop Offset="0.4" Color="#00000000" />
        <GradientStop Offset="1" Color="#73000000" />
    </RadialGradientBrush>

    <!-- Start page background: linear-gradient(180deg, transparent 0%, #0c0c0e 100%) -->
    <LinearGradientBrush x:Key="StartPageBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF000000" />
        <GradientStop Offset="1" Color="#FF0C0C0E" />
    </LinearGradientBrush>
    
    <!-- ======================== -->
    <!--  BUTTON STATES           -->
    <!--  Matches reference       -->
    <!-- ======================== -->
    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
    <!-- Reference: rgba(255,255,255,0.17) -->
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#2BFFFFFF" />
    <!-- Reference: rgba(255,255,255,0.25) -->
    <SolidColorBrush x:Key="ButtonActiveBackground" Color="#40FFFFFF" />
    
    <SolidColorBrush x:Key="ToggleButtonUncheckedBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackground" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedForeground" Color="{StaticResource White}" />
    
    <!-- ======================== -->
    <!--  TEXT / ICON SHADOW      -->
    <!--  Reference: 0px 1px 6px  -->
    <!--  rgba(0,0,0,0.6)        -->
    <!-- ======================== -->
    <BoxShadows x:Key="OsdTextShadow">0 1 6 #99000000</BoxShadows>
    <BoxShadows x:Key="OsdIconShadow">0 1 6 #99000000</BoxShadows>
    
    <!-- Big play/pause icon shadow: 0px 1px 8px rgba(0,0,0,0.55) -->
    <BoxShadows x:Key="BigPlayIconShadow">0 1 8 #8C000000</BoxShadows>
    
    <!-- ======================== -->
    <!--  PROGRESS / SEEK BAR     -->
    <!-- ======================== -->
    <!-- Reference: rgba(255,255,255,0.225) -->
    <SolidColorBrush x:Key="ProgressTroughBackground" Color="#39FFFFFF" />
    <SolidColorBrush x:Key="ProgressSliderBackground" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="ProgressSliderForeground" Color="{StaticResource Accent}" />
    
    <!-- ======================== -->
    <!--  VOLUME                  -->
    <!-- ======================== -->
    <SolidColorBrush x:Key="VolumeTroughBackground" Color="#39FFFFFF" />
    <SolidColorBrush x:Key="VolumeSliderBackground" Color="{StaticResource White}" />
    
    <!-- ======================== -->
    <!--  POPOVER / MENU          -->
    <!-- ======================== -->
    <!-- Reference: rgba(25,25,27,0.95) border #202021 -->
    <SolidColorBrush x:Key="PopoverBackground" Color="#F219191B" />
    <SolidColorBrush x:Key="PopoverBorder" Color="#FF202021" />
    
    <!-- ======================== -->
    <!--  STATUS BAR              -->
    <!-- ======================== -->
    <Color x:Key="StatusBarBackgroundColor">#CC000000</Color>
    
    <!-- Time separator -->
    <SolidColorBrush x:Key="TimeSeparatorBackground" Color="#DDDDDD" />

    <!-- ======================== -->
    <!--  WINDOW SYSTEM BUTTONS   -->
    <!-- ======================== -->
    <SolidColorBrush x:Key="WindowButtonHoverBackground" Color="#2BFFFFFF" />
    <SolidColorBrush x:Key="WindowCloseButtonHoverBackground" Color="#E81123" />

    <!-- ======================== -->
    <!--  APP COLOR SYSTEM        -->
    <!--  Matches AppColors.cs    -->
    <!-- ======================== -->
    <SolidColorBrush x:Key="AppBackground" Color="#FF0C0C0E" />
    <SolidColorBrush x:Key="AppSurface" Color="#FF1A1A2E" />
    <SolidColorBrush x:Key="AppSurfaceLight" Color="#FF2A2A3E" />
    <SolidColorBrush x:Key="AppDialogSurface" Color="#F01E1E2E" />

    <SolidColorBrush x:Key="AppAccent" Color="#FF6CB4FF" />
    <SolidColorBrush x:Key="AppAccentDim" Color="#804AA3FF" />
    <SolidColorBrush x:Key="AppAccentLight" Color="#FF4AA3FF" />

    <SolidColorBrush x:Key="AppTextPrimary" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="AppTextOnDarkPrimary" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="AppTextOnDarkSecondary" Color="#AAFFFFFF" />
    <SolidColorBrush x:Key="AppTextOnDarkHint" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="AppTextOnDarkDisabled" Color="#50FFFFFF" />
    <SolidColorBrush x:Key="AppTextOnDarkTertiary" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="AppTextOnDarkSubtle" Color="#60FFFFFF" />

    <SolidColorBrush x:Key="AppOverlay" Color="#B0000000" />
    <SolidColorBrush x:Key="AppOverlayLight" Color="#80000000" />
    <SolidColorBrush x:Key="AppOverlayDark" Color="#66000000" />
    <SolidColorBrush x:Key="AppOverlayChrome" Color="#BD000000" />

    <SolidColorBrush x:Key="AppDivider" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="AppDividerStrong" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="AppBorderLight" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="AppBorderDim" Color="#20FFFFFF" />

    <SolidColorBrush x:Key="AppHoverSubtle" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="AppHover" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="AppHoverStrong" Color="#2BFFFFFF" />
    <SolidColorBrush x:Key="AppPressed" Color="#40FFFFFF" />

    <SolidColorBrush x:Key="AppIconLight" Color="#44FFFFFF" />
    <SolidColorBrush x:Key="AppIconDim" Color="#30FFFFFF" />
    <SolidColorBrush x:Key="AppTextMuted" Color="#AAAAAA" />

    <!-- Drag-drop accent (Windows blue) -->
    <SolidColorBrush x:Key="AppDragAccent" Color="#FF0078D7" />
    <SolidColorBrush x:Key="AppDragAccentDim" Color="#400078D7" />
</Styles.Resources>
</Styles>