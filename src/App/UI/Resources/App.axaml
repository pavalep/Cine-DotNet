<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        
    <Styles.Resources>
    </Styles.Resources>
    
    <!-- ======================== -->
    <!--  RESOURCE DICTIONARIES   -->
    <!-- ======================== -->
    <StyleInclude Source="avares://App/UI/Resources/Colors.axaml" />
    <StyleInclude Source="avares://App/UI/Resources/Typography.axaml" />
    <StyleInclude Source="avares://App/UI/Resources/Icons.axaml" />
    
    <!-- ======================== -->
    <!--  GLOBAL STYLES           -->
    <!-- ======================== -->
    
    <!-- Window Base Style -->
    <Style Selector="Window">
        <Setter Property="Background" Value="#FF0C0C0E" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{StaticResource SystemFont}" />
        <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
        <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="0" />
        <Setter Property="WindowDecorations" Value="BorderOnly" />
    </Style>

    <!-- Global ToolTip delay -->
    <Style Selector="ToolTip">
        <Setter Property="ShowDelay" Value="600" />
    </Style>

    <!-- ======================== -->
    <!--  TRANSPORT BUTTONS       -->
    <!-- ======================== -->
    
    <!-- Circular Transport Button (matches reference) -->
    <Style Selector="Button.circular-transport">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.12" />
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#RootBorder">
            <Setter Property="Background" Value="{StaticResource ButtonHoverBackground}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#RootBorder">
            <Setter Property="Background" Value="{StaticResource ButtonActiveBackground}" />
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#ContentPresenter">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.08" ScaleY="1.08" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                </Setter.Value>
            </Setter>
        </Style>
    </Style>
    
    <!-- Circular Play Button (larger, 40x40) -->
    <Style Selector="Button.circular-play">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.12" />
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#RootBorder">
            <Setter Property="Background" Value="{StaticResource ButtonHoverBackground}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#RootBorder">
            <Setter Property="Background" Value="{StaticResource ButtonActiveBackground}" />
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#ContentPresenter">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.08" ScaleY="1.08" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                </Setter.Value>
            </Setter>
        </Style>
    </Style>
    
    <!-- Circular Menu Button -->
    <Style Selector="Button.circular-menu">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.12" />
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#RootBorder">
            <Setter Property="Background" Value="{StaticResource ButtonHoverBackground}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#RootBorder">
            <Setter Property="Background" Value="{StaticResource ButtonActiveBackground}" />
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#ContentPresenter">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.08" ScaleY="1.08" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                </Setter.Value>
            </Setter>
        </Style>
    </Style>
    
    <!-- Circular Menu ToggleButton -->
    <Style Selector="ToggleButton.circular-menu">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{StaticResource ButtonHoverBackground}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{StaticResource ButtonActiveBackground}" />
        </Style>
    </Style>
    
    <!-- Circular Toggle Button (matches reference) -->
    <Style Selector="ToggleButton.circular-toggle">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.12" />
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#RootBorder">
            <Setter Property="Background" Value="{StaticResource ButtonHoverBackground}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#RootBorder">
            <Setter Property="Background" Value="{StaticResource ButtonActiveBackground}" />
        </Style>
        <Style Selector="^:checked /template/ Border#RootBorder">
            <Setter Property="Background" Value="{StaticResource ToggleButtonCheckedBackground}" />
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#ContentPresenter">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </Style>
    
    <!-- ======================== -->
    <!--  POPOVER / FLYOUTS       -->
    <!-- ======================== -->
    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{StaticResource PopoverBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource PopoverBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="FlyoutPresenter /template/ Border#PART_LayoutRoot">
        <Setter Property="BoxShadow" Value="0 4 16 0 #80000000" />
    </Style>

    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{StaticResource PopoverBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource PopoverBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector="MenuFlyoutPresenter /template/ Border#PART_LayoutRoot">
        <Setter Property="BoxShadow" Value="0 4 16 0 #80000000" />
    </Style>
    
    <!-- ======================== -->
    <!--  START PAGE BUTTONS      -->
    <!-- ======================== -->
    <Style Selector="Button.start-page-button">
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="#1FFFFFFF" />
        <Setter Property="Foreground" Value="#E5E5E5" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.start-page-button:pointerover /template/ Border#RootBorder">
        <Setter Property="Background" Value="#26FFFFFF" />
    </Style>
    <Style Selector="Button.start-page-button:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <Style Selector="Button.start-page-suggested-action">
        <Setter Property="Background" Value="#E5E5E5" />
        <Setter Property="Foreground" Value="Black" />
    </Style>
    <Style Selector="Button.start-page-suggested-action:pointerover /template/ Border#RootBorder">
        <Setter Property="Background" Value="White" />
    </Style>

    <!-- ======================== -->
    <!--  VOLUME POPOVER          -->
    <!-- ======================== -->
    <Style Selector="Popup.volume-popover">
        <Setter Property="Placement" Value="Bottom" />
    </Style>
    
    <!-- Volume Popover Content -->
    <Style Selector="Border.volume-popover-content">
        <Setter Property="Background" Value="{StaticResource PopoverBackground}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource PopoverBorder}" />
    </Style>
    
    <!-- ======================== -->
    <!--  VIDEO INFO OVERLAYS     -->
    <!-- ======================== -->
    
    <!-- Chapter Badge (top-right) -->
    <Style Selector="Border.chapter-badge-overlay">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="12" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{StaticResource AppOverlayChrome}" />
    </Style>
    
    <!-- ======================== -->
    <!--  OSD CONTROLS OVERLAY    -->
    <!-- ======================== -->
    
    <!-- OSD Notification Style -->
    <Style Selector="Border.OsdNotificationStyle">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,0,80" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Background" Value="#CC000000" />
        <Setter Property="Opacity" Value="0" />
        <Style.Animations>
            <Animation Duration="0:0:0.30" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    
    <!-- OSD Text & Icon Shadows — matches reference: text-shadow 0 1 6 rgba(0,0,0,0.6), icon-shadow same -->
    <Style Selector="Border.header-bar Path, Border.header-bar TextBlock, Border.controls-box Path, Border.controls-box TextBlock, Border.header-and-controls Path, Border.header-and-controls TextBlock">
        <Setter Property="Effect" Value="drop-shadow(0 1 6 #99000000)" />
    </Style>

    <!-- UI Controls Overlay -->
    <Style Selector="Border.ui-controls-overlay">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    
    <!-- Loading Spinner Animation -->
    <Style Selector="Border.loading-spinner">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="INFINITE">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    
    <!-- Header Bar -->
    <Style Selector="Border.header-bar">
        <Setter Property="Height" Value="56" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{StaticResource HeaderGradient}" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header + Controls combined overlay (matches reference .header-and-controls) -->
    <Style Selector="Border.header-and-controls">
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Background" Value="{StaticResource HeaderAndControlsGradient}" />
    </Style>
    
    <!-- Controls Box (bottom area with gradient) -->
    <Style Selector="Border.controls-box">
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Background" Value="{StaticResource ControlsGradient}" />
        <Setter Property="Padding" Value="0,0,0,12" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- ======================== -->
    <!--  TEXT STYLES             -->
    <!-- ======================== -->
    
    <!-- Time Labels -->
    <Style Selector="TextBlock.time-label">
        <Setter Property="FontFamily" Value="{StaticResource NumericFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource OsdForeground}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    
    <!-- Speed Display -->
    <Style Selector="TextBlock.speed-display">
        <Setter Property="FontFamily" Value="{StaticResource NumericFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource OsdForeground}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    
    <!-- Status Text -->
    <Style Selector="TextBlock.status-text">
        <Setter Property="FontFamily" Value="{StaticResource NumericFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource AppTextMuted}" />
    </Style>
    
    <!-- Seek Slider -->
    <Style Selector="Slider.seek-slider">
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="{StaticResource ProgressTroughBackground}" />
        <Setter Property="Foreground" Value="{StaticResource ProgressSliderBackground}" />
    </Style>
    
    <!-- Volume Slider -->
    <Style Selector="Slider.volume-slider">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="120" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource VolumeTroughBackground}" />
        <Setter Property="Foreground" Value="{StaticResource VolumeSliderBackground}" />
        <Style.Resources>
            <SolidColorBrush x:Key="SliderTrackFill">#39FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="SliderTrackFillPointerOver">#50FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="SliderTrackFillPressed">#50FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="SliderTrackValueFill">White</SolidColorBrush>
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver">White</SolidColorBrush>
            <SolidColorBrush x:Key="SliderTrackValueFillPressed">White</SolidColorBrush>
            <SolidColorBrush x:Key="SliderThumbBackground">White</SolidColorBrush>
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver">#E5E5E5</SolidColorBrush>
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed">#D6D6D6</SolidColorBrush>
        </Style.Resources>
    </Style>

    <!-- ======================== -->
    <!--  TRACK MENU ITEMS        -->
    <!-- ======================== -->

    <!-- MenuItem style for track selection items -->
    <Style Selector="MenuItem.track-item">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinWidth" Value="160" />
    </Style>

    <!-- Selected track indicator - bold text accent color for active track -->
    <Style Selector="MenuItem.track-item:selected">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Pseudo-entry styling (None, Add...) -->
    <Style Selector="MenuItem.track-pseudo">
        <Setter Property="Opacity" Value="0.75" />
    </Style>

    <!-- ======================== -->
    <!--  NUMERICUPDOWN DARK THEME -->
    <!-- ======================== -->
    <Style Selector="NumericUpDown">
        <Setter Property="Background" Value="{StaticResource Gray900}" />
        <Setter Property="Foreground" Value="{StaticResource OsdForeground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Gray700}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="ButtonSpinnerLocation" Value="Right" />
    </Style>
    <Style Selector="NumericUpDown:pointerover">
        <Setter Property="BorderBrush" Value="#6E6E6E" />
    </Style>
    <Style Selector="NumericUpDown:focus-within">
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="NumericUpDown /template/ RepeatButton">
        <Setter Property="Background" Value="#2D2D30" />
        <Setter Property="Foreground" Value="{StaticResource OsdForeground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Gray700}" />
    </Style>
    <Style Selector="NumericUpDown /template/ RepeatButton:pointerover">
        <Setter Property="Background" Value="#3D3D3D" />
    </Style>
    <Style Selector="NumericUpDown /template/ RepeatButton:pressed">
        <Setter Property="Background" Value="{StaticResource Gray600}" />
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox">
        <Setter Property="Background" Value="{StaticResource Gray900}" />
        <Setter Property="Foreground" Value="{StaticResource OsdForeground}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ======================== -->
    <!--  WINDOW CONTROL BUTTONS   -->
    <!-- ======================== -->
    <Style Selector="Button.window-control">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.window-control:pointerover">
        <Setter Property="Background" Value="#2BFFFFFF" />
    </Style>
    <Style Selector="Button.window-control.close:pointerover">
        <Setter Property="Background" Value="{StaticResource WindowCloseButtonHoverBackground}" />
    </Style>

    <!-- ======================== -->
    <!--  BUTTON DROP-SHADOW      -->
    <!-- ======================== -->
    <Style Selector="Button.circular-transport, Button.circular-menu, ToggleButton.circular-toggle, ToggleButton.circular-menu">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="5" OffsetY="1" Color="#99000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================== -->
    <!--  FLAT OPTIONS BUTTONS    -->
    <!-- ======================== -->
    <Style Selector="Button.flat">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.flat:pointerover">
        <Setter Property="Background" Value="{StaticResource ButtonHoverBackground}" />
    </Style>
    <Style Selector="Button.flat:pressed">
        <Setter Property="Background" Value="{StaticResource ButtonActiveBackground}" />
    </Style>

    <!-- ======================== -->
    <!--  LISTBOX & COMBOBOX ITEMS-->
    <!-- ======================== -->
    <Style Selector="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource OsdForeground}" />
