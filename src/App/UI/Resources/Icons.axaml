<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>

    <!-- =============================================================== -->
    <!--  CINE ICON SET  —  24×24 unified viewBox                        -->
    <!--  All paths use clean integer coordinates for crisp rendering    -->
    <!--  at any DPI scale. Matches Material Design icon spec.           -->
    <!--  Rendered at 16×16 .. 48×48 via Stretch="Uniform".             -->
    <!-- =============================================================== -->

    <!-- Play — right-pointing triangle, centered -->
    <Geometry x:Key="PlayIcon">M 8 5 L 8 19 L 19 12 Z</Geometry>

    <!-- Pause — two vertical bars -->
    <Geometry x:Key="PauseIcon">M 7 4 H 10 V 20 H 7 Z M 14 4 H 17 V 20 H 14 Z</Geometry>

    <!-- Skip Backward / Previous — triangle + thin bar -->
    <Geometry x:Key="SkipBackwardIcon">M 12.5 6 L 7 12 L 12.5 18 L 12.5 14 L 17 12 L 12.5 10 Z M 4 5 L 4 19 L 3 19 L 3 5 Z</Geometry>

    <!-- Skip Forward / Next — triangle + thin bar -->
    <Geometry x:Key="SkipForwardIcon">M 11.5 6 L 17 12 L 11.5 18 L 11.5 14 L 7 12 L 11.5 10 Z M 21 5 L 21 19 L 20 19 L 20 5 Z</Geometry>

    <!-- Rewind (generic) -->
    <Geometry x:Key="RewindIcon">M 12 5 L 5 12 L 12 19 V 14 L 18 12 L 12 10 V 5 Z M 4 5 V 19 H 3 V 5 Z</Geometry>

    <!-- Fast Forward (generic) -->
    <Geometry x:Key="FastForwardIcon">M 12 5 L 19 12 L 12 19 V 14 L 6 12 L 12 10 V 5 Z M 21 5 V 19 H 20 V 5 Z</Geometry>

    <!-- Volume Max — speaker body + two arcs -->
    <Geometry x:Key="VolumeMaxIcon">M 3 9 H 5 L 9 5 V 19 L 5 15 H 3 Z M 13.5 8.5 C 14.75 10 14.75 14 13.5 15.5 M 17 6 C 19 9 19 15 17 18</Geometry>

    <!-- Volume Mute — speaker body + cross -->
    <Geometry x:Key="VolumeMuteIcon">M 3 9 H 5 L 9 5 V 19 L 5 15 H 3 Z M 17 9 L 21 13 M 17 13 L 21 9</Geometry>

    <!-- Volume Low — speaker body + one arc -->
    <Geometry x:Key="VolumeLowIcon">M 3 9 H 5 L 9 5 V 19 L 5 15 H 3 Z M 13.5 8.5 C 14.75 10 14.75 14 13.5 15.5</Geometry>

    <!-- Subtitles — text block with CC marks -->
    <Geometry x:Key="SubtitlesIcon">M 2 4 H 22 V 20 H 2 Z M 6 10 H 12 V 12 H 6 Z M 14 10 H 18 V 12 H 14 Z M 6 14 H 8 V 16 H 6 Z M 10 14 H 14 V 16 H 10 Z M 16 14 H 18 V 16 H 16 Z</Geometry>

    <!-- Subtitles Off — block with diagonal cross -->
    <Geometry x:Key="SubtitlesOffIcon">M 2 4 H 22 V 20 H 2 Z M 6 10 H 12 V 11 H 6 Z M 14 10 H 18 V 11 H 14 Z M 7 16 L 17 6 M 17 16 L 7 6</Geometry>

    <!-- Fullscreen Enter — corner arrows outward -->
    <Geometry x:Key="FullscreenEnterIcon">M 8 3 V 8 H 3 M 8 3 L 3 8 M 16 21 V 16 H 21 M 16 21 L 21 16</Geometry>

    <!-- Fullscreen Exit — corner arrows inward -->
    <Geometry x:Key="FullscreenExitIcon">M 3 16 H 8 V 21 M 3 16 L 8 21 M 21 8 H 16 V 3 M 21 8 L 16 3</Geometry>

    <!-- Options / Gear — centered cog -->
    <Geometry x:Key="OptionsIcon">M 12 15 A 3 3 0 1 0 12 9 A 3 3 0 1 0 12 15 Z M 12 1 L 12 4 M 12 20 L 12 23 M 1 12 L 4 12 M 20 12 L 23 12 M 4.2 4.2 L 6.4 6.4 M 17.6 17.6 L 19.8 19.8 M 4.2 19.8 L 6.4 17.6 M 17.6 6.4 L 19.8 4.2</Geometry>

    <!-- Audio (bars) — equalizer-style bars -->
    <Geometry x:Key="AudioIcon">M 5 5 H 7 V 19 H 5 Z M 9 8 H 11 V 19 H 9 Z M 13 3 H 15 V 19 H 13 Z M 17 10 H 19 V 19 H 17 Z</Geometry>

    <!-- Audio Off — bars + cross -->
    <Geometry x:Key="AudioOffIcon">M 7 17 L 19 5 M 19 17 L 7 5 M 4 8 H 6 V 19 H 4 Z M 8 6 H 10 V 19 H 8 Z M 12 10 H 14 V 19 H 12 Z M 16 5 H 18 V 19 H 16 Z</Geometry>

    <!-- Video — rectangle with play triangle -->
    <Geometry x:Key="VideoIcon">M 3 6 H 17 V 18 H 3 Z M 17 8 L 21 12 L 17 16 Z</Geometry>

    <!-- Playlist — bullet list -->
    <Geometry x:Key="PlaylistIcon">M 2 5 H 3 V 6 H 2 Z M 6 5 H 22 V 6 H 6 Z M 2 11 H 3 V 12 H 2 Z M 6 11 H 22 V 12 H 6 Z M 2 17 H 3 V 18 H 2 Z M 6 17 H 22 V 18 H 6 Z</Geometry>

    <!-- Playlist Shuffle — crossed arrows -->
    <Geometry x:Key="PlaylistShuffleIcon">M 14.5 7 L 16.5 5 L 14.5 3 M 14.5 21 L 16.5 19 L 14.5 17 M 16.5 5 H 11 C 10 5 9 6 8.5 7 L 5.5 17 C 5 18 4 19 3 19 H 1 M 16.5 19 H 11 C 10 19 9 18 8.5 17 L 5.5 7 C 5 6 4 5 3 5 H 1</Geometry>

    <!-- Loop Playlist (Repeat both) — loop arrows -->
    <Geometry x:Key="LoopPlaylistIcon">M 4 7 C 2.5 7 1.5 8 1.5 9.5 V 14.5 C 1.5 16 2.5 17 4 17 H 6 V 15.5 H 4 C 3.4 15.5 3 15.1 3 14.5 V 9.5 C 3 8.9 3.4 8.5 4 8.5 H 20 C 20.6 8.5 21 8.9 21 9.5 V 14.5 C 21 15.1 20.6 15.5 20 15.5 H 18 V 17 H 20 C 21.5 17 22.5 16 22.5 14.5 V 9.5 C 22.5 8 21.5 7 20 7 Z M 9 11 L 7 13 H 8.5 V 14.5 H 9.5 V 13 H 11 Z</Geometry>

    <!-- Loop File (Repeat one) — loop with number 1 -->
    <Geometry x:Key="LoopFileIcon">M 12 2 C 9.5 2 7.5 4 7.5 6.5 L 7.5 10.5 L 5 7.5 L 5 11.5 L 7.5 9 L 7.5 13 M 7.5 13 C 5 13 3 15 3 17.5 V 20 C 3 22.25 5 24 7.5 24 H 16.5 C 19 24 21 22.25 21 20 V 17.5 C 21 15 19 13 16.5 13 H 12 Z M 12 16 H 16.5 C 17.3 16 18 16.7 18 17.5 V 20 C 18 20.8 17.3 21.5 16.5 21.5 H 7.5 C 6.7 21.5 6 20.8 6 20 V 17.5 C 6 16.7 6.7 16 7.5 16 H 9 V 18 H 10.5 V 16 Z</Geometry>

    <!-- Playlist Add (plus) -->
    <Geometry x:Key="PlaylistAddIcon">M 2 6 H 3 V 7 H 2 Z M 6 6 H 22 V 7 H 6 Z M 2 12 H 3 V 13 H 2 Z M 6 12 H 14 V 13 H 6 Z M 18 8 H 20 V 10 M 18 10 H 20 V 12 H 18 Z M 22 10 H 20 V 10 M 20 8 V 6 H 18 V 8 Z</Geometry>

    <!-- Menu (3 dots horizontal) -->
    <Geometry x:Key="MenuIcon">M 3 10 A 2 2 0 1 0 3 14 A 2 2 0 1 0 3 10 Z M 11 10 A 2 2 0 1 0 11 14 A 2 2 0 1 0 11 10 Z M 19 10 A 2 2 0 1 0 19 14 A 2 2 0 1 0 19 10 Z</Geometry>

    <!-- Close / X -->
    <Geometry x:Key="CloseIcon">M 6.4 6.4 L 17.6 17.6 M 17.6 6.4 L 6.4 17.6</Geometry>

    <!-- Minimize — horizontal line -->
    <Geometry x:Key="MinimizeIcon">M 4 12 H 20 V 13 H 4 Z</Geometry>

    <!-- Maximize — rectangle -->
    <Geometry x:Key="MaximizeIcon">M 4 4 H 20 V 20 H 4 Z M 5.5 5.5 V 18.5 H 18.5 V 5.5 Z</Geometry>

    <!-- Max Restore — two overlapping rectangles -->
    <Geometry x:Key="MaxRestoreIcon">M 6 4 H 20 V 18 H 18 V 20 H 4 V 6 H 6 Z M 8 8 V 16 H 16 V 8 Z</Geometry>

    <!-- PIP (Picture-in-Picture) -->
    <Geometry x:Key="PipIcon">M 3 5 H 21 V 19 H 3 Z M 8 9 H 16 V 15 H 8 Z</Geometry>

    <!-- Screenshot -->
    <Geometry x:Key="ScreenshotIcon">M 4 4 H 20 V 20 H 4 Z M 8 8 A 4 4 0 1 0 8 16 A 4 4 0 1 0 8 8 Z M 15 8 V 10 H 17 V 8 Z M 17 10 V 12 H 19 V 10 Z</Geometry>

    <!-- Spinner / Loading -->
    <Geometry x:Key="SpinnerIcon">M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 1 0 12 2 Z M 12 4 A 8 8 0 1 1 12 20 A 8 8 0 1 1 12 4 Z</Geometry>

    </Styles.Resources>
</Styles>
