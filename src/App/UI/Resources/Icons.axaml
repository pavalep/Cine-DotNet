<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>

    <!-- Open chevron -->
    <Geometry x:Key="OpenChevronIcon">M 1 1 L 4 4 L 7 1</Geometry>

    <!-- Play -->
    <Geometry x:Key="PlayIcon">M 8 5 V 19 L 19 12 Z</Geometry>

    <!-- Pause (canvas exact) -->
    <Geometry x:Key="PauseIcon">M 6 3.5 V 12.5 C 6 13.33 5.33 14 4.5 14 C 3.67 14 3 13.33 3 12.5 V 3.5 C 3 2.67 3.67 2 4.5 2 C 5.33 2 6 2.67 6 3.5 Z M 13 3.5 V 12.5 C 13 13.33 12.33 14 11.5 14 C 10.67 14 10 13.33 10 12.5 V 3.5 C 10 2.67 10.67 2 11.5 2 C 12.33 2 13 2.67 13 3.5 Z</Geometry>

    <!-- Skip Backward / Previous (canvas exact) -->
    <Geometry x:Key="SkipBackwardIcon">M 13.73 3.03 C 13.93 3.16 14.06 3.41 14.06 3.68 V 12.32 C 14.06 12.9 13.51 13.26 13.08 12.96 L 5.29 8.64 C 4.87 8.35 4.87 7.65 5.29 7.36 L 13.08 3.04 C 13.28 2.9 13.53 2.9 13.73 3.03 Z M 3 2 H 5 V 14 H 3 Z</Geometry>

    <!-- Skip Forward / Next (canvas exact) -->
    <Geometry x:Key="SkipForwardIcon">M 2.27 3.03 C 2.07 3.16 1.94 3.41 1.94 3.68 V 12.32 C 1.94 12.9 2.49 13.26 2.92 12.96 L 10.71 8.64 C 11.13 8.35 11.13 7.65 10.71 7.36 L 2.92 3.04 C 2.72 2.9 2.47 2.9 2.27 3.03 Z M 14 2 C 13.45 2 13 2.45 13 3 V 13 C 13 13.55 13.45 14 14 14 C 14.55 14 15 13.55 15 13 V 3 C 15 2.45 14.55 2 14 2 Z</Geometry>

    <!-- Volume Speaker (fill) + Volume Arcs (stroke) -->
    <Geometry x:Key="VolumeSpeakerIcon">M 6 3 V 13 L 3 10 H 1 V 6 H 3 Z</Geometry>
    <Geometry x:Key="VolumeArcsIcon">M 10.19 4.96 C 11.27 6.84 11.27 9.16 10.19 11.04 M 13.58 3 C 15.37 6.09 15.37 9.91 13.58 13</Geometry>

    <!-- Volume Mute — speaker + cross -->
    <Geometry x:Key="VolumeMuteIcon">M 6 3 V 13 L 3 10 H 1 V 6 H 3 Z M 11 6 L 15 10 M 11 10 L 15 6</Geometry>

    <!-- Volume Mute Cross (for toggle toggle between arcs and cross) -->
    <Geometry x:Key="VolumeMuteCrossIcon">M 11 6 L 15 10 M 11 10 L 15 6</Geometry>

    <!-- Subtitles (canvas exact) -->
    <Geometry x:Key="SubtitlesIcon">M 3 1 C 1.36 1 0 2.36 0 4 V 12 C 0 13.64 1.36 15 3 15 H 13 C 14.64 15 16 13.64 16 12 V 4 C 16 2.36 14.64 1 13 1 Z M 3 9 H 7 V 10 H 3 Z M 8 9 H 11 V 10 H 8 Z M 12 9 H 13 V 10 H 12 Z M 3 11 H 5 V 12 H 3 Z M 6 11 H 9 V 12 H 6 Z M 10 11 H 13 V 12 H 10 Z</Geometry>

    <!-- Subtitles Off — box + cross -->
    <Geometry x:Key="SubtitlesOffIcon">M 3 1 C 1.36 1 0 2.36 0 4 V 12 C 0 13.64 1.36 15 3 15 H 13 C 14.64 15 16 13.64 16 12 V 4 C 16 2.36 14.64 1 13 1 Z M 4 4 L 12 12 M 12 4 L 4 12</Geometry>

    <!-- Audio Bars (canvas exact, viewBox -1 -2 18 20) -->
    <Geometry x:Key="AudioIcon">M 8 -1 C 7.45 -1 7 -0.52 7 0.07 V 13.93 C 7 14.52 7.45 15 8 15 C 8.55 15 9 14.52 9 13.93 V 0.07 C 9 -0.52 8.55 -1 8 -1 Z M 5 2 C 4.45 2 4 2.45 4 3 V 11 C 4 11.55 4.45 12 5 12 C 5.55 12 6 11.55 6 11 V 3 C 6 2.45 5.55 2 5 2 Z M 11 2 C 10.45 2 10 2.45 10 3 V 11 C 10 11.55 10.45 12 11 12 C 11.55 12 12 11.55 12 11 V 3 C 12 2.45 11.55 2 11 2 Z M 2 5 C 1.45 5 1 5.45 1 6 V 8 C 1 8.55 1.45 9 2 9 C 2.55 9 3 8.55 3 8 V 6 C 3 5.45 2.55 5 2 5 Z M 14 5 C 13.45 5 13 5.45 13 6 V 8 C 13 8.55 13.45 9 14 9 C 14.55 9 15 8.55 15 8 V 6 C 15 5.45 14.55 5 14 5 Z</Geometry>

    <!-- Audio Off — bars + cross -->
    <Geometry x:Key="AudioOffIcon">M 8 -1 C 7.45 -1 7 -0.52 7 0.07 V 13.93 C 7 14.52 7.45 15 8 15 C 8.55 15 9 14.52 9 13.93 V 0.07 C 9 -0.52 8.55 -1 8 -1 Z M 5 2 C 4.45 2 4 2.45 4 3 V 11 C 4 11.55 4.45 12 5 12 C 5.55 12 6 11.55 6 11 V 3 C 6 2.45 5.55 2 5 2 Z M 11 2 C 10.45 2 10 2.45 10 3 V 11 C 10 11.55 10.45 12 11 12 C 11.55 12 12 11.55 12 11 V 3 C 12 2.45 11.55 2 11 2 Z M 2 5 C 1.45 5 1 5.45 1 6 V 8 C 1 8.55 1.45 9 2 9 C 2.55 9 3 8.55 3 8 V 6 C 3 5.45 2.55 5 2 5 Z M 14 5 C 13.45 5 13 5.45 13 6 V 8 C 13 8.55 13.45 9 14 9 C 14.55 9 15 8.55 15 8 V 6 C 15 5.45 14.55 5 14 5 Z M 4 4 L 12 12 M 12 4 L 4 12</Geometry>

    <!-- Fullscreen Enter (canvas exact, stroke) -->
    <Geometry x:Key="FullscreenEnterIcon">M 10 1 H 15 V 6 M 10 1 L 15 6 M 1 10 V 15 H 6 M 1 10 L 6 15</Geometry>

    <!-- Fullscreen Exit -->
    <Geometry x:Key="FullscreenExitIcon">M 1 6 H 6 V 1 M 1 6 L 6 1 M 15 10 H 10 V 15 M 15 10 L 10 15</Geometry>

    <!-- Options / Gear (canvas exact, stroke) -->
    <Geometry x:Key="OptionsIcon">M 9 7.5 A 2.5 2.5 0 1 0 9 12.5 A 2.5 2.5 0 1 0 9 7.5 Z M 9 2 V 4 M 9 14 V 16 M 2 9 H 4 M 14 9 H 16 M 4.05 4.05 L 5.46 5.46 M 12.54 12.54 L 13.95 13.95 M 4.05 13.95 L 5.46 12.54 M 12.54 5.46 L 13.95 4.05</Geometry>

    <!-- Shuffle (canvas exact, stroke) -->
    <Geometry x:Key="PlaylistShuffleIcon">M 13 6 L 15 4 L 13 2 M 13 14 L 15 12 L 13 10 M 15 4 H 9.38 C 8.53 4 7.76 4.48 7.38 5.23 L 4.62 10.77 C 4.24 11.52 3.47 12 2.62 12 H 0 M 15 12 H 9.38 C 8.53 12 7.76 11.52 7.38 10.77 L 4.62 5.23 C 4.24 4.48 3.47 4 2.62 4 H 0</Geometry>

    <!-- Loop Playlist (canvas exact, fill) -->
    <Geometry x:Key="LoopPlaylistIcon">M 3 4 C 1.34 4 0 5.34 0 7 V 11 C 0 12.66 1.34 14 3 14 H 5 V 12 H 3 C 2.45 12 2 11.55 2 11 V 7 C 2 6.45 2.45 6 3 6 H 11 C 11.55 6 12 6.45 12 7 V 11 C 12 11.55 11.55 12 11 12 H 10 V 14 H 11 C 12.66 14 14 12.66 14 11 V 7 C 14 5.34 12.66 4 11 4 Z M 7 8 L 5 10 H 6.5 V 12 H 7.5 V 10 H 9 Z</Geometry>

    <!-- Loop File (canvas exact, fill) -->
    <Geometry x:Key="LoopFileIcon">M 8 1 C 6.34 1 5 2.34 5 4 V 6.5 L 3 4.5 V 7.5 L 5 5.5 V 8 C 3.34 8 2 9.34 2 11 V 13 C 2 14.66 3.34 16 5 16 H 11 C 12.66 16 14 14.66 14 13 V 11 C 14 9.34 12.66 8 11 8 H 8 Z M 8 10 H 11 C 11.55 10 12 10.45 12 11 V 13 C 12 13.55 11.55 14 11 14 H 5 C 4.45 14 4 13.55 4 13 V 11 C 4 10.45 4.45 10 5 10 H 6.5 V 12 H 7.5 V 10 Z M 9 9 L 11 11 H 9.5 V 12 H 8.5 V 11 H 7 Z</Geometry>

    <!-- Playlist (canvas: 3 filled circles + 3 stroke lines) -->
    <Geometry x:Key="PlaylistIcon">M 1.4 3 A 0.6 0.6 0 1 0 2.6 3 A 0.6 0.6 0 1 0 1.4 3 Z M 1.4 8 A 0.6 0.6 0 1 0 2.6 8 A 0.6 0.6 0 1 0 1.4 8 Z M 1.4 13 A 0.6 0.6 0 1 0 2.6 13 A 0.6 0.6 0 1 0 1.4 13 Z M 5 2.5 H 14 V 3.5 H 5 Z M 5 7.5 H 14 V 8.5 H 5 Z M 5 12.5 H 14 V 13.5 H 5 Z</Geometry>

    <!-- Menu 3-dots (canvas exact) -->
    <Geometry x:Key="MenuIcon">M 1 3 A 2 2 0 1 0 5 3 A 2 2 0 1 0 1 3 Z M 9 3 A 2 2 0 1 0 13 3 A 2 2 0 1 0 9 3 Z M 17 3 A 2 2 0 1 0 21 3 A 2 2 0 1 0 17 3 Z</Geometry>

    <!-- Close (canvas exact, stroke) -->
    <Geometry x:Key="CloseIcon">M 1 1 L 13 13 M 13 1 L 1 13</Geometry>

    <!-- Minimize (canvas exact) -->
    <Geometry x:Key="MinimizeIcon">M 0 0 H 20 V 2 H 0 Z</Geometry>

    <!-- Maximize (canvas exact, stroke) -->
    <Geometry x:Key="MaximizeIcon">M 0.75 0.75 H 15.25 V 15.25 H 0.75 Z</Geometry>

    <!-- Max Restore (two overlapping rects) -->
    <Geometry x:Key="MaxRestoreIcon">M 2 2 H 15 V 15 H 2 Z M 4 4 V 13 H 13 V 4 Z</Geometry>

    <!-- Video (rectangle + play triangle) -->
    <Geometry x:Key="VideoIcon">M 3 6 H 17 V 18 H 3 Z M 17 8 L 21 12 L 17 16 Z</Geometry>

    <!-- PIP (picture-in-picture) -->
    <Geometry x:Key="PipIcon">M 3 5 H 21 V 19 H 3 Z M 8 9 H 16 V 15 H 8 Z</Geometry>

    </Styles.Resources>
</Styles>
