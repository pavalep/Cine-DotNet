<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>

    <!-- ============================================================
         Material Design 3 Spacing Tokens
         Reference: https://m3.material.io/layout/applying-density
         4dp and 8dp stepping grid.

         Usage in XAML:
             Margin="{StaticResource space-2}"
             Margin="{StaticResource space-h-4}"

         Padding vs Margin: both use same spacing tokens.
         Asymmetric: suffix -h (horizontal) or -v (vertical).
         ============================================================ -->

    <!-- ── Uniform spacing ─────────────────────────────────────── -->

    <!-- 0dp -->
    <Thickness x:Key="space-0">0</Thickness>

    <!-- 4dp — fine spacing, icon padding -->
    <Thickness x:Key="space-1">4</Thickness>

    <!-- 8dp — button gaps, element spacing -->
    <Thickness x:Key="space-2">8</Thickness>

    <!-- 12dp — group spacing, section padding -->
    <Thickness x:Key="space-3">12</Thickness>

    <!-- 16dp — card padding, dialog padding -->
    <Thickness x:Key="space-4">16</Thickness>

    <!-- 24dp — page margins, large gaps -->
    <Thickness x:Key="space-5">24</Thickness>

    <!-- 32dp — section separation -->
    <Thickness x:Key="space-6">32</Thickness>

    <!-- 48dp — major page sections -->
    <Thickness x:Key="space-7">48</Thickness>

    <!-- 64dp — extreme spacing -->
    <Thickness x:Key="space-8">64</Thickness>

    <!-- ── Horizontal-only spacing ──────────────────────────────── -->

    <Thickness x:Key="space-h-0">0,0,0,0</Thickness>
    <Thickness x:Key="space-h-1">4,0,4,0</Thickness>
    <Thickness x:Key="space-h-2">8,0,8,0</Thickness>
    <Thickness x:Key="space-h-3">12,0,12,0</Thickness>
    <Thickness x:Key="space-h-4">16,0,16,0</Thickness>
    <Thickness x:Key="space-h-5">24,0,24,0</Thickness>

    <!-- ── Vertical-only spacing ────────────────────────────────── -->

    <Thickness x:Key="space-v-0">0,0,0,0</Thickness>
    <Thickness x:Key="space-v-0_5">0,2,0,2</Thickness>
    <Thickness x:Key="space-v-1">0,4,0,4</Thickness>
    <Thickness x:Key="space-v-2">0,8,0,8</Thickness>
    <Thickness x:Key="space-v-3">0,12,0,12</Thickness>
    <Thickness x:Key="space-v-4">0,16,0,16</Thickness>
    <Thickness x:Key="space-v-5">0,24,0,24</Thickness>

    <!-- ── Asymmetric (left, top, right, bottom) ────────────────── -->

    <!-- left 12, right 12, top 0, bottom 0 -->
    <Thickness x:Key="space-h-3-top-0">12,0,12,0</Thickness>

    <!-- left 0, top 0, right 0, bottom 8 -->
    <Thickness x:Key="space-bottom-2">0,0,0,8</Thickness>

    <!-- left 8, right 4 (header menu button) -->
    <Thickness x:Key="space-h-l2-r1">8,0,4,0</Thickness>

    <!-- left 10 (menu items) -->
    <Thickness x:Key="space-left-10">10,0,0,0</Thickness>

    <!-- right 4 (button spacing) -->
    <Thickness x:Key="space-right-1">0,0,4,0</Thickness>

    <!-- left 12, top 3, right 12, bottom 3 (flyout items) -->
    <Thickness x:Key="space-v-0_75">0,3,0,3</Thickness>

    <!-- 0,6,0,6 (separators, tight vertical) -->
    <Thickness x:Key="space-v-1_5">0,6,0,6</Thickness>

    <!-- 0,8,0,0 (top-only 8) -->
    <Thickness x:Key="space-top-2">0,8,0,0</Thickness>

    <!-- ── StackPanel Spacing Tokens ────────────────────────────── -->
    <!-- Use with <StackPanel Spacing="{StaticResource space-spacing-1}" /> -->

    <x:Double x:Key="space-spacing-0">0</x:Double>
    <x:Double x:Key="space-spacing-0_5">2</x:Double>
    <x:Double x:Key="space-spacing-1">4</x:Double>
    <x:Double x:Key="space-spacing-2">8</x:Double>
    <x:Double x:Key="space-spacing-3">12</x:Double>
    <x:Double x:Key="space-spacing-4">16</x:Double>
    <x:Double x:Key="space-spacing-5">24</x:Double>

    <!-- ── Icon Size Tokens ─────────────────────────────────────── -->
    <!-- Use with <materialIcons:MaterialIcon Width="{StaticResource size-icon-sm}" /> -->

    <!-- 14px — flyout inline icons, list item leading icons -->
    <x:Double x:Key="size-icon-xs">14</x:Double>

    <!-- 16px — small UI icons, menu items, window controls -->
    <x:Double x:Key="size-icon-sm">16</x:Double>

    <!-- 20px — standard player control icons (volume, skip, menu) -->
    <x:Double x:Key="size-icon-md">20</x:Double>

    <!-- 24px — hero control icons (play/pause) -->
    <x:Double x:Key="size-icon-lg">24</x:Double>

    <!-- 32px — large display icons (empty states, big play overlay) -->
    <x:Double x:Key="size-icon-xl">32</x:Double>

    </Styles.Resources>
</Styles>
