<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>

    <!-- ============================================================
         Material Design 3 Type Scale — Font Resources
         Reference: https://m3.material.io/styles/typography
         ============================================================ -->

    <!-- Font Family Tokens
         Material Design recommends "Inter" for UI and "JetBrains Mono"
         for monospace/numeric. To use custom embedded fonts:
            1. Add .ttf/.otf files to UI/Resources/Fonts/
            2. Set build action to "AvaloniaResource"
            3. Update paths to "avares://App/UI/Resources/Fonts#FontName"

         Until then, values below are placeholders — fonts inherit from
         Window default (defined in App.axaml). -->
    <FontFamily x:Key="font-family-default">Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="font-family-mono">Consolas, monospace</FontFamily>
    <FontFamily x:Key="font-family-numeric">Consolas, monospace</FontFamily>

    </Styles.Resources>

    <!-- ============================================================
         Material Design 3 Type Ramp — Styles
         These are the canonical type sizes for the entire app.
         All TextBlock elements should use these classes.
         ============================================================ -->

    <!-- 12sp / Regular — helper text, captions, time labels -->
    <Style Selector="TextBlock.md3-caption">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontFamily" Value="{StaticResource font-family-default}"/>
    </Style>

    <!-- 14sp / Regular — secondary body text, metadata -->
    <Style Selector="TextBlock.md3-body2">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontFamily" Value="{StaticResource font-family-default}"/>
    </Style>

    <!-- 16sp / Regular — primary body text -->
    <Style Selector="TextBlock.md3-body1">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontFamily" Value="{StaticResource font-family-default}"/>
    </Style>

    <!-- 14sp / SemiBold — section headers, labels -->
    <Style Selector="TextBlock.md3-subtitle1">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{StaticResource font-family-default}"/>
    </Style>

    <!-- 20sp / Medium — dialog titles, section headings -->
    <Style Selector="TextBlock.md3-headline6">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontFamily" Value="{StaticResource font-family-default}"/>
    </Style>

    <!-- 24sp / Regular — page titles -->
    <Style Selector="TextBlock.md3-headline4">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontFamily" Value="{StaticResource font-family-default}"/>
    </Style>

    <!-- 34sp / Regular — hero/display text (start page title) -->
    <Style Selector="TextBlock.md3-headline2">
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontFamily" Value="{StaticResource font-family-default}"/>
    </Style>

</Styles>
