<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DesignWidth="260" d:DesignHeight="380"
        x:Class="Cine.Avalonia.Dialogs.SubtitleSettingsDialog"
        Title="Subtitle Settings"
        Width="260" Height="380"
        MinWidth="220" MinHeight="280"
        MaxHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <Grid RowDefinitions="Auto,*,Auto" Margin="0">
        <!-- Header -->
        <Grid Grid.Row="0" Classes="dialog-header" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Subtitle Settings" Classes="dialog-title" />
            <Button Grid.Column="1" Classes="dialog-close"
                    Click="OnCloseClick" ToolTip.Tip="Close" AutomationProperties.Name="Close dialog">
                <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource size-dialog-close-icon}" Height="{StaticResource size-dialog-close-icon}"
                    Foreground="{StaticResource OsdForeground}" />
            </Button>
        </Grid>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" Margin="0,8,0,0">
            <StackPanel x:Name="BodyPanel" Spacing="0" />
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Margin="{StaticResource space-3}" Spacing="{StaticResource space-spacing-1}">
            <Button x:Name="ResetButton"
                    Content="Reset Defaults"
                    Classes="ghost"
                    HorizontalAlignment="Stretch"
                    Click="OnResetClick"
                    AutomationProperties.Name="Reset subtitle settings to defaults" />
            <Button x:Name="CloseButton"
                    Content="Done"
                    Classes="primary"
                    HorizontalAlignment="Stretch"
                    Click="OnCloseClick"
                    AutomationProperties.Name="Close subtitle settings" />
        </StackPanel>
    </Grid>
</Window>
