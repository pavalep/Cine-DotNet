<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Cine.Avalonia.PreferencesDialog"
        Title="Preferences"
        Width="500" Height="400"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="#FF0C0C0E"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Height="48"
                Background="#FF1E1E1E"
                Padding="12,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Preferences" FontSize="16" FontWeight="SemiBold"
                           Foreground="White" VerticalAlignment="Center" />
                <Button Grid.Column="1" Click="OnCloseClick" Background="Transparent"
                        BorderThickness="0" Width="32" Height="32"
                        ToolTip.Tip="Close">
                    <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12"
                        Foreground="White" />
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="20">
            <StackPanel Spacing="16">
                <TextBlock Text="Preferences will be available in a future update."
                           Foreground="#999999" FontSize="14"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
