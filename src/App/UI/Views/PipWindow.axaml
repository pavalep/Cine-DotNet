<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cc="using:Cine.Avalonia.Controls"
        x:Class="Cine.Avalonia.Views.PipWindow"
        Opened="OnOpened"
        Title="Cine — PIP"
        Width="400" Height="300"
        MinWidth="200" MinHeight="150"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="#0C0C0E"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- PIP Header -->
        <Grid Grid.Row="0" Height="32" Background="#CC000000" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="PIP" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource OsdForeground}"
                       VerticalAlignment="Center" Margin="8,0,0,0" />
            <Button Grid.Column="1" Classes="window-control close"
                    Width="32" Height="32"
                    Click="OnCloseClick">
                <Path Data="{StaticResource CloseIcon}"
                      Width="10" Height="10" Stretch="Uniform"
                      Stroke="{StaticResource OsdForeground}"
                      StrokeThickness="1.5"
                      StrokeLineCap="Round" />
            </Button>
        </Grid>

        <!-- Video Surface -->
        <cc:D3D11VideoHost x:Name="PipVideoHost"
                           Grid.Row="1"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           IsVideoSurfaceVisible="False" />

        <!-- Controls Overlay (visible on hover) -->
        <Border Grid.Row="2" Height="36" Background="#CC000000" IsHitTestVisible="True">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <Button Classes="circular-transport" Width="28" Height="28" Click="OnPipPlayPause">
                    <Path x:Name="PipPlayPauseIcon"
                          Data="{StaticResource PauseIcon}"
                          Width="12" Height="12" Stretch="Uniform"
                          Fill="{StaticResource OsdForeground}" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
