<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Cine.Avalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
        x:Class="Cine.Avalonia.Views.PlaylistDialog"
        x:DataType="vm:MainViewModel"
        Title="Playlist"
        Width="600" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}"
        ExtendClientAreaToDecorationsHint="True">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0" Height="50" ColumnDefinitions="Auto,*,Auto" Background="{StaticResource HeaderBackground}">
            <Button Grid.Column="0" 
                    Classes="flat" 
                    Margin="8,0"
                    Click="OnAddFilesClick"
                    ToolTip.Tip="Add Files">
                <Path Data="{StaticResource PlaylistAddIcon}" Width="16" Height="16" Fill="{StaticResource OsdForeground}" Stretch="Uniform" />
            </Button>
            <TextBlock Grid.Column="1" Text="Playlist" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Button Grid.Column="2" 
                    Classes="flat" 
                    Margin="0,0,8,0"
                    Click="OnCloseClick"
                    ToolTip.Tip="Close">
                <Path Data="{StaticResource CloseIcon}" Width="14" Height="14" Fill="{StaticResource OsdForeground}" Stretch="Uniform" />
            </Button>
        </Grid>

        <!-- Main Content -->
        <Panel Grid.Row="1">
            <ScrollViewer>
                <ListBox ItemsSource="{Binding PlaylistItems}" 
                         Background="Transparent"
                         SelectionMode="Single"
                         Margin="8"
                         DoubleTapped="OnListBoxDoubleTapped"
                         KeyDown="OnListBoxKeyDown">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover">
                            <Setter Property="Background" Value="#1FFFFFFF" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="#330078D4" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlaylistItemViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <!-- Playing Indicator -->
                                <Border Grid.Column="0" 
                                        Width="8" Height="8" 
                                        CornerRadius="4"
                                        Background="{StaticResource AccentBrush}"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsPlaying}" />
                                
                                <!-- File Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Directory}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Play Button -->
                                <Button Grid.Column="2" 
                                        Classes="circular-transport" 
                                        Command="{Binding Play}"
                                        Width="32" Height="32"
                                        Margin="8,0,0,0">
                                    <Path Data="{StaticResource PlayIcon}" Width="12" Height="12" Fill="{StaticResource OsdForeground}" Stretch="Uniform" />
                                </Button>

                                <!-- Remove Button -->
                                <Button Grid.Column="3" 
                                        Classes="circular-transport" 
                                        Command="{Binding Remove}"
                                        Width="32" Height="32"
                                        ToolTip.Tip="Remove">
                                    <Path Data="{StaticResource CloseIcon}" Width="10" Height="10" Fill="{StaticResource OsdForeground}" Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <!-- Drop Indicator -->
            <Border x:Name="DropIndicatorRevealer" 
                    IsVisible="False" 
                    Opacity="0"
                    Background="#80000000" 
                    CornerRadius="8" 
                    Margin="16">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <Path Data="{StaticResource PlaylistAddIcon}" Width="64" Height="64" Fill="{StaticResource OsdForeground}" Stretch="Uniform" />
                    <TextBlock Text="Add to Playlist" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Panel>
    </Grid>
</Window>