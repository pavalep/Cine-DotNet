<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cine.Avalonia.ViewModels"
        xmlns:components="using:Cine.Avalonia.Components"
        xmlns:conv="using:Cine.Avalonia.Converters"
        xmlns:ctrl="using:Cine.Avalonia.Controls"
        xmlns:local="using:Cine.Avalonia.Controls"
        x:Class="Cine.Avalonia.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Cine"
        Width="800" Height="600"
        MinWidth="332" MinHeight="187"
        Background="#FF0C0C0E"
        TransparencyLevelHint="None"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        DragDrop.AllowDrop="True">

    <Window.Styles>
        <!-- Ensure no-focus visuals on window chrome buttons -->
        <Style Selector="Window > Grid > StackPanel > Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <conv:TimeSpanToStringConverter x:Key="TimeSpanToString" />
        <conv:PercentConverter x:Key="PercentConverter" />
        <conv:ChapterMarginConverter x:Key="ChapterMarginConverter" />
    </Window.Resources>

    <!-- Main Overlay Container -->
    <Grid x:Name="MainOverlay" Background="Black"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================== -->
        <!--  VIDEO AREA (full grid)  -->
        <!-- ======================== -->
        <Grid Grid.Row="0" Background="Black"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <!-- Video Host (Native HWND) -->
            <ctrl:D3D11VideoHost x:Name="VideoHost"
                                 IsVideoSurfaceVisible="False"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch" />

            <!-- Start Page / Welcome Screen -->
            <local:StartPage x:Name="StartPage" ZIndex="10" />

            <!-- Loading Spinner -->
            <Border x:Name="LoadingSpinner"
                    Classes="loading-spinner"
                    Width="48" Height="48"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="False"
                    CornerRadius="24"
                    BorderThickness="3"
                    BorderBrush="{StaticResource OsdForeground}"
                    Background="Transparent"
                    Opacity="0.7" />

            <!-- Pause Indicator -->
            <Border x:Name="PauseIndicator"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Opacity="0" IsVisible="False"
                    CornerRadius="8" Padding="16"
                    Background="#80000000">
                <Path Data="{StaticResource PauseIcon}"
                      Width="48" Height="48" Stretch="Uniform"
                      Fill="White" />
            </Border>

            <!-- Video Info Overlay (bottom-left) -->
            <Border Classes="video-position-overlay">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="time-elapsed"
                               Text="{Binding PositionText, Mode=OneWay}" />
                    <TextBlock Text=" / "
                               Foreground="#DDDDDD"
                               FontFamily="{StaticResource NumericFont}"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <TextBlock Classes="time-duration"
                               Text="{Binding DurationText, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Chapter Badge Overlay (top-right) -->
            <Border Classes="chapter-badge-overlay">
                <TextBlock Classes="chapter-badge"
                           Text="{Binding ChapterTitle, Mode=OneWay}" />
            </Border>

            <!-- OSD Notifications -->
            <Border x:Name="OsdNotification"
                    Classes="OsdNotificationStyle">
                <TextBlock x:Name="OsdText"
                           Foreground="{StaticResource OsdForeground}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <!-- Drop indicator overlay -->
            <Border x:Name="DropIndicatorOverlay"
                    IsVisible="False"
                    Opacity="0"
                    IsHitTestVisible="False"
                    Background="#C6000000"
                    BorderBrush="#FF4AA3FF"
                    BorderThickness="2"
                    CornerRadius="8"
                    Margin="12">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                    <Path x:Name="DropIndicatorIcon"
                          Data="{StaticResource PlayIcon}"
                          Width="56" Height="56"
                          Stretch="Uniform"
                          Fill="#FF4AA3FF" />
                    <TextBlock x:Name="DropIndicatorText"
                               Text="Play"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#FF4AA3FF"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ======================== -->
            <!--  HEADER + CONTROLS OVERLAY  -->
            <!--  Matches reference        -->
            <!--  header-and-controls      -->
            <!-- ======================== -->
            <Border x:Name="HeaderAndControlsOverlay"
                    Classes="header-and-controls"
                    Background="{StaticResource HeaderAndControlsGradient}"
                    IsHitTestVisible="False"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch" />

            <!-- ======================== -->
            <!--  HEADER BAR (top overlay) -->
            <!-- ======================== -->
            <Border x:Name="HeaderBar" Classes="header-bar"
                    Background="{StaticResource HeaderGradient}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Height="56"
                    IsHitTestVisible="True"
                    PointerPressed="OnHeaderPointerPressed">
                <Grid x:Name="HeaderGrid" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Window Title + Icon (Left) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                Margin="84,0,0,0"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <TextBlock x:Name="TitleText" Text="Cine"
                                   Foreground="{StaticResource OsdForeground}"
                                   FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Hidden BtnOpenMenu placeholder (used by code-behind) -->
                    <Button x:Name="BtnOpenMenu" IsVisible="False" Width="0" Height="0" />

                    <!-- Right side: PIP + Menu + Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="0">

                        <!-- PIP Button -->
                        <ToggleButton x:Name="BtnPip"
                                      Classes="circular-menu"
                                      ToolTip.Tip="Picture-in-Picture (not implemented)"
                                      Width="34" Height="34"
                                      Margin="0,0,4,0">
                            <Path Data="{StaticResource PipIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </ToggleButton>

                        <!-- Primary Menu Button (kebab menu) -->
                        <Button x:Name="BtnPrimaryMenu"
                                Classes="circular-menu"
                                ToolTip.Tip="Main Menu"
                                Width="34" Height="34"
                                Margin="0,0,4,0">
                            <Path Data="{StaticResource MenuIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuItem Header="New Window" Click="OnNewWindowClick" />
                                    <MenuItem Header="Preferences" Click="OnPreferencesClick" />
                                    <Separator />
                                    <MenuItem Header="Keyboard Shortcuts" Click="OnShortcutsClick" />
                                    <MenuItem Header="About Cine" Click="OnAboutClick" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Fullscreen Close Button (only visible in fullscreen) -->
                        <Button x:Name="BtnFullscreenClose"
                                Classes="circular-menu"
                                ToolTip.Tip="Close"
                                Click="OnFullscreenCloseClick"
                                IsVisible="False"
                                Width="34" Height="34"
                                Margin="0,0,4,0">
                            <Path Data="{StaticResource CloseIcon}"
                                  Width="12" Height="12" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </Button>

                        <!-- Native Window Controls (Minimize, Maximize, Close) -->
                        <StackPanel Orientation="Horizontal" Spacing="0"
                                    IsVisible="True" x:Name="WindowControlsPanel">
                            <Button x:Name="BtnMinimize" Click="OnMinimizeClick"
                                    ToolTip.Tip="Minimize">
                                <Path Data="{StaticResource MinimizeIcon}"
                                      Width="12" Height="12" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                            </Button>
                            <Button x:Name="BtnMaximizeRestore" Click="OnMaximizeRestoreClick"
                                    ToolTip.Tip="Maximize">
                                <Path x:Name="MaximizeRestoreIconPath"
                                      Data="{StaticResource MaximizeIcon}"
                                      Width="12" Height="12" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                            </Button>
                            <Button x:Name="BtnClose" Click="OnCloseClick"
                                    ToolTip.Tip="Close">
                                <Path Data="{StaticResource CloseIcon}"
                                      Width="12" Height="12" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================== -->
            <!--  CONTROLS BOX (bottom)    -->
            <!--  Matches reference        -->
            <!--  style.css .osd.controls   -->
            <!-- ======================== -->
            <Border x:Name="ControlsBox" Classes="osd controls"
                    Background="{StaticResource ControlsGradient}"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    IsVisible="False"
                    IsHitTestVisible="True">
                <Grid x:Name="ControlsGrid" Margin="24,0,24,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Progress/Seek Bar Row -->
                    <Grid Grid.Row="0"
                          x:Name="SeekArea"
                          Height="32"
                          Margin="0,0,0,4"
                          PointerMoved="OnSeekAreaPointerMoved"
                          PointerExited="OnSeekAreaPointerExited"
                          PointerWheelChanged="OnSeekAreaPointerWheelChanged"
                          PointerPressed="OnSeekAreaPointerPressed"
                          Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Seek Slider Track -->
                        <Border Background="{StaticResource ProgressTroughBackground}"
                                CornerRadius="2"
                                Height="4"
                                VerticalAlignment="Center" 
                                IsHitTestVisible="False" />

                        <!-- Seek Slider Progress Fill -->
                        <Border Background="{StaticResource ProgressSliderBackground}"
                                CornerRadius="2"
                                Height="4"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                            <Border.Clip>
                                <RectangleGeometry Rect="{Binding SeekValue, Converter={StaticResource PercentConverter}}" />
                            </Border.Clip>
                        </Border>

                        <!-- Thumb (positioned via margin) -->
                        <Border Width="16" Height="16"
                                CornerRadius="8"
                                Background="{StaticResource ProgressSliderBackground}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Margin="{Binding SeekValue, Converter={StaticResource PercentConverter}}" />

                        <!-- Chapter Markers -->
                        <ItemsControl ItemsSource="{Binding ChapterMarkers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas IsHitTestVisible="False" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Width="2" Height="12"
                                               Fill="{StaticResource OsdForeground}"
                                               Opacity="0.5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.Styles>
                                <Style Selector="ContentPresenter">
                                    <Setter Property="Canvas.Left"
                                            Value="{Binding ., Converter={StaticResource ChapterMarginConverter}}" />
                                </Style>
                            </ItemsControl.Styles>
                        </ItemsControl>

                        <!-- Chapter preview tooltip -->
                        <Border x:Name="ChapterPreviewPopover"
                                IsVisible="False"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{StaticResource PopoverBackground}"
                                BorderBrush="{StaticResource PopoverBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,4"
                                Margin="0,-34,0,0"
                                BoxShadow="0 4 12 0 #80000000">
                            <TextBlock x:Name="ChapterPreviewText"
                                       Text="Chapter"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource OsdForeground}" />
                        </Border>
                    </Grid>

                    <!-- Transport Controls Row -->
                    <Grid Grid.Row="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <Grid.Styles>
                            <Style Selector="Button, ToggleButton">
                                <Setter Property="Width" Value="34" />
                                <Setter Property="Height" Value="34" />
                                <Setter Property="Margin" Value="2" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </Grid.Styles>

                        <!-- Time Elapsed -->
                        <TextBlock Grid.Column="0"
                                   x:Name="PositionTimeLabel"
                                   Classes="time-label"
                                   Text="{Binding PositionText, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                        <!-- Previous Button -->
                        <Button Grid.Column="1" x:Name="BtnPrevious"
                                Classes="circular-transport"
                                Click="OnPrevious"
                                ToolTip.Tip="Previous Chapter (Shift+P)">
                            <Path Data="{StaticResource SkipBackwardIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </Button>

                        <!-- Rewind -->
                        <Button Grid.Column="2" x:Name="BtnRewind"
                                Classes="circular-transport"
                                Click="OnRewind"
                                ToolTip.Tip="Rewind (Shift+Left)">
                            <Path Data="{StaticResource RewindIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </Button>

                        <!-- Play/Pause -->
                        <Button Grid.Column="3" x:Name="BtnPlayPause"
                                Classes="circular-transport"
                                Click="OnPlayPause"
                                ToolTip.Tip="Play/Pause (Space)">
                            <Path x:Name="PlayPauseIconPath"
                                  Data="{StaticResource PlayIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </Button>

                        <!-- Forward -->
                        <Button Grid.Column="4" x:Name="BtnForward"
                                Classes="circular-transport"
                                Click="OnForward"
                                ToolTip.Tip="Forward (Shift+Right)">
                            <Path Data="{StaticResource FastForwardIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </Button>

                        <!-- Next -->
                        <Button Grid.Column="5" x:Name="BtnNext"
                                Classes="circular-transport"
                                Click="OnNext"
                                ToolTip.Tip="Next Chapter (P)">
                            <Path Data="{StaticResource SkipForwardIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </Button>

                        <!-- Time Separator -->
                        <Border Grid.Column="6"
                                Width="2" Height="16"
                                Margin="8,0"
                                CornerRadius="2"
                                Background="{StaticResource TimeSeparatorBackground}"
                                Opacity="0.4"
                                VerticalAlignment="Center" />

                        <!-- Total Duration -->
                        <TextBlock Grid.Column="7"
                                   x:Name="DurationTimeLabel"
                                   Classes="time-label"
                                   Text="{Binding DurationText, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />

                        <!-- Volume -->
                        <Button Grid.Column="8" x:Name="BtnVolumeMenu"
                                Classes="circular-menu"
                                ToolTip.Tip="Volume (M)">
                            <Path x:Name="VolumeIconPath"
                                  Data="{StaticResource VolumeMaxIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <Border Classes="volume-popover-content"
                                            Background="{StaticResource PopoverBackground}"
                                            BorderBrush="{StaticResource PopoverBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <StackPanel Spacing="8" Width="180">
                                            <ToggleButton x:Name="BtnMuteToggle"
                                                          Classes="circular-toggle"
                                                          Content="M"
                                                          Click="OnToggleMute"
                                                          HorizontalAlignment="Center" />
                                            <Slider x:Name="VolumeSlider"
                                                    Classes="volume-slider"
                                                    Minimum="0" Maximum="130"
                                                    Value="{Binding VolumeValue}" />
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Subtitles -->
                        <Button Grid.Column="9" x:Name="BtnSubtitlesMenu"
                                Classes="circular-menu"
                                ToolTip.Tip="Subtitles"
                                Click="OnSubtitlesMenuClick">
                            <Path x:Name="SubtitleIconPath" Data="{StaticResource SubtitlesIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </Button>

                        <!-- Audio Tracks -->
                        <Button Grid.Column="10" x:Name="BtnAudioMenu"
                                Classes="circular-menu"
                                ToolTip.Tip="Audio Tracks"
                                Click="OnAudioMenuClick">
                            <Path x:Name="AudioIconPath" Data="{StaticResource AudioIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </Button>

                        <!-- Video Tracks -->
                        <Button Grid.Column="11" x:Name="BtnVideoMenu"
                                Classes="circular-menu"
                                ToolTip.Tip="Video Tracks"
                                IsVisible="{Binding HasMultipleVideoTracks}"
                                Click="OnVideoMenuClick">
                            <Path Data="{StaticResource VideoIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </Button>

                        <!-- Shuffle -->
                        <ToggleButton Grid.Column="12" x:Name="BtnShufflePlaylist"
                                      Classes="circular-toggle"
                                      IsChecked="{Binding IsShuffleEnabled}"
                                      IsVisible="{Binding HasMultiplePlaylistItems}"
                                      Click="OnToggleShuffle"
                                      ToolTip.Tip="Shuffle Playlist">
                            <Path Data="{StaticResource PlaylistShuffleIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </ToggleButton>

                        <!-- Loop File -->
                        <ToggleButton Grid.Column="13" x:Name="BtnLoopFile"
                                      Classes="circular-toggle"
                                      IsChecked="{Binding IsLoopFileEnabled}"
                                      Click="OnToggleLoopFile"
                                      ToolTip.Tip="Loop File (L)">
                            <Path Data="{StaticResource LoopFileIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </ToggleButton>

                        <!-- Playlist -->
                        <Button Grid.Column="14" x:Name="BtnPlaylistDialog"
                                Classes="circular-menu"
                                Click="OnOpenPlaylistDialog"
                                ToolTip.Tip="Playlist">
                            <Path Data="{StaticResource PlaylistIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </Button>

                        <!-- Options -->
                        <components:OptionsMenuButton Grid.Column="15" x:Name="BtnOptionsMenu" />

                        <!-- Fullscreen -->
                        <ToggleButton Grid.Column="16" x:Name="BtnFullscreen"
                                      Classes="circular-toggle"
                                      Click="OnToggleFullscreen"
                                      ToolTip.Tip="Fullscreen (F)">
                            <Path x:Name="FullscreenIconPath"
                                      Data="{StaticResource FullscreenEnterIcon}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                        </ToggleButton>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>