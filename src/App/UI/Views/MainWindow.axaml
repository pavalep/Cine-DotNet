<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cine.Avalonia.ViewModels"
        xmlns:components="using:Cine.Avalonia.Components"
        xmlns:conv="using:Cine.Avalonia.Converters"
        xmlns:ctrl="using:Cine.Avalonia.Controls"
        xmlns:controls="clr-namespace:Cine.Avalonia.Controls"
        xmlns:local="using:Cine.Avalonia.Controls"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Cine.Avalonia.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Cine"
        Width="800" Height="600"
        MinWidth="600" MinHeight="337"
        Background="#FF0C0C0E"
        TransparencyLevelHint="None"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        WindowDecorations="BorderOnly"
        DragDrop.AllowDrop="True">

    <Window.Styles>
        <Style Selector="Window > Grid > StackPanel > Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <conv:TimeSpanToStringConverter x:Key="TimeSpanToString" />
        <conv:ChapterMarginConverter x:Key="ChapterMarginConverter" />
    </Window.Resources>

    <!-- =====================================================================
         LAYERED LAYOUT
         All children overlap in a single Grid cell. Elements declared later
         render on top. No explicit Panel wrappers — using them would make
         Panels intercept all mouse events in Avalonia (Panel is always
         hit-testable regardless of background).
         ===================================================================== -->
    <Grid x:Name="MainOverlay" Background="Transparent">

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!--  LAYER 0: VIDEO + BACKDROP (renders first, behind overlays)   -->
        <!-- ══════════════════════════════════════════════════════════════ -->

        <!-- Playback background -->
        <Border Background="{StaticResource PlaybackRadialBackground}"
                IsHitTestVisible="False"
                x:Name="PlaybackBackground" />

        <!-- Video Host (DWM thumbnail composited above background, below controls) -->
        <ctrl:D3D11VideoHost x:Name="VideoHost"
                             IsVideoSurfaceVisible="False"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Video click overlay — fills window, captures hover for auto-hide -->
        <Border x:Name="VideoClickOverlay"
                Background="Transparent"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                IsTabStop="False"
                PointerPressed="OnVideoPointerPressed" />

        <!-- Vignette overlay -->
        <Border Background="{StaticResource VignetteOverlay}"
                IsHitTestVisible="False" />

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!--  LAYER 1: UI OVERLAYS (floats on top of video)               -->
        <!-- ══════════════════════════════════════════════════════════════ -->

        <!-- Start Page — full viewport, opaque background -->
        <local:StartPage x:Name="StartPage" />

        <!-- Loading Spinner — ZIndex=30 so it renders above all other overlays -->
        <controls:SpinnerOverlayControl x:Name="LoadingSpinnerOverlay" ZIndex="30" />

        <!-- Pause Indicator -->
        <controls:PauseOverlayControl x:Name="PauseOverlay" />

        <!-- Chapter Badge Overlay -->
        <Border Classes="chapter-badge-overlay" IsHitTestVisible="False">
            <TextBlock Classes="chapter-badge"
                       Text="{Binding ChapterTitle, Mode=OneWay}" />
        </Border>

        <!-- Replay Overlay -->
        <controls:ReplayOverlayControl x:Name="ReplayOverlay" />

        <!-- Drag-drop indicator overlay -->
        <controls:DragDropOverlayControl x:Name="DropIndicatorOverlay" />

        <!-- HEADER BAR — ZIndex=20, top, floats over video -->
        <controls:HeaderBarControl x:Name="HeaderBarControl"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Stretch" />

        <!-- FULLSCREEN HEADER — ZIndex=25, top, floats over video -->
        <controls:FullscreenHeaderControl x:Name="FullscreenHeaderControl"
                                          VerticalAlignment="Top" Height="44" />

        <!-- CONTROLS BOX — ZIndex=15, bottom, floats over video -->
        <controls:ControlsBoxControl x:Name="ControlsBoxControl"
                                     VerticalAlignment="Bottom"
                                     HorizontalAlignment="Stretch" />

        <!-- OSD Notification — bottom center, floats above ControlsBox.
             Bottom margin lifts it above the ControlsBox (which is ~100-110px tall). -->
        <controls:OsdNotificationControl x:Name="OsdNotificationControl"
                                          VerticalAlignment="Bottom"
                                          HorizontalAlignment="Center"
                                          Margin="0,0,0,110" />
    </Grid>
</Window>
