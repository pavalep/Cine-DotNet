<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cine.Avalonia.ViewModels"
        xmlns:components="using:Cine.Avalonia.Components"
        xmlns:conv="using:Cine.Avalonia.Converters"
        xmlns:ctrl="using:Cine.Avalonia.Controls"
        xmlns:local="using:Cine.Avalonia.Controls"
        x:Class="Cine.Avalonia.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Cine"
        Width="800" Height="600"
        MinWidth="332" MinHeight="187"
        Background="#FF0C0C0E"
        TransparencyLevelHint="None"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
         WindowDecorations="BorderOnly"
        DragDrop.AllowDrop="True">

    <Window.Styles>
        <!-- Ensure no-focus visuals on window chrome buttons -->
        <Style Selector="Window > Grid > StackPanel > Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <conv:TimeSpanToStringConverter x:Key="TimeSpanToString" />
        <conv:ChapterMarginConverter x:Key="ChapterMarginConverter" />
    </Window.Resources>

    <!-- Main Overlay Container -->
    <Grid x:Name="MainOverlay" Background="Black"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================== -->
        <!--  VIDEO AREA (full grid)  -->
        <!-- ======================== -->
        <Grid Grid.Row="0" Background="Black"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <!-- Playback background: radial gradient + vignette (canvas spec) -->
            <Border Background="{StaticResource PlaybackRadialBackground}"
                    IsHitTestVisible="False" />

            <!-- Video Host (Native HWND) -->
            <ctrl:D3D11VideoHost x:Name="VideoHost"
                                 IsVideoSurfaceVisible="False"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch" />

            <!-- Vignette overlay -->
            <Border Background="{StaticResource VignetteOverlay}"
                    IsHitTestVisible="False" />

            <!-- Start Page / Welcome Screen -->
            <local:StartPage x:Name="StartPage" ZIndex="10" />

            <!-- Loading Spinner -->
            <Border x:Name="LoadingSpinner"
                    Classes="loading-spinner"
                    Width="48" Height="48"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="False"
                    CornerRadius="24"
                    BorderThickness="3"
                    BorderBrush="{StaticResource OsdForeground}"
                    Background="Transparent"
                    Opacity="0.7" />

            <!-- Pause Indicator -->
            <Border x:Name="PauseIndicator"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Opacity="0" IsVisible="False"
                    CornerRadius="8" Padding="16"
                    Background="#80000000">
                <Path Data="{StaticResource PauseIcon}"
                      Width="48" Height="48" Stretch="Uniform"
                      Fill="White" />
            </Border>

            <!-- Chapter Badge Overlay (top-right) -->
            <Border Classes="chapter-badge-overlay">
                <TextBlock Classes="chapter-badge"
                           Text="{Binding ChapterTitle, Mode=OneWay}" />
            </Border>

            <!-- OSD Notifications -->
            <Border x:Name="OsdNotification"
                    Classes="OsdNotificationStyle">
                <TextBlock x:Name="OsdText"
                           Foreground="{StaticResource OsdForeground}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <!-- Drop indicator overlay -->
            <Border x:Name="DropIndicatorOverlay"
                    IsVisible="False"
                    Opacity="0"
                    IsHitTestVisible="False"
                    Background="#C6000000"
                    BorderBrush="#FF4AA3FF"
                    BorderThickness="2"
                    CornerRadius="8"
                    Margin="12">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                    <Path x:Name="DropIndicatorIcon"
                          Data="{StaticResource PlayIcon}"
                          Width="56" Height="56"
                          Stretch="Uniform"
                          Fill="#FF4AA3FF" />
                    <TextBlock x:Name="DropIndicatorText"
                               Text="Play"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#FF4AA3FF"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ======================== -->
            <!--  HEADER + CONTROLS OVERLAY  -->
            <!--  Matches reference header-and-controls -->
            <!-- ======================== -->
            <Border x:Name="HeaderAndControlsOverlay"
                    Classes="header-and-controls"
                    Background="{StaticResource HeaderAndControlsGradient}"
                    IsHitTestVisible="False"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch" />

            <!-- ======================== -->
            <!--  HEADER BAR (top overlay) -->
            <!-- ======================== -->
            <Border x:Name="HeaderBar" Classes="header-bar"
                    Background="{StaticResource HeaderGradient}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Height="56"
                    IsHitTestVisible="True"
                    PointerPressed="OnHeaderPointerPressed">
                <Grid x:Name="HeaderGrid" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- ======================== -->
                    <!-- Col 0: Open Menu Button  -->
                    <!-- ALIGNED: Python reference open_menu_button -->
                    <!-- visible: bind start_page.visible inverted    -->
                    <!-- (controlled by code-behind on media open/close) -->
                    <!-- ======================== -->
                    <Button Grid.Column="0"
                            x:Name="BtnOpenMenu"
                            IsVisible="False"
                            VerticalAlignment="Center"
                            Margin="8,0,4,0"
                            Background="rgba(255,255,255,0.12)"
                            CornerRadius="99"
                            BorderThickness="0"
                            Padding="14,6">
                        <Button.Styles>
                            <Style Selector="Button#BtnOpenMenu /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="Button#BtnOpenMenu:pointerover">
                                <Setter Property="Background" Value="rgba(255,255,255,0.17)" />
                            </Style>
                            <Style Selector="Button#BtnOpenMenu:pressed">
                                <Setter Property="Background" Value="rgba(255,255,255,0.25)" />
                            </Style>
                        </Button.Styles>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="Open"
                                       Foreground="{StaticResource OsdForeground}"
                                       FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" />
                            <Path Data="{StaticResource OpenChevronIcon}"
                                  Width="8" Height="6" Stretch="Uniform"
                                  Stroke="{StaticResource OsdForeground}"
                                  StrokeThickness="1.5"
                                  StrokeLineCap="Round"
                                  Opacity="0.7"
                                  VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="Open Files"
                                          Command="{Binding OpenFilesCommand}" />
                                <MenuItem Header="Open Folder"
                                          Command="{Binding OpenFolderCommand}" />
                                <Separator />
                                <MenuItem Header="Add Files"
                                          Command="{Binding AddFilesCommand}" />
                                <MenuItem Header="Add Subtitle Track"
                                          Command="{Binding AddSubtitleCommand}" />
                                <MenuItem Header="Add Audio Track"
                                          Command="{Binding AddAudioCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Col 1: Window Title (centered) -->
                    <TextBlock Grid.Column="1"
                               x:Name="TitleText" Text="Cine"
                               Foreground="{StaticResource OsdForeground}"
                               FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <!-- Col 2: PIP + Menu + Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="0">

                        <!-- PIP Button — compact mini-player mode -->
                        <ToggleButton x:Name="BtnPip"
                                      Classes="circular-menu"
                                      Width="34" Height="34"
                                      Margin="0,0,4,0"
                                      Click="OnTogglePip"
                                      ToolTip.Tip="Picture-in-Picture">
                            <Path Data="{StaticResource PipIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </ToggleButton>

                        <!-- Primary Menu Button -->
                        <Button x:Name="BtnPrimaryMenu"
                                Classes="circular-menu"
                                ToolTip.Tip="Main Menu"
                                Width="34" Height="34"
                                Margin="0,0,4,0">
                            <Path Data="{StaticResource MenuIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuItem Header="New Window" Click="OnNewWindowClick" />
                                    <MenuItem Header="Preferences" Click="OnPreferencesClick" />
                                    <Separator />
                                    <MenuItem Header="Keyboard Shortcuts" Click="OnShortcutsClick" />
                                    <MenuItem Header="About Cine" Click="OnAboutClick" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Fullscreen Close Button (only in fullscreen) -->
                        <Button x:Name="BtnFullscreenClose"
                                Classes="circular-menu"
                                ToolTip.Tip="Close"
                                Click="OnFullscreenCloseClick"
                                IsVisible="False"
                                Width="34" Height="34"
                                Margin="0,0,4,0">
                            <Path Data="{StaticResource CloseIcon}"
                                  Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{StaticResource OsdForeground}"
                                  StrokeThickness="1.5"
                                  StrokeLineCap="Round" />
                        </Button>

                        <!-- Native Window Controls (Minimize, Maximize, Close) -->
                        <StackPanel Orientation="Horizontal" Spacing="0"
                                    IsVisible="True" x:Name="WindowControlsPanel">
                            <Button x:Name="BtnMinimize" Click="OnMinimizeClick"
                                    Classes="window-control"
                                    ToolTip.Tip="Minimize">
                                <Path Data="{StaticResource MinimizeIcon}"
                                      Width="12" Height="12" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                            </Button>
                            <Button x:Name="BtnMaximizeRestore" Click="OnMaximizeRestoreClick"
                                    Classes="window-control"
                                    ToolTip.Tip="Maximize">
                                <Path x:Name="MaximizeRestoreIconPath"
                                      Data="{StaticResource MaximizeIcon}"
                                      Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{StaticResource OsdForeground}"
                                      StrokeThickness="1.5" />
                            </Button>
                            <Button x:Name="BtnClose" Click="OnCloseClick"
                                    Classes="window-control close"
                                    ToolTip.Tip="Close">
                                <Path Data="{StaticResource CloseIcon}"
                                      Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{StaticResource OsdForeground}"
                                      StrokeThickness="1.5"
                                      StrokeLineCap="Round" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================== -->
            <!--  CONTROLS BOX (bottom)   -->
            <!--  ALIGNED to Python reference:          -->
            <!--  Row 0 = buttons (WrapBox equivalent) -->
            <!--  Row 1 = seek bar + time labels        -->
            <!-- ======================== -->
            <Border x:Name="ControlsBox" Classes="controls-box"
                    Background="{StaticResource ControlsGradient}"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    IsVisible="False"
                    IsHitTestVisible="True">
                <Grid x:Name="ControlsGrid">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Transport buttons (ALIGNED: above seek bar, matches Python WrapBox) -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Seek bar + time labels (ALIGNED: below buttons) -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ======================== -->
                    <!--  ROW 0: TRANSPORT BUTTONS -->
                    <!--  ALIGNED button order:    -->
                    <!--  prev|play|next|vol|subs|audio|[video]|[spacer*]|[shuffle]|[loopList]|loopFile|playlist|options|fullscreen -->
                    <!--  REMOVED: BtnRewind, BtnForward (not in Python reference)   -->
                    <!--  ADDED: BtnLoopPlaylist between Shuffle and LoopFile        -->
                    <!--  ADDED: * spacer column between audio/video and shuffle groups -->
                    <!-- ======================== -->
                    <Grid Grid.Row="0"
                          Margin="13,10,13,4"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />  <!-- 0: Previous -->
                            <ColumnDefinition Width="Auto" />  <!-- 1: Play/Pause -->
                            <ColumnDefinition Width="Auto" />  <!-- 2: Next -->
                            <ColumnDefinition Width="Auto" />  <!-- 3: Volume -->
                            <ColumnDefinition Width="Auto" />  <!-- 4: Subtitles -->
                            <ColumnDefinition Width="Auto" />  <!-- 5: Audio -->
                            <ColumnDefinition Width="Auto" />  <!-- 6: Video (conditional) -->
                            <ColumnDefinition Width="*" />     <!-- 7: Spacer (hexpand, matches Python Separator hexpand) -->
                            <ColumnDefinition Width="Auto" />  <!-- 8: Shuffle (conditional) -->
                            <ColumnDefinition Width="Auto" />  <!-- 9: LoopPlaylist (conditional) — NEWLY ADDED -->
                            <ColumnDefinition Width="Auto" />  <!-- 10: LoopFile -->
                            <ColumnDefinition Width="Auto" />  <!-- 11: Playlist -->
                            <ColumnDefinition Width="Auto" />  <!-- 12: Options -->
                            <ColumnDefinition Width="Auto" />  <!-- 13: Fullscreen -->
                        </Grid.ColumnDefinitions>

                        <Grid.Styles>
                            <Style Selector="Button, ToggleButton">
                                <Setter Property="Width" Value="34" />
                                <Setter Property="Height" Value="34" />
                                <Setter Property="Margin" Value="2" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </Grid.Styles>

                        <!-- Previous -->
                        <Button Grid.Column="0" x:Name="BtnPrevious"
                                Classes="circular-transport"
                                Click="OnPrevious"
                                ToolTip.Tip="Previous (Shift+P)">
                            <Path Data="{StaticResource SkipBackwardIcon}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </Button>

                        <!-- Play/Pause -->
                        <Button Grid.Column="1" x:Name="BtnPlayPause"
                                Classes="circular-transport"
                                Click="OnPlayPause"
                                ToolTip.Tip="Play/Pause (Space)">
                            <Path x:Name="PlayPauseIconPath"
                                  Data="{StaticResource PlayIcon}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </Button>

                        <!-- Next -->
                        <Button Grid.Column="2" x:Name="BtnNext"
                                Classes="circular-transport"
                                Click="OnNext"
                                ToolTip.Tip="Next (P)">
                            <Path Data="{StaticResource SkipForwardIcon}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </Button>

                        <!-- Volume -->
                        <Button Grid.Column="3" x:Name="BtnVolumeMenu"
                                Classes="circular-menu"
                                ToolTip.Tip="Volume (M)">
                            <Panel Width="18" Height="18">
                                <!-- Speaker body — always visible -->
                                <Path x:Name="VolumeIconPath"
                                      Data="{StaticResource VolumeSpeakerIcon}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                                <!-- Volume arcs — visible when unmuted -->
                                <Path x:Name="VolumeArcsPath"
                                      Data="{StaticResource VolumeArcsIcon}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{StaticResource OsdForeground}"
                                      StrokeThickness="1.5"
                                      StrokeLineCap="Round" />
                                <!-- Mute cross — visible when muted -->
                                <Path x:Name="VolumeMuteCrossPath"
                                      Data="{StaticResource VolumeMuteCrossIcon}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{StaticResource OsdForeground}"
                                      StrokeThickness="1.5"
                                      StrokeLineCap="Round"
                                      IsVisible="False" />
                            </Panel>
                            <Button.Flyout>
                                <!-- ALIGNED: horizontal Box matching Python reference volume popover -->
                                <Flyout Placement="Top">
                                    <Border Classes="volume-popover-content"
                                            Background="{StaticResource PopoverBackground}"
                                            BorderBrush="{StaticResource PopoverBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,10">
                                        <!-- ALIGNED: horizontal layout (mute toggle + slider side by side) -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <!-- Mute Toggle — ALIGNED: VolumeMuteIcon + IsChecked binding -->
                                            <ToggleButton x:Name="BtnMuteToggle"
                                                          Classes="circular-toggle"
                                                          IsChecked="{Binding IsMuted}"
                                                          Click="OnToggleMute"
                                                          ToolTip.Tip="Mute"
                                                          Width="34" Height="34">
                                                <Path Data="{StaticResource VolumeSpeakerIcon}"
                                                      Width="18" Height="18" Stretch="Uniform"
                                                      Fill="{StaticResource OsdForeground}" />
                                            </ToggleButton>
                                            <!-- Volume Slider -->
                                            <Slider x:Name="VolumeSlider"
                                                    Classes="volume-slider"
                                                    Minimum="0" Maximum="130"
                                                    Value="{Binding VolumeValue}"
                                                    PointerPressed="OnVolumeSliderPointerPressed" />
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Subtitles -->
                        <Button Grid.Column="4" x:Name="BtnSubtitlesMenu"
                                Classes="circular-menu"
                                ToolTip.Tip="Subtitles"
                                Click="OnSubtitlesMenuClick">
                            <Path x:Name="SubtitleIconPath" Data="{StaticResource SubtitlesIcon}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </Button>

                        <!-- Audio Tracks -->
                        <Button Grid.Column="5" x:Name="BtnAudioMenu"
                                Classes="circular-menu"
                                ToolTip.Tip="Audio Tracks"
                                Click="OnAudioMenuClick">
                            <Path x:Name="AudioIconPath" Data="{StaticResource AudioIcon}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </Button>

                        <!-- Video Tracks (conditional) -->
                        <Button Grid.Column="6" x:Name="BtnVideoMenu"
                                Classes="circular-menu"
                                ToolTip.Tip="Video Tracks"
                                IsVisible="{Binding HasMultipleVideoTracks}"
                                Click="OnVideoMenuClick">
                            <Path Data="{StaticResource VideoIcon}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </Button>

                        <!-- Col 7: invisible spacer (*) — matches Python "Separator hexpand opacity:0" -->

                        <!-- Shuffle (conditional: HasMultiplePlaylistItems) -->
                        <ToggleButton Grid.Column="8" x:Name="BtnShufflePlaylist"
                                      Classes="circular-toggle"
                                      IsChecked="{Binding IsShuffleEnabled}"
                                      IsVisible="{Binding HasMultiplePlaylistItems}"
                                      Click="OnToggleShuffle"
                                      ToolTip.Tip="Shuffle Playlist">
                            <Path Data="{StaticResource PlaylistShuffleIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{StaticResource OsdForeground}"
                                  StrokeThickness="1.4"
                                  StrokeLineCap="Round" />
                        </ToggleButton>

                        <!-- LoopPlaylist — NEWLY ADDED (was missing in previous version) -->
                        <ToggleButton Grid.Column="9" x:Name="BtnLoopPlaylist"
                                      Classes="circular-toggle"
                                      IsChecked="{Binding IsLoopPlaylistEnabled}"
                                      IsVisible="{Binding HasMultiplePlaylistItems}"
                                      Click="OnToggleLoopPlaylist"
                                      ToolTip.Tip="Loop Playlist">
                            <Path Data="{StaticResource LoopPlaylistIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </ToggleButton>

                        <!-- Loop File -->
                        <ToggleButton Grid.Column="10" x:Name="BtnLoopFile"
                                      Classes="circular-toggle"
                                      IsChecked="{Binding IsLoopFileEnabled}"
                                      Click="OnToggleLoopFile"
                                      ToolTip.Tip="Loop File (L)">
                            <Path Data="{StaticResource LoopFileIcon}"
                                  Width="14" Height="14" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </ToggleButton>

                        <!-- Playlist -->
                        <Button Grid.Column="11" x:Name="BtnPlaylistDialog"
                                Classes="circular-menu"
                                Click="OnOpenPlaylistDialog"
                                ToolTip.Tip="Playlist">
                            <Path Data="{StaticResource PlaylistIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </Button>

                        <!-- Options -->
                        <components:OptionsMenuButton Grid.Column="12" x:Name="BtnOptionsMenu" />

                        <!-- Fullscreen -->
                        <ToggleButton Grid.Column="13" x:Name="BtnFullscreen"
                                      Classes="circular-toggle"
                                      Click="OnToggleFullscreen"
                                      ToolTip.Tip="Fullscreen (F)">
                            <Path x:Name="FullscreenIconPath"
                                  Data="{StaticResource FullscreenEnterIcon}"
                                  Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{StaticResource OsdForeground}"
                                  StrokeThickness="1.5"
                                  StrokeLineCap="Round" />
                        </ToggleButton>
                    </Grid>

                    <!-- ======================== -->
                    <!--  ROW 1: SEEK BAR + TIME  -->
                    <!--  ALIGNED: seek scale (hexpand) | elapsed | sep | total -->
                    <!--  Matches Python reference bottom Box layout            -->
                    <!--  Time labels MOVED here from old controls row          -->
                    <!-- ======================== -->
                    <Grid Grid.Row="1"
                          Margin="3,0,20,5"
                          Height="37"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />    <!-- Seek area (hexpand) -->
                            <ColumnDefinition Width="Auto" /> <!-- Elapsed time -->
                            <ColumnDefinition Width="Auto" /> <!-- Separator -->
                            <ColumnDefinition Width="Auto" /> <!-- Total duration -->
                        </Grid.ColumnDefinitions>

                        <!-- Seek Area (hexpand, with chapter markers) -->
                        <Grid Grid.Column="0"
                              x:Name="SeekArea"
                              Margin="8,0,3,0"
                              PointerMoved="OnSeekAreaPointerMoved"
                              PointerExited="OnSeekAreaPointerExited"
                              PointerWheelChanged="OnSeekAreaPointerWheelChanged"
                              PointerPressed="OnSeekAreaPointerPressed"
                              PointerReleased="OnSeekAreaPointerReleased"
                              Background="Transparent">

                            <!-- Seek Track (trough, full width) -->
                            <Border x:Name="SeekTrack"
                                    Background="{StaticResource ProgressTroughBackground}"
                                    CornerRadius="2"
                                    Height="4"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False" />

                            <!-- Seek Fill — positioned via code-behind -->
                            <Border x:Name="SeekFill"
                                    Background="{StaticResource ProgressSliderBackground}"
                                    CornerRadius="2"
                                    Height="4"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    IsHitTestVisible="False" />

                            <!-- Seek Thumb — positioned via code-behind -->
                            <Border x:Name="SeekThumb"
                                    Width="16" Height="16"
                                    CornerRadius="8"
                                    Background="{StaticResource ProgressSliderBackground}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" OffsetY="1" Color="#80000000" />
                                </Border.Effect>
                            </Border>

                            <!-- Chapter Markers -->
                            <ItemsControl x:Name="ChapterMarkersControl"
                                          ItemsSource="{Binding ChapterMarkers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas IsHitTestVisible="False" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="2" Height="10"
                                                   Fill="{StaticResource OsdForeground}"
                                                   Opacity="0.5" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Chapter preview tooltip -->
                            <Border x:Name="ChapterPreviewPopover"
                                    IsVisible="False"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource PopoverBackground}"
                                    BorderBrush="{StaticResource PopoverBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,4"
                                    Margin="0,-34,0,0"
                                    BoxShadow="0 4 12 0 #80000000">
                                <TextBlock x:Name="ChapterPreviewText"
                                           Text="Chapter"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource OsdForeground}" />
                            </Border>
                        </Grid>

                        <!-- Time Elapsed — ALIGNED: moved from old controls row, margin: 0 -7px -->
                        <TextBlock Grid.Column="1"
                                   x:Name="PositionTimeLabel"
                                   Classes="time-label"
                                   Text="{Binding PositionText, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Margin="-7,0" />

                        <!-- Time Separator (2×16px, #ddd, opacity 0.4) -->
                        <Border Grid.Column="2"
                                Width="2" Height="16"
                                Margin="10,0"
                                CornerRadius="2"
                                Background="{StaticResource TimeSeparatorBackground}"
                                Opacity="0.4"
                                VerticalAlignment="Center" />

                        <!-- Total Duration — ALIGNED: moved from old controls row -->
                        <TextBlock Grid.Column="3"
                                   x:Name="DurationTimeLabel"
                                   Classes="time-label"
                                   Text="{Binding DurationText, Mode=OneWay}"
                                   Margin="0,0,20,0"
                                   VerticalAlignment="Center" />
                    </Grid>

                </Grid>
            </Border>
        </Grid>

        <!-- OSD Notification (centered, bottom area) -->
        <Border x:Name="OsdNotificationBorder"
                IsVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,80"
                Padding="16,8"
                CornerRadius="8"
                Background="{StaticResource OsdBackground}">
            <TextBlock x:Name="OsdNotificationText"
                       Text=""
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource OsdForeground}" />
        </Border>
    </Grid>
</Window>
