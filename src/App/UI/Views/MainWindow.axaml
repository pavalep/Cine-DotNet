<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cine.Avalonia.ViewModels"
        xmlns:components="using:Cine.Avalonia.Components"
        xmlns:conv="using:Cine.Avalonia.Converters"
        xmlns:ctrl="using:Cine.Avalonia.Controls"
        xmlns:controls="clr-namespace:Cine.Avalonia.Controls"
        xmlns:local="using:Cine.Avalonia.Controls"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Cine.Avalonia.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Cine"
        Width="800" Height="600"
        MinWidth="332" MinHeight="187"
        Background="#FF0C0C0E"
        TransparencyLevelHint="None"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        WindowDecorations="BorderOnly"
        DragDrop.AllowDrop="True">

    <Window.Styles>
        <Style Selector="Window > Grid > StackPanel > Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <conv:TimeSpanToStringConverter x:Key="TimeSpanToString" />
        <conv:ChapterMarginConverter x:Key="ChapterMarginConverter" />
    </Window.Resources>

    <!-- Main Overlay Container -->
    <Grid x:Name="MainOverlay" Background="Black"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================== -->
        <!--  VIDEO AREA (full grid)  -->
        <!-- ======================== -->
        <Grid Grid.Row="0" Background="Black"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

            <!-- Playback background -->
            <Border Background="{StaticResource PlaybackRadialBackground}"
                    IsHitTestVisible="False" />

            <!-- Video Host (Native HWND) -->
            <ctrl:D3D11VideoHost x:Name="VideoHost"
                                 IsVideoSurfaceVisible="False"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                 Opacity="0">
                <ctrl:D3D11VideoHost.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
                    </Transitions>
                </ctrl:D3D11VideoHost.Transitions>
            </ctrl:D3D11VideoHost>

            <!-- Video click overlay -->
            <Border x:Name="VideoClickOverlay"
                    Background="Transparent"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    PointerPressed="OnVideoPointerPressed"
                    PointerMoved="OnWindowPointerMoved"
                    ZIndex="5" />

            <!-- Vignette overlay -->
            <Border Background="{StaticResource VignetteOverlay}"
                    IsHitTestVisible="False" />

            <!-- Start Page -->
            <local:StartPage x:Name="StartPage" ZIndex="10" />

            <!-- Loading Spinner -->
            <controls:SpinnerOverlayControl x:Name="LoadingSpinnerOverlay" ZIndex="20" />

            <!-- Pause Indicator -->
            <controls:PauseOverlayControl x:Name="PauseOverlay" ZIndex="25" />

            <!-- Chapter Badge Overlay -->
            <Border Classes="chapter-badge-overlay">
                <TextBlock Classes="chapter-badge"
                           Text="{Binding ChapterTitle, Mode=OneWay}" />
            </Border>

            <!-- Replay Overlay -->
            <controls:ReplayOverlayControl x:Name="ReplayOverlay" ZIndex="30" />

            <!-- Drag-drop indicator overlay -->
            <controls:DragDropOverlayControl x:Name="DropIndicatorOverlay" ZIndex="35" />

            <!-- ======================== -->
            <!--  HEADER + CONTROLS OVERLAY  -->
            <!-- ======================== -->
            <Border x:Name="HeaderAndControlsOverlay"
                    Classes="header-and-controls"
                    Background="{StaticResource HeaderAndControlsGradient}"
                    IsHitTestVisible="False"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />

            <!-- ======================== -->
            <!--  HEADER BAR  -->
            <!-- ======================== -->
            <controls:HeaderBarControl x:Name="HeaderBarControl"
                                       ZIndex="20"
                                       VerticalAlignment="Top"
                                       HorizontalAlignment="Stretch" />

            <!-- ======================== -->
            <!--  FULLSCREEN HEADER  -->
            <!-- ======================== -->
            <controls:FullscreenHeaderControl x:Name="FullscreenHeaderControl"
                                              VerticalAlignment="Top" Height="44"
                                              ZIndex="25" />

            <!-- ======================== -->
            <!--  CONTROLS BOX  -->
            <!-- ======================== -->
            <controls:ControlsBoxControl x:Name="ControlsBoxControl"
                                         ZIndex="15"
                                         VerticalAlignment="Bottom"
                                         HorizontalAlignment="Stretch" />

        </Grid>

        <!-- OSD Notification -->
        <controls:OsdNotificationControl x:Name="OsdNotificationControl"
                                          VerticalAlignment="Bottom"
                                          HorizontalAlignment="Center"
                                          ZIndex="40" />
    </Grid>
</Window>
