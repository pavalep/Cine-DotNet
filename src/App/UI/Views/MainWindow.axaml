<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cine.Avalonia.ViewModels"
        xmlns:conv="using:Cine.Avalonia.Converters"
        xmlns:ctrl="using:Cine.Avalonia.Controls"
        xmlns:local="using:Cine.Avalonia.Controls"
        x:Class="Cine.Avalonia.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Cine"
        Width="800" Height="600"
        MinWidth="332" MinHeight="187"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="Blur"
        DragDrop.AllowDrop="True">

    <Window.Resources>
        <conv:TimeSpanToStringConverter x:Key="TimeSpanToString" />
        <conv:PercentConverter x:Key="PercentConverter" />
        <conv:ChapterMarginConverter x:Key="ChapterMarginConverter" />
    </Window.Resources>

    <!-- Main Overlay Container - Grid overlays children like Python's GtkOverlay -->
        <Grid x:Name="MainOverlay" Background="Black">

        <!-- Video Host (Primary Content - fills entire overlay) -->
        <ctrl:D3D11VideoHost x:Name="VideoHost" />

        <!-- Start Page / Welcome Screen (Placed above video but below UI controls) -->
        <local:StartPage x:Name="StartPage" />

        <!-- Loading Spinner (centered overlay - custom since ProgressRing unavailable) -->
        <Border x:Name="LoadingSpinner"
                Classes="loading-spinner"
                Width="48" Height="48"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsVisible="False"
                CornerRadius="24"
                BorderThickness="3"
                BorderBrush="{StaticResource OsdForeground}"
                Background="Transparent"
                Opacity="0.7">
        </Border>

        <!-- Pause Indicator (centered overlay with revealer behavior) -->
        <Border x:Name="PauseIndicator"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Opacity="0" IsVisible="False"
                CornerRadius="8" Padding="16"
                Background="#80000000">
            <Path Data="{StaticResource PauseIcon}"
                  Width="48" Height="48" Stretch="Uniform"
                  Fill="White" />
        </Border>

        <!-- UI Controls Container (overlay with auto-hide behavior) -->
        <Border x:Name="UiControlsOverlay"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Opacity="1" IsVisible="True">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#CC000000" />
                    <GradientStop Offset="0.7" Color="#4D000000" />
                    <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid x:Name="MainGrid" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ======================== -->
                <!--  HEADER BAR              -->
                <!-- ======================== -->
                <Border Grid.Row="0" x:Name="HeaderBar" Classes="header-bar">
                    <Grid x:Name="HeaderGrid" Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Open Menu Button -->
                        <Button x:Name="BtnOpenMenu" Grid.Column="0"
                                Classes="circular-menu"
                                ToolTip.Tip="Open files..."
                                IsVisible="False">
                            <Path Data="M 4 4H 20V 20H 4V 4 Z M 8 8V 16H 10V 8H 8 Z M 12 8V 16H 14V 8H 12 Z"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuItem Header="Open Files" Command="{Binding OpenFilesCommand}" />
                                    <MenuItem Header="Open Folder" Command="{Binding OpenFolderCommand}" />
                                    <MenuItem Header="Add Files" Command="{Binding AddFilesCommand}" />
                                    <Separator />
                                    <MenuItem Header="Add Subtitle Track" Command="{Binding AddSubtitleCommand}" />
                                    <MenuItem Header="Add Audio Track" Command="{Binding AddAudioCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Window Title (centered) -->
                        <TextBlock Grid.Column="1" x:Name="TitleText"
                                   Text="{Binding Title, Mode=OneWay, FallbackValue='Cine'}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource OsdForeground}"
                                   FontSize="14" FontWeight="Medium" />

                        <!-- PIP Button -->
                        <ToggleButton x:Name="BtnPip" Grid.Column="2"
                                      Classes="circular-toggle"
                                      ToolTip.Tip="Picture-in-Picture (not implemented)">
                            <Path Data="{StaticResource PipIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                        </ToggleButton>

                        <!-- Primary Menu Button -->
                        <Button x:Name="BtnPrimaryMenu" Grid.Column="3"
                                Classes="circular-menu"
                                ToolTip.Tip="Main Menu">
                            <Path Data="{StaticResource MenuIcon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource OsdForeground}" />
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuItem Header="New Window" />
                                    <MenuItem Header="Preferences" />
                                    <Separator />
                                    <MenuItem Header="Keyboard Shortcuts" />
                                    <MenuItem Header="About Cine" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Border>

                <!-- Spacer between header and controls -->
                <Rectangle Grid.Row="1" Height="1" Opacity="0" />

                <!-- ======================== -->
                <!--  CONTROLS BOX            -->
                <!-- ======================== -->
                <Border Grid.Row="2" x:Name="ControlsBox" Classes="controls-box"
                        IsVisible="False">
                    <Grid x:Name="ControlsGrid" Margin="12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Transport Controls Row -->
                        <WrapPanel Grid.Row="0" x:Name="TransportWrapPanel"
                                   HorizontalAlignment="Center" VerticalAlignment="Top">

                            <!-- Previous Button -->
                            <Button x:Name="BtnPrevious"
                                    Classes="circular-transport"
                                    Click="OnPrevious"
                                    ToolTip.Tip="Previous Chapter (Shift+P)"
                                    Margin="2">
                                <Path Data="{StaticResource PreviousChapterIcon}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                            </Button>

                            <!-- Rewind Button -->
                            <Button x:Name="BtnRewind"
                                    Classes="circular-transport"
                                    Click="OnRewind"
                                    ToolTip.Tip="Rewind (Shift+Left)"
                                    Margin="2">
                                <Path Data="{StaticResource RewindIcon}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                            </Button>

                            <!-- Play/Pause Button -->
                            <Button x:Name="BtnPlayPause"
                                    Classes="circular-transport"
                                    Click="OnPlayPause"
                                    ToolTip.Tip="Play/Pause (Space)"
                                    Margin="2">
                                <Path x:Name="PlayPauseIconPath"
                                      Data="{StaticResource PlayIcon}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                            </Button>

                            <!-- Stop Button -->
                            <Button x:Name="BtnStop"
                                    Classes="circular-transport"
                                    Click="OnStop"
                                    ToolTip.Tip="Stop"
                                    Margin="2">
                                <Path Data="{StaticResource StopIcon}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                            </Button>

                            <!-- Forward Button -->
                            <Button x:Name="BtnForward"
                                    Classes="circular-transport"
                                    Click="OnForward"
                                    ToolTip.Tip="Forward (Shift+Right)"
                                    Margin="2">
                                <Path Data="{StaticResource FastForwardIcon}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                            </Button>

                            <!-- Next Button -->
                            <Button x:Name="BtnNext"
                                    Classes="circular-transport"
                                    Click="OnNext"
                                    ToolTip.Tip="Next Chapter (P)"
                                    Margin="2">
                                <Path Data="{StaticResource NextChapterIcon}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                            </Button>

                            <!-- Volume Menu Button -->
                            <Button x:Name="BtnVolumeMenu"
                                    Classes="circular-menu"
                                    ToolTip.Tip="Volume (M)"
                                    Margin="2">
                                <Path x:Name="VolumeIconPath"
                                      Data="{StaticResource VolumeMaxIcon}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <Border Classes="volume-popover-content">
                                            <StackPanel Spacing="8">
                                                <ToggleButton x:Name="BtnMuteToggle"
                                                              Classes="circular-toggle"
                                                              Content="M"
                                                              Click="OnToggleMute"
                                                              HorizontalAlignment="Center" />
                                                <Slider x:Name="VolumeSlider"
                                                        Classes="volume-slider"
                                                        Minimum="0" Maximum="130"
                                                        Value="{Binding Volume}" />
                                            </StackPanel>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <!-- Subtitles Menu Button -->
                            <Button x:Name="BtnSubtitlesMenu"
                                    Classes="circular-menu"
                                    ToolTip.Tip="Subtitles"
                                    Margin="2">
                                <Path x:Name="SubtitleIconPath"
                                      Data="{StaticResource SubtitlesIcon}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                                <Button.Flyout>
                                    <MenuFlyout ItemsSource="{Binding SubtitleTracks}" />
                                </Button.Flyout>
                            </Button>

                            <!-- Audio Tracks Menu Button -->
                            <Button x:Name="BtnAudioMenu"
                                    Classes="circular-menu"
                                    ToolTip.Tip="Audio Tracks"
                                    Margin="2">
                                <Path x:Name="AudioIconPath"
                                      Data="{StaticResource AudioIcon}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                                <Button.Flyout>
                                    <MenuFlyout ItemsSource="{Binding AudioTracks}" />
                                </Button.Flyout>
                            </Button>

                            <!-- Video Tracks Menu Button -->
                            <Button x:Name="BtnVideoMenu"
                                    Classes="circular-menu"
                                    ToolTip.Tip="Video Tracks"
                                    IsVisible="{Binding HasMultipleVideoTracks}"
                                    Margin="2">
                                <Path Data="M 4 4H 20V 20H 4V 4 Z M 8 8H 10V 16H 8V 8 Z M 14 8H 16V 16H 14V 8 Z"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                                <Button.Flyout>
                                    <MenuFlyout ItemsSource="{Binding VideoTracks}" />
                                </Button.Flyout>
                            </Button>

                            <!-- Playlist Shuffle Toggle -->
                            <ToggleButton x:Name="BtnShufflePlaylist"
                                          Classes="circular-toggle"
                                          IsChecked="{Binding IsShuffleEnabled}"
                                          IsVisible="{Binding HasMultiplePlaylistItems}"
                                          Click="OnToggleShuffle"
                                          ToolTip.Tip="Shuffle Playlist"
                                          Margin="2">
                                <Path Data="{StaticResource PlaylistShuffleIcon}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                            </ToggleButton>

                            <!-- Playlist Dialog Button -->
                            <Button x:Name="BtnPlaylistDialog"
                                    Classes="circular-transport"
                                    Click="OnOpenPlaylistDialog"
                                    ToolTip.Tip="Playlist"
                                    Margin="2">
                                <Path Data="{StaticResource PlaylistIcon}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                            </Button>

                            <!-- Options Menu Button -->
                            <Button x:Name="BtnOptionsMenu"
                                    Classes="circular-menu"
                                    ToolTip.Tip="Options"
                                    Margin="2">
                                <Path Data="{StaticResource OptionsIcon}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuItem Header="Playback Speed +" Click="OnIncreaseSpeed" />
                                        <MenuItem Header="Playback Speed -" Click="OnDecreaseSpeed" />
                                        <MenuItem Header="Reset Playback Speed" Click="OnResetSpeed" />
                                        <Separator />
                                        <MenuItem Header="Take Screenshot" Click="OnScreenshot" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <!-- Screenshot Button -->
                            <Button x:Name="BtnScreenshot"
                                    Classes="circular-transport"
                                    Click="OnScreenshot"
                                    ToolTip.Tip="Screenshot (S)"
                                    Margin="2">
                                <Path Data="{StaticResource ScreenshotIcon}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                            </Button>

                            <!-- Fullscreen Toggle Button -->
                            <ToggleButton x:Name="BtnFullscreen"
                                          Classes="circular-toggle"
                                          Click="OnToggleFullscreen"
                                          ToolTip.Tip="Fullscreen (F)"
                                          Margin="2">
                                <Path x:Name="FullscreenIconPath"
                                      Data="{StaticResource FullscreenEnterIcon}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                            </ToggleButton>

                            <!-- Loop File Toggle -->
                            <ToggleButton x:Name="BtnLoopFile"
                                          Classes="circular-toggle"
                                          IsChecked="{Binding IsLoopFileEnabled}"
                                          Click="OnToggleLoopFile"
                                          ToolTip.Tip="Loop File (L)"
                                          Margin="2">
                                <Path Data="M 6 4H 10V 8H 6V 4 Z M 12 8H 16V 12H 12V 8 Z M 8 12H 12V 16H 8V 12 Z M 4 14H 8V 18H 4V 14 Z"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                            </ToggleButton>

                            <!-- Loop Playlist Toggle -->
                            <ToggleButton x:Name="BtnLoopPlaylist"
                                          Classes="circular-toggle"
                                          IsChecked="{Binding IsLoopPlaylistEnabled}"
                                          IsVisible="{Binding HasMultiplePlaylistItems}"
                                          Click="OnToggleLoopPlaylist"
                                          ToolTip.Tip="Loop Playlist (Ctrl+L)"
                                          Margin="2">
                                <Path Data="M 4 4H 8V 8H 4V 4 Z M 10 4H 14V 8H 10V 4 Z M 6 10H 10V 14H 6V 10 Z M 12 10H 16V 14H 12V 10 Z M 8 16H 12V 20H 8V 16 Z"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="{StaticResource OsdForeground}" />
                            </ToggleButton>
                        </WrapPanel>

                        <!-- Progress/Seek Bar Row -->
                        <Grid Grid.Row="1"
                              x:Name="SeekArea"
                              PointerMoved="OnSeekAreaPointerMoved"
                              PointerExited="OnSeekAreaPointerExited"
                              PointerWheelChanged="OnSeekAreaPointerWheelChanged"
                              PointerPressed="OnSeekAreaPointerPressed"
                              Margin="0,4,0,0"
                              ColumnDefinitions="Auto,*,Auto"
                              RowDefinitions="Auto,Auto">

                            <!-- Time Labels -->
                            <TextBlock Grid.Column="0" Grid.Row="0"
                                       x:Name="PositionTimeLabel"
                                       Classes="time-label"
                                       Text="{Binding PositionText, Mode=OneWay}" />

                            <TextBlock Grid.Column="2" Grid.Row="0"
                                       x:Name="DurationTimeLabel"
                                       Classes="time-label"
                                       Text="{Binding DurationText, Mode=OneWay}" />

                            <!-- Seek Slider Background (trough) -->
                            <Border Grid.Column="1" Grid.Row="1"
                                    Background="{StaticResource ProgressTroughBackground}"
                                    CornerRadius="2"
                                    Height="4"
                                    VerticalAlignment="Center"
                                    Margin="8,0" />

                            <!-- Seek Slider Filled (progress) -->
                            <Border Grid.Column="1" Grid.Row="1"
                                    Background="{StaticResource ProgressSliderBackground}"
                                    CornerRadius="2"
                                    Height="4"
                                    VerticalAlignment="Center"
                                    Margin="8,0">
                                <Border.Clip>
                                    <RectangleGeometry Rect="{Binding SeekValue, Converter={StaticResource PercentConverter}}" />
                                </Border.Clip>
                            </Border>

                            <!-- Thumb (positioned via margin based on SeekValue) -->
                            <Border Grid.Column="1" Grid.Row="1"
                                    Width="16" Height="16"
                                    CornerRadius="8"
                                    Background="{StaticResource ProgressSliderBackground}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="{Binding SeekValue, Converter={StaticResource PercentConverter}}" />

                            <!-- Chapter Markers (overlay on slider) -->
                            <ItemsControl Grid.Column="1" Grid.Row="1"
                                          ItemsSource="{Binding ChapterMarkers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="2" Height="12"
                                                   Fill="{StaticResource OsdForeground}"
                                                   Opacity="0.5" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.Styles>
                                    <Style Selector="ContentPresenter">
                                        <Setter Property="Canvas.Left"
                                                Value="{Binding ., Converter={StaticResource ChapterMarginConverter}}" />
                                    </Style>
                                </ItemsControl.Styles>
                            </ItemsControl>

                            <!-- Chapter preview tooltip -->
                            <Border x:Name="ChapterPreviewPopover"
                                    Grid.Column="1" Grid.Row="0"
                                    IsVisible="False"
                                    HorizontalAlignment="Left"
                                    Background="#F219191B"
                                    BorderBrush="#FF202021"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,4"
                                    Margin="8,-34,0,0">
                                <TextBlock x:Name="ChapterPreviewText"
                                           Text="Chapter"
                                           FontSize="12"
                                           Foreground="{StaticResource OsdForeground}" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Video Info Overlay (bottom-left) -->
        <Border Classes="video-position-overlay">
            <StackPanel Orientation="Horizontal">
                <TextBlock Classes="time-elapsed"
                           Text="{Binding PositionText, Mode=OneWay}" />
                <TextBlock Text=" / "
                           Foreground="#DDDDDD"
                           FontFamily="{StaticResource NumericFont}"
                           FontSize="13"
                           VerticalAlignment="Center" />
                <TextBlock Classes="time-duration"
                           Text="{Binding DurationText, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <!-- Chapter Badge Overlay (top-right) -->
        <Border Classes="chapter-badge-overlay">
            <TextBlock Classes="chapter-badge"
                       Text="{Binding ChapterTitle, Mode=OneWay}" />
        </Border>

        <!-- OSD Notifications -->
        <Border x:Name="OsdNotification"
                Classes="OsdNotificationStyle">
            <TextBlock x:Name="OsdText"
                       Foreground="{StaticResource OsdForeground}"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <!-- Drop indicator overlay -->
        <Border x:Name="DropIndicatorOverlay"
                IsVisible="False"
                Background="#C6000000"
                BorderBrush="#FF4AA3FF"
                BorderThickness="2"
                CornerRadius="8"
                Margin="12">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <Path x:Name="DropIndicatorIcon"
                      Data="{StaticResource PlayIcon}"
                      Width="56" Height="56"
                      Stretch="Uniform"
                      Fill="#FF4AA3FF" />
                <TextBlock x:Name="DropIndicatorText"
                           Text="Play"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#FF4AA3FF"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
