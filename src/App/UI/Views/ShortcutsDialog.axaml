<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Cine.Avalonia.ShortcutsDialog"
        Title="Keyboard Shortcuts"
        Width="520" Height="500"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="#FF0C0C0E"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Height="48"
                Background="#FF1E1E1E"
                Padding="12,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Keyboard Shortcuts" FontSize="16" FontWeight="SemiBold"
                           Foreground="White" VerticalAlignment="Center" />
                <Button Grid.Column="1" Click="OnCloseClick" Background="Transparent"
                        BorderThickness="0" Width="32" Height="32"
                        ToolTip.Tip="Close">
                    <Path Data="{StaticResource CloseIcon}"
                          Width="12" Height="12" Stretch="Uniform"
                          Stroke="White" StrokeThickness="1.5" StrokeLineCap="Round" />
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="20">
            <StackPanel Spacing="16">
                <TextBlock Text="Playback" FontSize="16" FontWeight="SemiBold"
                           Foreground="#E5E5E5" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Play / Pause" Foreground="#CCCCCC" />
                    <TextBlock Grid.Column="1" Foreground="#999999" FontFamily="Consolas" Text="Space / K" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Stop" Foreground="#CCCCCC" />
                    <TextBlock Grid.Column="1" Foreground="#999999" FontFamily="Consolas" Text="S" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Next Chapter" Foreground="#CCCCCC" />
                    <TextBlock Grid.Column="1" Foreground="#999999" FontFamily="Consolas" Text="P" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Previous Chapter" Foreground="#CCCCCC" />
                    <TextBlock Grid.Column="1" Foreground="#999999" FontFamily="Consolas" Text="Shift+P" />
                </Grid>

                <TextBlock Text="Seek" FontSize="16" FontWeight="SemiBold"
                           Foreground="#E5E5E5" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Seek Forward 10s" Foreground="#CCCCCC" />
                    <TextBlock Grid.Column="1" Foreground="#999999" FontFamily="Consolas" Text="Right" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Seek Backward 10s" Foreground="#CCCCCC" />
                    <TextBlock Grid.Column="1" Foreground="#999999" FontFamily="Consolas" Text="Left" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Seek Forward 30s" Foreground="#CCCCCC" />
                    <TextBlock Grid.Column="1" Foreground="#999999" FontFamily="Consolas" Text="Up" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Seek Backward 30s" Foreground="#CCCCCC" />
                    <TextBlock Grid.Column="1" Foreground="#999999" FontFamily="Consolas" Text="Down" />
                </Grid>

                <TextBlock Text="Volume" FontSize="16" FontWeight="SemiBold"
                           Foreground="#E5E5E5" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Volume Up" Foreground="#CCCCCC" />
                    <TextBlock Grid.Column="1" Foreground="#999999" FontFamily="Consolas" Text="M / 9" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Volume Down" Foreground="#CCCCCC" />
                    <TextBlock Grid.Column="1" Foreground="#999999" FontFamily="Consolas" Text="0" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Mute Toggle" Foreground="#CCCCCC" />
                    <TextBlock Grid.Column="1" Foreground="#999999" FontFamily="Consolas" Text="M / 9" />
                </Grid>

                <TextBlock Text="Display" FontSize="16" FontWeight="SemiBold"
                           Foreground="#E5E5E5" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Fullscreen" Foreground="#CCCCCC" />
                    <TextBlock Grid.Column="1" Foreground="#999999" FontFamily="Consolas" Text="F" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Toggle Controls" Foreground="#CCCCCC" />
                    <TextBlock Grid.Column="1" Foreground="#999999" FontFamily="Consolas" Text="I" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Screenshot" Foreground="#CCCCCC" />
                    <TextBlock Grid.Column="1" Foreground="#999999" FontFamily="Consolas" Text="Ctrl+S" />
                </Grid>

                <TextBlock Text="Video Filters" FontSize="16" FontWeight="SemiBold"
                           Foreground="#E5E5E5" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Contrast + / -" Foreground="#CCCCCC" />
                    <TextBlock Grid.Column="1" Foreground="#999999" FontFamily="Consolas" Text="1 / 2" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Brightness + / -" Foreground="#CCCCCC" />
                    <TextBlock Grid.Column="1" Foreground="#999999" FontFamily="Consolas" Text="3 / 4" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Gamma + / -" Foreground="#CCCCCC" />
                    <TextBlock Grid.Column="1" Foreground="#999999" FontFamily="Consolas" Text="5 / 6" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Saturation + / -" Foreground="#CCCCCC" />
                    <TextBlock Grid.Column="1" Foreground="#999999" FontFamily="Consolas" Text="7 / 8" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
