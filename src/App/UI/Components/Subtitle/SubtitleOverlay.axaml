<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cine.Avalonia.Components.SubtitleOverlay"
             x:Name="SubtitleOverlayRoot">
    <Button x:Name="BtnSubtitles"
            Classes="circular-menu"
            ToolTip.Tip="Subtitles"
            AutomationProperties.Name="Subtitles menu"
            Click="OnSubtitlesClick"
            ZIndex="20">
        <materialIcons:MaterialIcon x:Name="SubtitleIcon" Kind="Subtitles" Width="18" Height="18"
            Foreground="{StaticResource OsdForeground}" />
    </Button>
</UserControl>
