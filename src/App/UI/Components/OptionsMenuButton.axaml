<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cine.Avalonia.ViewModels"
             x:Class="Cine.Avalonia.Components.OptionsMenuButton"
             x:DataType="vm:MainViewModel">

    <!-- Options Menu Button — ALIGNED to Python reference options.blp -->
    <Button x:Name="BtnOptionsMenu"
            Classes="circular-menu"
            ToolTip.Tip="Options"
            Margin="2">
        <Path Data="{StaticResource OptionsIcon}"
              Width="16" Height="16" Stretch="Uniform"
              Stroke="{StaticResource OsdForeground}"
              StrokeThickness="1.4"
              StrokeLineCap="Round" />
        <Button.Flyout>
            <Flyout Placement="Top">
                <Border Background="{StaticResource PopoverBackground}"
                        BorderBrush="{StaticResource PopoverBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="0">
                    <ScrollViewer MaxHeight="420"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="0" Width="280" Margin="8">

                            <!-- Reset All -->
                            <Button Content="Reset All"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Margin="0,4,0,8"
                                    Padding="0,8"
                                    Click="OnResetAllClick" />

                            <!-- ── ASPECT RATIO ── -->
                            <Grid Margin="0,4,0,0" ColumnDefinitions="Auto,*,Auto">
                                <!-- Reset + label -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Classes="flat"
                                            ToolTip.Tip="Reset Aspect Ratio"
                                            Click="OnAspectResetClick"
                                            Padding="4">
                                        <Path Data="M 3 9 L 6 12 L 9 9 M 6 12 V 4 M 3 5 L 3 3 L 5 3"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="{StaticResource OsdForeground}" Stroke="{StaticResource OsdForeground}" StrokeThickness="1" />
                                    </Button>
                                    <TextBlock Text="Aspect Ratio"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               Foreground="{StaticResource OsdForeground}" />
                                </StackPanel>
                                <!-- Aspect ComboBox -->
                                <ComboBox Grid.Column="2"
                                          x:Name="AspectRatioCombo"
                                          Width="110"
                                          FontSize="12"
                                          SelectionChanged="OnAspectRatioChanged">
                                    <ComboBoxItem Tag="-1" Content="Original" IsSelected="True" />
                                    <ComboBoxItem Tag="1.7778" Content="16:9" />
                                    <ComboBoxItem Tag="1.3333" Content="4:3" />
                                    <ComboBoxItem Tag="1.0" Content="1:1" />
                                    <ComboBoxItem Tag="1.6" Content="16:10" />
                                    <ComboBoxItem Tag="2.21" Content="2.21:1" />
                                    <ComboBoxItem Tag="2.35" Content="2.35:1" />
                                    <ComboBoxItem Tag="2.39" Content="2.39:1" />
                                    <ComboBoxItem Tag="1.25" Content="5:4" />
                                </ComboBox>
                            </Grid>

                            <!-- ── ROTATE ── -->
                            <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Classes="flat"
                                            ToolTip.Tip="Reset Rotation"
                                            Click="OnRotateResetClick"
                                            Padding="4">
                                        <Path Data="M 3 9 L 6 12 L 9 9 M 6 12 V 4 M 3 5 L 3 3 L 5 3"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="{StaticResource OsdForeground}" Stroke="{StaticResource OsdForeground}" StrokeThickness="1" />
                                    </Button>
                                    <TextBlock Text="Rotate"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               Foreground="{StaticResource OsdForeground}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                    <Button Width="50" Height="30" FontSize="11"
                                            Content="↺ L"
                                            ToolTip.Tip="Rotate Left 90°"
                                            Click="OnRotateLeftClick" />
                                    <Button Width="50" Height="30" FontSize="11"
                                            Content="R ↻"
                                            ToolTip.Tip="Rotate Right 90°"
                                            Click="OnRotateRightClick" />
                                </StackPanel>
                            </Grid>

                            <!-- ── FLIP ── -->
                            <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Classes="flat"
                                            ToolTip.Tip="Reset Flip"
                                            Click="OnFlipResetClick"
                                            Padding="4">
                                        <Path Data="M 3 9 L 6 12 L 9 9 M 6 12 V 4 M 3 5 L 3 3 L 5 3"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="{StaticResource OsdForeground}" Stroke="{StaticResource OsdForeground}" StrokeThickness="1" />
                                    </Button>
                                    <TextBlock Text="Flip"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               Foreground="{StaticResource OsdForeground}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                    <Button Width="50" Height="30" FontSize="11"
                                            Content="⇔ H"
                                            ToolTip.Tip="Flip Horizontally"
                                            Click="OnFlipHorizontalClick" />
                                    <Button Width="50" Height="30" FontSize="11"
                                            Content="V ⇕"
                                            ToolTip.Tip="Flip Vertically"
                                            Click="OnFlipVerticalClick" />
                                </StackPanel>
                            </Grid>

                            <!-- ── ZOOM ── -->
                            <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Classes="flat"
                                            ToolTip.Tip="Reset Zoom"
                                            Click="OnZoomResetClick"
                                            Padding="4">
                                        <Path Data="M 3 9 L 6 12 L 9 9 M 6 12 V 4 M 3 5 L 3 3 L 5 3"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="{StaticResource OsdForeground}" Stroke="{StaticResource OsdForeground}" StrokeThickness="1" />
                                    </Button>
                                    <TextBlock Text="Zoom"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               Foreground="{StaticResource OsdForeground}" />
                                </StackPanel>
                                <NumericUpDown Grid.Column="2"
                                              x:Name="ZoomSpin"
                                              Value="{Binding ZoomValue}"
                                              Minimum="-3"
                                              Maximum="3"
                                              Increment="0.05"
                                              FormatString="0.00"
                                              Width="110"
                                              FontSize="12" />
                            </Grid>

                            <!-- ── CONTRAST ── -->
                            <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Classes="flat"
                                            ToolTip.Tip="Reset Contrast"
                                            Click="OnResetContrastClick"
                                            Padding="4">
                                        <Path Data="M 3 9 L 6 12 L 9 9 M 6 12 V 4 M 3 5 L 3 3 L 5 3"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="{StaticResource OsdForeground}" Stroke="{StaticResource OsdForeground}" StrokeThickness="1" />
                                    </Button>
                                    <TextBlock Text="Contrast"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               Foreground="{StaticResource OsdForeground}" />
                                </StackPanel>
                                <NumericUpDown Grid.Column="2"
                                              Value="{Binding ContrastValue}"
                                              Minimum="-100"
                                              Maximum="100"
                                              Increment="1"
                                              FormatString="0"
                                              Width="110"
                                              FontSize="12" />
                            </Grid>

                            <!-- ── BRIGHTNESS ── -->
                            <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Classes="flat"
                                            ToolTip.Tip="Reset Brightness"
                                            Click="OnResetBrightnessClick"
                                            Padding="4">
                                        <Path Data="M 3 9 L 6 12 L 9 9 M 6 12 V 4 M 3 5 L 3 3 L 5 3"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="{StaticResource OsdForeground}" Stroke="{StaticResource OsdForeground}" StrokeThickness="1" />
                                    </Button>
                                    <TextBlock Text="Brightness"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               Foreground="{StaticResource OsdForeground}" />
                                </StackPanel>
                                <NumericUpDown Grid.Column="2"
                                              Value="{Binding BrightnessValue}"
                                              Minimum="-100"
                                              Maximum="100"
                                              Increment="1"
                                              FormatString="0"
                                              Width="110"
                                              FontSize="12" />
                            </Grid>

                            <!-- ── GAMMA ── -->
                            <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Classes="flat"
                                            ToolTip.Tip="Reset Gamma"
                                            Click="OnResetGammaClick"
                                            Padding="4">
                                        <Path Data="M 3 9 L 6 12 L 9 9 M 6 12 V 4 M 3 5 L 3 3 L 5 3"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="{StaticResource OsdForeground}" Stroke="{StaticResource OsdForeground}" StrokeThickness="1" />
                                    </Button>
                                    <TextBlock Text="Gamma"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               Foreground="{StaticResource OsdForeground}" />
                                </StackPanel>
                                <NumericUpDown Grid.Column="2"
                                              Value="{Binding GammaValue}"
                                              Minimum="-100"
                                              Maximum="100"
                                              Increment="1"
                                              FormatString="0"
                                              Width="110"
                                              FontSize="12" />
                            </Grid>

                            <!-- ── SATURATION ── -->
                            <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Classes="flat"
                                            ToolTip.Tip="Reset Saturation"
                                            Click="OnResetSaturationClick"
                                            Padding="4">
                                        <Path Data="M 3 9 L 6 12 L 9 9 M 6 12 V 4 M 3 5 L 3 3 L 5 3"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="{StaticResource OsdForeground}" Stroke="{StaticResource OsdForeground}" StrokeThickness="1" />
                                    </Button>
                                    <TextBlock Text="Saturation"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               Foreground="{StaticResource OsdForeground}" />
                                </StackPanel>
                                <NumericUpDown Grid.Column="2"
                                              Value="{Binding SaturationValue}"
                                              Minimum="-100"
                                              Maximum="100"
                                              Increment="1"
                                              FormatString="0"
                                              Width="110"
                                              FontSize="12" />
                            </Grid>

                            <!-- ── HUE ── -->
                            <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Classes="flat"
                                            ToolTip.Tip="Reset Hue"
                                            Click="OnResetHueClick"
                                            Padding="4">
                                        <Path Data="M 3 9 L 6 12 L 9 9 M 6 12 V 4 M 3 5 L 3 3 L 5 3"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="{StaticResource OsdForeground}" Stroke="{StaticResource OsdForeground}" StrokeThickness="1" />
                                    </Button>
                                    <TextBlock Text="Hue"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               Foreground="{StaticResource OsdForeground}" />
                                </StackPanel>
                                <NumericUpDown Grid.Column="2"
                                              Value="{Binding HueValue}"
                                              Minimum="-100"
                                              Maximum="100"
                                              Increment="1"
                                              FormatString="0"
                                              Width="110"
                                              FontSize="12" />
                            </Grid>

                            <!-- ── SUBTITLE DELAY ── -->
                            <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Classes="flat"
                                            ToolTip.Tip="Reset Subtitle Delay"
                                            Click="OnResetSubtitleDelayClick"
                                            Padding="4">
                                        <Path Data="M 3 9 L 6 12 L 9 9 M 6 12 V 4 M 3 5 L 3 3 L 5 3"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="{StaticResource OsdForeground}" Stroke="{StaticResource OsdForeground}" StrokeThickness="1" />
                                    </Button>
                                    <TextBlock Text="Sub Delay"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               Foreground="{StaticResource OsdForeground}" />
                                </StackPanel>
                                <NumericUpDown Grid.Column="2"
                                              Value="{Binding SubtitleDelayValue}"
                                              Minimum="-999.9"
                                              Maximum="999.9"
                                              Increment="0.1"
                                              FormatString="0.0"
                                              Width="110"
                                              FontSize="12" />
                            </Grid>

                            <!-- ── SUB SIZE ── -->
                            <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Classes="flat"
                                            ToolTip.Tip="Reset Subtitle Size"
                                            Click="OnResetSubSizeClick"
                                            Padding="4">
                                        <Path Data="M 3 9 L 6 12 L 9 9 M 6 12 V 4 M 3 5 L 3 3 L 5 3"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="{StaticResource OsdForeground}" Stroke="{StaticResource OsdForeground}" StrokeThickness="1" />
                                    </Button>
                                    <TextBlock Text="Sub Size"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               Foreground="{StaticResource OsdForeground}" />
                                </StackPanel>
                                <NumericUpDown Grid.Column="2"
                                              Value="{Binding SubtitleFontSize}"
                                              Minimum="8"
                                              Maximum="72"
                                              Increment="2"
                                              FormatString="0"
                                              Width="110"
                                              FontSize="12" />
                            </Grid>

                            <!-- ── AUDIO DELAY ── -->
                            <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Classes="flat"
                                            ToolTip.Tip="Reset Audio Delay"
                                            Click="OnResetAudioDelayClick"
                                            Padding="4">
                                        <Path Data="M 3 9 L 6 12 L 9 9 M 6 12 V 4 M 3 5 L 3 3 L 5 3"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="{StaticResource OsdForeground}" Stroke="{StaticResource OsdForeground}" StrokeThickness="1" />
                                    </Button>
                                    <TextBlock Text="Audio Delay"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               Foreground="{StaticResource OsdForeground}" />
                                </StackPanel>
                                <NumericUpDown Grid.Column="2"
                                              Value="{Binding AudioDelayValue}"
                                              Minimum="-999.9"
                                              Maximum="999.9"
                                              Increment="0.1"
                                              FormatString="0.0"
                                              Width="110"
                                              FontSize="12" />
                            </Grid>

                            <!-- ── PLAYBACK SPEED (Pills) ── -->
                            <Grid Margin="0,8,0,8" ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Classes="flat"
                                            ToolTip.Tip="Reset Speed"
                                            Click="OnResetSpeedClick"
                                            Padding="4">
                                        <Path Data="M 3 9 L 6 12 L 9 9 M 6 12 V 4 M 3 5 L 3 3 L 5 3"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="{StaticResource OsdForeground}" Stroke="{StaticResource OsdForeground}" StrokeThickness="1" />
                                    </Button>
                                    <TextBlock Text="Speed"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               Foreground="{StaticResource OsdForeground}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3">
                                    <Button x:Name="Speed05" Content="0.5×" Width="38" Height="26" FontSize="10" Click="OnSpeedPillClick" Tag="0.5" />
                                    <Button x:Name="Speed075" Content="0.75×" Width="42" Height="26" FontSize="10" Click="OnSpeedPillClick" Tag="0.75" />
                                    <Button x:Name="Speed10" Content="1.0×" Width="38" Height="26" FontSize="10" Click="OnSpeedPillClick" Tag="1.0" />
                                    <Button x:Name="Speed125" Content="1.25×" Width="42" Height="26" FontSize="10" Click="OnSpeedPillClick" Tag="1.25" />
                                    <Button x:Name="Speed15" Content="1.5×" Width="38" Height="26" FontSize="10" Click="OnSpeedPillClick" Tag="1.5" />
                                    <Button x:Name="Speed20" Content="2.0×" Width="38" Height="26" FontSize="10" Click="OnSpeedPillClick" Tag="2.0" />
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
