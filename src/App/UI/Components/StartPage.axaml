<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cine.Avalonia.ViewModels"
             x:Class="Cine.Avalonia.Controls.StartPage"
             x:DataType="vm:MainViewModel">

    <!-- Start Page / Welcome Screen matching Python GTK4 drag-and-drop behavior -->
    <Border x:Name="StartPageRoot"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Background="{DynamicResource StartPageBackground}"
            CornerRadius="0"
            IsVisible="False">

        <Border x:Name="DropTarget"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="480" Height="320"
                CornerRadius="16"
                BorderThickness="2"
                BorderBrush="#40FFFFFF"
                Background="#20FFFFFF"
                IsHitTestVisible="True">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="16">

                <!-- Film icon -->
                <TextBlock Text="🎬"
                           FontSize="48"
                           HorizontalAlignment="Center"
                           Opacity="0.6" />

                <!-- Drop text -->
                <TextBlock Text="Drop video files here"
                           FontFamily="{StaticResource SystemFont}"
                           FontSize="18"
                           FontWeight="Medium"
                           Foreground="{StaticResource OsdForeground}"
                           HorizontalAlignment="Center"
                           Opacity="0.8" />

                <!-- Subtitle -->
                <TextBlock Text="or click the button below"
                           FontFamily="{StaticResource SystemFont}"
                           FontSize="13"
                           Foreground="{StaticResource OsdForeground}"
                           HorizontalAlignment="Center"
                           Opacity="0.5" />

                <!-- Open button -->
                <Button x:Name="BtnOpenFile"
                        Classes="circular-transport"
                        Content="Open..."
                        Width="140" Height="40"
                        Background="#FFE5E5E5"
                        Foreground="Black"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0"
                        Click="BtnOpenFile_Click" />

                <Button x:Name="BtnOpenFolder"
                        Classes="circular-transport"
                        Content="Open Folder"
                        Width="140" Height="40"
                        Background="#1FFFFFFF"
                        Foreground="{StaticResource OsdForeground}"
                        HorizontalAlignment="Center"
                        Click="BtnOpenFolder_Click" />
            </StackPanel>
        </Border>
    </Border>
</UserControl>
