<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cine.Avalonia.ViewModels"
             x:Class="Cine.Avalonia.Controls.StartPage"
             x:DataType="vm:MainViewModel">

    <!-- Start Page / Welcome Screen matching Python GTK4 behavior -->
    <Border x:Name="StartPageRoot"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Background="{DynamicResource StartPageBackground}"
            CornerRadius="0">

        <Grid>
            <!-- Drop Target Overlay Visuals -->
            <Border x:Name="DropTarget"
                    Margin="12"
                    BorderThickness="2"
                    CornerRadius="12"
                    BorderBrush="#40FFFFFF"
                    Background="#20FFFFFF"
                    IsHitTestVisible="False"
                    IsVisible="False" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12" Margin="0,48,0,0">

                <!-- Icon (Cine app icon — circle + triangle per canvas) -->
                <Panel Width="128" Height="128" Margin="0,0,0,24" HorizontalAlignment="Center">
                    <Path Data="M 64 4 A 60 60 0 1 1 64 124 A 60 60 0 1 1 64 4 Z"
                          Fill="#14FFFFFF"
                          Stroke="#26FFFFFF"
                          StrokeThickness="2" />
                    <Path Data="M 50 40 L 90 64 L 50 88 Z"
                          Fill="#E5E5E5" />
                </Panel>

                <!-- Drop text -->
                <TextBlock Text="Drag and Drop Files Here"
                           FontFamily="{StaticResource SystemFont}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#E5E5E5"
                           HorizontalAlignment="Center"
                           LetterSpacing="-0.01"
                           Margin="0,0,0,24" />

                <!-- Open button (suggested-action pill) -->
                <Button x:Name="BtnOpenFile"
                        Classes="start-page-button start-page-suggested-action"
                        Content="Open…"
                        Padding="32,0"
                        HorizontalAlignment="Center"
                        Click="BtnOpenFile_Click" />

                <!-- Open Folder button (pill) -->
                <Button x:Name="BtnOpenFolder"
                        Classes="start-page-button"
                        Content="Open Folder"
                        Padding="32,0"
                        HorizontalAlignment="Center"
                        Click="BtnOpenFolder_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
