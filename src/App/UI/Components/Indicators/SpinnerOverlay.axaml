<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cine.Avalonia.Components.SpinnerOverlay">

    <UserControl.Resources>
        <!-- Spinner active arc gradient — accent on left → lighter accent on right -->
        <LinearGradientBrush x:Key="SpinnerArcGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="{StaticResource Accent}" />
            <GradientStop Offset="0.5" Color="{StaticResource AccentHover}" />
            <GradientStop Offset="1" Color="#FF7FB8FF" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid Width="48" Height="48"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          IsHitTestVisible="False">
        <Border x:Name="SpinnerTrack"
                Width="48" Height="48"
                CornerRadius="24"
                BorderThickness="3"
                BorderBrush="{StaticResource AppHover}"
                Background="Transparent"
                IsVisible="False" />
        <Border x:Name="LoadingSpinner"
                Classes="loading-spinner"
                Width="48" Height="48"
                CornerRadius="24"
                BorderThickness="3"
                BorderBrush="{StaticResource SpinnerArcGradient}"
                Background="Transparent"
                IsVisible="False"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <RotateTransform Angle="0" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" OffsetY="0" Color="#4D5B9BD5" />
            </Border.Effect>
        </Border>
    </Grid>
</UserControl>
