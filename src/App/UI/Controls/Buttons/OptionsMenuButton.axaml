<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cine.Avalonia.ViewModels"
             x:Class="Cine.Avalonia.Components.OptionsMenuButton"
             x:DataType="vm:MainViewModel">

    <Button x:Name="BtnOptionsMenu"
            Classes="circular-menu"
            ToolTip.Tip="Options"
            Margin="2">
        <Path Data="{StaticResource OptionsIcon}"
              Width="16" Height="16" Stretch="Uniform"
              Stroke="{StaticResource OsdForeground}"
              StrokeThickness="1.4"
              StrokeLineCap="Round" />
        <Button.Flyout>
            <Flyout Placement="Top">
                <Border Background="{StaticResource PopoverBackground}"
                        BorderBrush="{StaticResource PopoverBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="0"
                        Width="290">
                    <!-- Tabbed Options -->
                    <TabControl Classes="options-tabs" Margin="0">
                        <TabItem Header="Video" FontSize="12">
                            <ScrollViewer MaxHeight="360"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="6" Margin="8">
                                    <Button Content="Reset Video Settings"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Padding="0,6"
                                            Click="OnResetVideoClick" />

                                    <!-- Aspect Ratio -->
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="Aspect" FontSize="11" VerticalAlignment="Center" Width="60"
                                                   Foreground="{StaticResource OsdForeground}" />
                                        <ComboBox x:Name="AspectRatioCombo" Grid.Column="1"
                                                  FontSize="11" Height="26"
                                                  SelectionChanged="OnAspectRatioChanged">
                                            <ComboBoxItem Tag="-1" Content="Original" IsSelected="True" />
                                            <ComboBoxItem Tag="1.7778" Content="16:9" />
                                            <ComboBoxItem Tag="1.3333" Content="4:3" />
                                            <ComboBoxItem Tag="2.35" Content="2.35:1" />
                                            <ComboBoxItem Tag="1.0" Content="1:1" />
                                        </ComboBox>
                                    </Grid>

                                    <!-- Rotate + Flip -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Rotate" FontSize="11" VerticalAlignment="Center" Width="60"
                                                   Foreground="{StaticResource OsdForeground}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3"
                                                    HorizontalAlignment="Right">
                                            <Button Width="40" Height="24" FontSize="10" Content="↺ L"
                                                    Click="OnRotateLeftClick" />
                                            <Button Width="40" Height="24" FontSize="10" Content="R ↻"
                                                    Click="OnRotateRightClick" />
                                            <Button Width="40" Height="24" FontSize="10" Content="⇔ H"
                                                    Click="OnFlipHorizontalClick" />
                                            <Button Width="40" Height="24" FontSize="10" Content="V ⇕"
                                                    Click="OnFlipVerticalClick" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Brightness Slider -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="Brightness" FontSize="11" Width="60"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource OsdForeground}" />
                                        <Slider Grid.Column="1" Value="{Binding BrightnessValue}"
                                                Minimum="-100" Maximum="100" Height="24" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding BrightnessValue, StringFormat='{}{0:+0;−0;0}'}"
                                                   FontSize="11" Width="30" TextAlignment="Right"
                                                   Foreground="{StaticResource OsdForeground}" />
                                    </Grid>

                                    <!-- Contrast Slider -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="Contrast" FontSize="11" Width="60"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource OsdForeground}" />
                                        <Slider Grid.Column="1" Value="{Binding ContrastValue}"
                                                Minimum="-100" Maximum="100" Height="24" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ContrastValue, StringFormat='{}{0:+0;−0;0}'}"
                                                   FontSize="11" Width="30" TextAlignment="Right"
                                                   Foreground="{StaticResource OsdForeground}" />
                                    </Grid>

                                    <!-- Gamma Slider -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="Gamma" FontSize="11" Width="60"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource OsdForeground}" />
                                        <Slider Grid.Column="1" Value="{Binding GammaValue}"
                                                Minimum="-100" Maximum="100" Height="24" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding GammaValue, StringFormat='{}{0:+0;−0;0}'}"
                                                   FontSize="11" Width="30" TextAlignment="Right"
                                                   Foreground="{StaticResource OsdForeground}" />
                                    </Grid>

                                    <!-- Saturation Slider -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="Saturation" FontSize="11" Width="60"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource OsdForeground}" />
                                        <Slider Grid.Column="1" Value="{Binding SaturationValue}"
                                                Minimum="-100" Maximum="100" Height="24" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SaturationValue, StringFormat='{}{0:+0;−0;0}'}"
                                                   FontSize="11" Width="30" TextAlignment="Right"
                                                   Foreground="{StaticResource OsdForeground}" />
                                    </Grid>

                                    <!-- Hue Slider -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="Hue" FontSize="11" Width="60"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource OsdForeground}" />
                                        <Slider Grid.Column="1" Value="{Binding HueValue}"
                                                Minimum="-100" Maximum="100" Height="24" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding HueValue, StringFormat='{}{0:+0;−0;0}'}"
                                                   FontSize="11" Width="30" TextAlignment="Right"
                                                   Foreground="{StaticResource OsdForeground}" />
                                    </Grid>

                                    <!-- Zoom Slider -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="Zoom" FontSize="11" Width="60"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource OsdForeground}" />
                                        <Slider Grid.Column="1" Value="{Binding ZoomValue}"
                                                Minimum="-3" Maximum="3" Height="24" TickFrequency="0.05" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ZoomValue, StringFormat='0.00'}"
                                                   FontSize="11" Width="30" TextAlignment="Right"
                                                   Foreground="{StaticResource OsdForeground}" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Audio" FontSize="12">
                            <ScrollViewer MaxHeight="360"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8" Margin="8">
                                    <Button Content="Reset Audio Settings"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Padding="0,6"
                                            Click="OnResetAudioClick" />

                                    <!-- Audio Delay Slider -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="Delay" FontSize="11" Width="60"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource OsdForeground}" />
                                        <Slider Grid.Column="1" Value="{Binding AudioDelayValue}"
                                                Minimum="-999.9" Maximum="999.9" Height="24" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding AudioDelayValue, StringFormat='0.0s'}"
                                                   FontSize="11" Width="40" TextAlignment="Right"
                                                   Foreground="{StaticResource OsdForeground}" />
                                    </Grid>

                                    <!-- Speed Pills -->
                                    <TextBlock Text="Speed" FontSize="11"
                                               Foreground="{StaticResource OsdForeground}" />
                                    <WrapPanel HorizontalAlignment="Stretch">
                                        <Button x:Name="Speed05" Content="0.5×" Width="52" Height="28" Margin="0,0,4,4"
                                                FontSize="11" Click="OnSpeedPillClick" Tag="0.5" />
                                        <Button x:Name="Speed075" Content="0.75×" Width="52" Height="28" Margin="0,0,4,4"
                                                FontSize="11" Click="OnSpeedPillClick" Tag="0.75" />
                                        <Button x:Name="Speed10" Content="1.0×" Width="52" Height="28" Margin="0,0,4,4"
                                                FontSize="11" Click="OnSpeedPillClick" Tag="1.0" />
                                        <Button x:Name="Speed125" Content="1.25×" Width="52" Height="28" Margin="0,0,4,4"
                                                FontSize="11" Click="OnSpeedPillClick" Tag="1.25" />
                                        <Button x:Name="Speed15" Content="1.5×" Width="52" Height="28" Margin="0,0,4,4"
                                                FontSize="11" Click="OnSpeedPillClick" Tag="1.5" />
                                        <Button x:Name="Speed20" Content="2.0×" Width="52" Height="28"
                                                FontSize="11" Click="OnSpeedPillClick" Tag="2.0" />
                                    </WrapPanel>

                                    <!-- Dialogue Boost -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Dialogue Boost" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource OsdForeground}" />
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding IsDialogueBoostEnabled}"
                                                      OnContent="" OffContent="" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Subtitles" FontSize="12">
                            <ScrollViewer MaxHeight="360"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8" Margin="8">
                                    <Button Content="Reset Subtitle Settings"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Padding="0,6"
                                            Click="OnResetSubtitleClick" />

                                    <!-- Subtitle Delay Slider -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="Delay" FontSize="11" Width="60"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource OsdForeground}" />
                                        <Slider Grid.Column="1" Value="{Binding SubtitleDelayValue}"
                                                Minimum="-999.9" Maximum="999.9" Height="24" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SubtitleDelayValue, StringFormat='0.0s'}"
                                                   FontSize="11" Width="40" TextAlignment="Right"
                                                   Foreground="{StaticResource OsdForeground}" />
                                    </Grid>

                                    <!-- Subtitle Size Slider -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="Size" FontSize="11" Width="60"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource OsdForeground}" />
                                        <Slider Grid.Column="1" Value="{Binding SubtitleFontSize}"
                                                Minimum="8" Maximum="72" Height="24" TickFrequency="2" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SubtitleFontSize, StringFormat='{}{0:F0}px'}"
                                                   FontSize="11" Width="40" TextAlignment="Right"
                                                   Foreground="{StaticResource OsdForeground}" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
