<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cine.Avalonia.ViewModels"
             x:Class="Cine.Avalonia.Controls.SeekBarControl"
             x:DataType="vm:MainViewModel"
             x:Name="SeekBarRoot"
             Height="37">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">

        <!-- Seek Area (hexpand, with chapter markers) -->
        <Grid Grid.Column="0"
              x:Name="SeekArea"
              Margin="8,0,3,0"
              PointerMoved="OnSeekAreaPointerMoved"
              PointerExited="OnSeekAreaPointerExited"
              PointerWheelChanged="OnSeekAreaPointerWheelChanged"
              PointerPressed="OnSeekAreaPointerPressed"
              PointerReleased="OnSeekAreaPointerReleased"
              Background="Transparent">

            <Border x:Name="SeekTrack"
                    Background="{StaticResource ProgressTroughBackground}"
                    CornerRadius="2"
                    Height="4"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False" />

            <Border x:Name="SeekFill"
                    Background="{StaticResource ProgressSliderBackground}"
                    CornerRadius="2"
                    Height="4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" OffsetY="0" Color="#400078D4" />
                </Border.Effect>
            </Border>

            <Border x:Name="SeekThumb"
                    Width="16" Height="16"
                    CornerRadius="8"
                    Background="{StaticResource ProgressSliderBackground}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" OffsetY="1" Color="#80000000" />
                </Border.Effect>
                <Border.Styles>
                    <Style Selector="Border:pointerover">
                        <Setter Property="Width" Value="20" />
                        <Setter Property="Height" Value="20" />
                        <Setter Property="CornerRadius" Value="10" />
                    </Style>
                </Border.Styles>
            </Border>

            <ItemsControl x:Name="ChapterMarkersControl"
                          ItemsSource="{Binding ChapterMarkers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas IsHitTestVisible="False" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Rectangle Width="2" Height="10"
                                   Fill="{StaticResource OsdForeground}"
                                   Opacity="0.5" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="ChapterPreviewPopover"
                    IsVisible="False"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{StaticResource PopoverBackground}"
                    BorderBrush="{StaticResource PopoverBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,4"
                    Margin="0,-34,0,0"
                    BoxShadow="0 4 12 0 #80000000">
                <TextBlock x:Name="ChapterPreviewText"
                           Text="Chapter"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{StaticResource OsdForeground}" />
            </Border>
        </Grid>

        <TextBlock Grid.Column="1"
                   x:Name="PositionTimeLabel"
                   Classes="time-label"
                   MinWidth="45"
                   Text="{Binding PositionText, Mode=OneWay}"
                   VerticalAlignment="Center"
                   Margin="4,0,0,0"
                   PointerPressed="OnPositionTimeLabelPressed"
                   Cursor="Hand" />

        <Border Grid.Column="2"
                Width="2" Height="16"
                Margin="10,0"
                CornerRadius="2"
                Background="{StaticResource TimeSeparatorBackground}"
                Opacity="0.4"
                VerticalAlignment="Center" />

        <TextBlock Grid.Column="3"
                   x:Name="DurationTimeLabel"
                   Classes="time-label"
                   MinWidth="45"
                   Text="{Binding DurationText, Mode=OneWay}"
                   Margin="0,0,4,0"
                   VerticalAlignment="Center" />
    </Grid>
</UserControl>
