<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cine.Avalonia.Controls.FlyoutOverlayControl"
             IsHitTestVisible="False"
             Opacity="0">
    <Border x:Name="OverlayBackground"
            Background="#14000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            PointerPressed="OnBackgroundPointerPressed"
            KeyDown="OnBackgroundKeyDown">
        <Canvas>
            <Border x:Name="ContentContainer"
                    UseLayoutRounding="True"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Opacity="0">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.180" Easing="ExponentialEaseOut" />
                    </Transitions>
                </Border.Transitions>
            </Border>
        </Canvas>
    </Border>
</UserControl>