<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:transitions="using:Avalonia.Animation.Transitions"
             x:Class="Cine.Avalonia.Controls.FlyoutOverlayControl"
             IsVisible="False"
             IsHitTestVisible="True"
             Background="Transparent">
    <!-- Transparent full-window overlay that hosts flyout content
         at the window level, bypassing the broken Popup overlay layer.
         PointerPressed on the transparent background dismisses the flyout. -->
    <Border x:Name="OverlayBackground"
            Background="Transparent"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            PointerPressed="OnBackgroundPointerPressed"
            KeyDown="OnBackgroundKeyDown">
        <!-- Canvas wrapper so Canvas.SetLeft/Top works for flyout positioning -->
        <Canvas>
            <Border x:Name="ContentContainer"
                    UseLayoutRounding="True"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                </Border.RenderTransform>
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="ExponentialEaseOut" />
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="ExponentialEaseOut"/>
                    </Transitions>
                </Border.Transitions>
            </Border>
        </Canvas>
    </Border>
</UserControl>
