<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="280"
             x:Class="Cine.Avalonia.Controls.Subtitle.SubtitleStyleFlyout">
  <Border Background="{DynamicResource PopoverBackground}"
          BorderBrush="{DynamicResource PopoverBorder}"
          BorderThickness="1"
          Padding="{StaticResource space-2}"
          MinWidth="{StaticResource size-dialog-min-width-flyout}"
          MaxWidth="{StaticResource size-flyout-subtitle-max}"
          CornerRadius="{StaticResource radius-sm}">
    <StackPanel Spacing="{StaticResource space-spacing-2}">
      <!-- ════════ Header ════════ -->
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Subtitle Settings"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource OsdForeground}"
                   VerticalAlignment="Center"/>
        <Button x:Name="CloseBtn"
                Grid.Column="1"
                Content="✕"
                Width="{StaticResource size-button-flat}" Height="{StaticResource size-button-flat}"
                CornerRadius="{StaticResource radius-full}"
                Background="Transparent"
                BorderThickness="0"
                Foreground="{DynamicResource OsdForeground}"
                FontSize="12"
                Cursor="Hand"/>
      </Grid>

      <Separator Background="{DynamicResource PopoverBorder}" Height="1" Margin="0,0,0,4"/>

      <!-- ════════ Subtitle Toggle ════════ -->
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Subtitles"
                   FontSize="12"
                   Foreground="{DynamicResource OsdForeground}"
                   VerticalAlignment="Center"/>
        <ToggleSwitch x:Name="SubtitleToggle"
                      Grid.Column="1"
                      OffContent="Off"
                      OnContent="On"/>
      </Grid>

      <!-- ════════ Track Selection ════════ -->
      <StackPanel Spacing="{StaticResource space-spacing-0_5}">
        <TextBlock Text="Track"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource OsdForeground}"
                   Opacity="0.5"/>
        <ComboBox x:Name="TrackCombo"
                  FontSize="12"
                  MinHeight="28"
                  Background="{DynamicResource OverlayChrome}"
                  BorderBrush="{DynamicResource PopoverBorder}"
                  BorderThickness="1"
                  CornerRadius="4"
                  PlaceholderText="No subtitles available"
                  HorizontalContentAlignment="Stretch"/>
        <Button x:Name="AddTrackBtn"
                Content="+ Add Subtitle Track…"
                FontSize="11"
                Foreground="{DynamicResource OsdForeground}"
                Opacity="0.7"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                HorizontalContentAlignment="Left"
                Cursor="Hand"
                Height="22"/>
      </StackPanel>

      <!-- ════════ Font Size ════════ -->
      <StackPanel Spacing="{StaticResource space-spacing-0_5}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Font Size"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource OsdForeground}"
                     Opacity="0.5"/>
          <TextBlock x:Name="FontSizeValue"
                     Grid.Column="1"
                     FontSize="11"
                     Foreground="{DynamicResource OsdForeground}"
                     Text="1.0×"/>
        </Grid>
        <Slider x:Name="FontSizeSlider"
                Minimum="0.5"
                Maximum="3.0"
                Value="1.0"
                TickFrequency="0.1"
                IsSnapToTickEnabled="True"
                Height="{StaticResource size-seek-slider-height}"/>
      </StackPanel>

      <!-- ════════ Position ════════ -->
      <StackPanel Spacing="{StaticResource space-spacing-0_5}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Position"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource OsdForeground}"
                     Opacity="0.5"/>
          <TextBlock x:Name="PositionValue"
                     Grid.Column="1"
                     FontSize="11"
                     Foreground="{DynamicResource OsdForeground}"
                     Text="100%"/>
        </Grid>
        <Slider x:Name="PositionSlider"
                Minimum="0"
                Maximum="100"
                Value="100"
                TickFrequency="1"
                Height="{StaticResource size-seek-slider-height}"/>
      </StackPanel>

      <!-- ════════ Delay ════════ -->
      <StackPanel Spacing="{StaticResource space-spacing-0_5}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Delay"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource OsdForeground}"
                     Opacity="0.5"/>
          <TextBlock x:Name="DelayValue"
                     Grid.Column="1"
                     FontSize="11"
                     Foreground="{DynamicResource OsdForeground}"
                     Text="0.0s"/>
        </Grid>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <Button x:Name="DelayMinusBtn"
                  Content="−"
                  Width="24" Height="24"
                  CornerRadius="12"
                  Background="Transparent"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource PopoverBorder}"
                  Foreground="{DynamicResource OsdForeground}"
                  FontSize="14"
                  Cursor="Hand"/>
          <Slider x:Name="DelaySlider"
                  Grid.Column="1"
                  Minimum="-10"
                  Maximum="10"
                  Value="0"
                  TickFrequency="0.5"
                  IsSnapToTickEnabled="True"
                  Margin="4,0"
                  Height="{StaticResource size-seek-slider-height}"/>
          <Button x:Name="DelayPlusBtn"
                  Grid.Column="2"
                  Content="+"
                  Width="24" Height="24"
                  CornerRadius="12"
                  Background="Transparent"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource PopoverBorder}"
                  Foreground="{DynamicResource OsdForeground}"
                  FontSize="14"
                  Cursor="Hand"/>
          <Button x:Name="DelayResetBtn"
                  Grid.Column="3"
                  Content="Reset"
                  FontSize="10"
                  Foreground="{DynamicResource OsdForeground}"
                  Opacity="0.6"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="6,2"
                  Cursor="Hand"
                  Margin="4,0,0,0"/>
        </Grid>
      </StackPanel>

      <!-- ════════ Font Family ════════ -->
      <StackPanel Spacing="{StaticResource space-spacing-0_5}">
        <TextBlock Text="Font"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource OsdForeground}"
                   Opacity="0.5"/>
        <ComboBox x:Name="FontCombo"
                  FontSize="12"
                  MinHeight="28"
                  Background="{DynamicResource OverlayChrome}"
                  BorderBrush="{DynamicResource PopoverBorder}"
                  BorderThickness="1"
                  CornerRadius="4"/>
      </StackPanel>

      <!-- ════════ Border Size ════════ -->
      <StackPanel Spacing="{StaticResource space-spacing-0_5}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Border"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource OsdForeground}"
                     Opacity="0.5"/>
          <TextBlock x:Name="BorderValue"
                     Grid.Column="1"
                     FontSize="11"
                     Foreground="{DynamicResource OsdForeground}"
                     Text="2.0"/>
        </Grid>
        <Slider x:Name="BorderSlider"
                Minimum="0"
                Maximum="5"
                Value="2"
                TickFrequency="0.5"
                IsSnapToTickEnabled="True"
                Height="{StaticResource size-seek-slider-height}"/>
      </StackPanel>

      <!-- ════════ Shadow Offset ════════ -->
      <StackPanel Spacing="{StaticResource space-spacing-0_5}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Shadow"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource OsdForeground}"
                     Opacity="0.5"/>
          <TextBlock x:Name="ShadowValue"
                     Grid.Column="1"
                     FontSize="11"
                     Foreground="{DynamicResource OsdForeground}"
                     Text="1.0"/>
        </Grid>
        <Slider x:Name="ShadowSlider"
                Minimum="0"
                Maximum="5"
                Value="1"
                TickFrequency="0.5"
                IsSnapToTickEnabled="True"
                Height="{StaticResource size-seek-slider-height}"/>
      </StackPanel>

      <!-- ════════ Color ════════ -->
      <StackPanel Spacing="{StaticResource space-spacing-0_5}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Color"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource OsdForeground}"
                     Opacity="0.5"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Border x:Name="ColorPreview"
                    Width="18" Height="18"
                    CornerRadius="3"
                    BorderBrush="{DynamicResource PopoverBorder}"
                    BorderThickness="1"
                    Background="White"/>
            <TextBox x:Name="ColorInput"
                     Text="#FFFFFF"
                     FontSize="11"
                     MinWidth="60"
                     MaxWidth="90"
                     MinHeight="22"
                     Background="{DynamicResource OverlayChrome}"
                     BorderBrush="{DynamicResource PopoverBorder}"
                     BorderThickness="1"
                     CornerRadius="3"
                     Foreground="{DynamicResource OsdForeground}"/>
          </StackPanel>
        </Grid>
      </StackPanel>

      <Separator Background="{DynamicResource PopoverBorder}" Height="1" Margin="0,4"/>

      <!-- ════════ Reset All ════════ -->
      <Button x:Name="ResetAllBtn"
              Content="Reset to Defaults"
              FontSize="11"
              Foreground="{DynamicResource OsdForeground}"
              Background="Transparent"
              BorderThickness="1"
              BorderBrush="{DynamicResource PopoverBorder}"
              CornerRadius="4"
              Padding="8,6"
              HorizontalContentAlignment="Center"
              Cursor="Hand"/>
    </StackPanel>
  </Border>
</UserControl>
