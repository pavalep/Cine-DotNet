<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cine.Avalonia.Controls.DragDropOverlayControl">
    <Border x:Name="DragDropOverlay"
            IsVisible="False"
            IsHitTestVisible="False"
            Background="{StaticResource AppOverlay}"
            CornerRadius="{StaticResource radius-sm}"
            Margin="12"
            BorderThickness="2"
            BorderBrush="{StaticResource AppAccentDim}"
            BoxShadow="{StaticResource depth-overlay}"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            AutomationProperties.Name="Drop files overlay">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
            </Transitions>
        </Border.Transitions>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
            <materialIcons:MaterialIcon Kind="Play" Width="48" Height="48"
                Foreground="#4aa3ff" />
            <TextBlock Text="Drop to Play" Classes="md3-headline4" FontWeight="SemiBold"
                       Foreground="#4aa3ff" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
