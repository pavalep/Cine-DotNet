<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cine.Avalonia.Controls.OsdNotificationControl">
    <Border x:Name="OsdNotificationBorder"
            IsVisible="False"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,100"
            Padding="16,8"
            CornerRadius="8"
            Background="{StaticResource OsdBackground}"
            PointerPressed="OnOsdNotificationClick">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
            </Transitions>
        </Border.Transitions>
        <TextBlock x:Name="OsdNotificationText"
                   Text=""
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource OsdForeground}" />
    </Border>
</UserControl>
