<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cine.Avalonia.Controls.OsdNotificationControl">
    <Border x:Name="OsdNotificationBorder"
            IsVisible="False"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Padding="16,10,16,10"
            CornerRadius="20"
            Background="{StaticResource OsdBackground}">
        <Border.RenderTransform>
            <TranslateTransform X="0" Y="20" />
        </Border.RenderTransform>
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
            </Transitions>
        </Border.Transitions>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <materialIcons:MaterialIcon x:Name="OsdIcon"
                                        Kind="Information"
                                        Width="18" Height="18"
                                        Foreground="{StaticResource OsdForeground}"
                                        VerticalAlignment="Center"
                                        Opacity="0" />
            <TextBlock x:Name="OsdNotificationText"
                       Text=""
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource OsdForeground}"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
