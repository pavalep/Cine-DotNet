<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cine.Avalonia.Controls.OsdNotificationControl">
    <UserControl.Resources>
        <Thickness x:Key="osd-bottom-margin">0,0,0,110</Thickness>
    </UserControl.Resources>
    <Border x:Name="OsdNotificationBorder"
            IsVisible="False"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="{StaticResource osd-bottom-margin}"
            Padding="16,12"
            CornerRadius="{StaticResource radius-full}"
            Background="{StaticResource OsdBackground}"
            BoxShadow="{StaticResource depth-surface}"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Notification">
        <Border.RenderTransform>
            <TranslateTransform X="0" Y="20" />
        </Border.RenderTransform>
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
            </Transitions>
        </Border.Transitions>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <materialIcons:MaterialIcon x:Name="OsdIcon"
                                        Kind="Information"
                                        Width="18" Height="18"
                                        Foreground="{StaticResource OsdForeground}"
                                        VerticalAlignment="Center"
                                        Opacity="0" />
            <TextBlock x:Name="OsdNotificationText"
                       Text=""
                       Classes="md3-body2"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource OsdForeground}"
                       VerticalAlignment="Center" />
            <ProgressBar x:Name="OsdProgressBar"
                         IsVisible="False"
                         Minimum="0" Maximum="100"
                         Value="0"
                         Width="80"
                         Height="6"
                         CornerRadius="3"
                         Foreground="{StaticResource OsdForeground}"
                         Background="{StaticResource PopoverBorder}"
                         VerticalAlignment="Center"
                         Margin="4,0,0,0" />
        </StackPanel>
    </Border>
</UserControl>
