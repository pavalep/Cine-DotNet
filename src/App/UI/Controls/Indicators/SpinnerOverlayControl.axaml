<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cine.Avalonia.Controls.SpinnerOverlayControl">
    <Grid Width="48" Height="48"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          IsHitTestVisible="False">
        <Border x:Name="SpinnerTrack"
                Width="48" Height="48"
                CornerRadius="24"
                BorderThickness="3"
                BorderBrush="#30FFFFFF"
                Background="Transparent"
                IsVisible="False" />
        <Border x:Name="LoadingSpinner"
                Classes="loading-spinner"
                Width="48" Height="48"
                CornerRadius="24"
                BorderThickness="3"
                BorderBrush="{StaticResource AppAccent}"
                Background="Transparent"
                IsVisible="False"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <RotateTransform Angle="0" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" OffsetY="0" Color="#400078D4" />
            </Border.Effect>
        </Border>
    </Grid>
</UserControl>
