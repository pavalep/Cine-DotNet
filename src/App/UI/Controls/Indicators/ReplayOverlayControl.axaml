<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cine.Avalonia.Controls.ReplayOverlayControl"
             x:Name="ReplayOverlayRoot">
    <Border x:Name="ReplayOverlay"
            ZIndex="30" IsVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{StaticResource AppOverlayLight}" CornerRadius="12" Padding="24">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
            <Button x:Name="BtnReplay"
                    Classes="circular-transport" Width="56" Height="56"
                    Click="OnReplayClick">
                <materialIcons:MaterialIcon Kind="Play" Width="24" Height="24"
                    Foreground="{StaticResource OsdForeground}" />
            </Button>
            <TextBlock Text="Replay" Foreground="White"
                       FontSize="14" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
