<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cine.Avalonia.ViewModels"
        xmlns:conv="using:Cine.Avalonia.Converters"
        xmlns:ctrl="using:Cine.Avalonia.Controls"
        x:Class="Cine.Avalonia.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Cine"
        Width="1280" Height="720"
        MinWidth="640" MinHeight="360"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:TimeSpanToStringConverter x:Key="TimeSpanToString" />
        <conv:PercentConverter x:Key="PercentConverter" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ======================== -->
        <!--  TOP TOOLBAR            -->
        <!-- ======================== -->
        <Border Grid.Row="0" Background="#2D2D30"
                BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="4,0">
                    <Button x:Name="BtnPlayPause"
                            Click="OnPlayPause"
                            ToolTip.Tip="Play / Pause (Space)"
                            Width="32" Height="28">
                        <Path Data="M 8 5V 19L 16 12L 8 5 Z"
                              Stretch="Uniform"
                              Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    </Button>

                    <Button x:Name="BtnStop" Margin="4,0,0,0"
                            Click="OnStop"
                            ToolTip.Tip="Stop"
                            Width="32" Height="28">
                        <Path Data="M 5 4H 9V 20H 5V 4 Z M 13 4H 17V 20H 13V 4 Z"
                              Stretch="Uniform"
                              Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="8,0">
                    <Button x:Name="BtnSeekBack"
                            Click="OnSeekBack"
                            ToolTip.Tip="Seek Backward 5s (Left Arrow)"
                            Width="32" Height="28">
                        <Path Data="M 15.41 7.41L 14 6L 8 12L 14 18L 15.41 16.59L 10.83 12L 15.41 7.41 Z"
                              Stretch="Uniform"
                              Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    </Button>

                    <Button x:Name="BtnSeekForward" Margin="4,0,0,0"
                            Click="OnSeekForward"
                            ToolTip.Tip="Seek Forward 5s (Right Arrow)"
                            Width="32" Height="28">
                        <Path Data="M 10 6L 8.59 7.41L 13.17 12L 8.59 16.59L 10 18L 16 12L 10 6 Z"
                              Stretch="Uniform"
                              Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    </Button>
                </StackPanel>

                <TextBlock Text="Speed:" VerticalAlignment="Center" Margin="12,0,4,0"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                <TextBlock Text="{Binding SpeedValue, StringFormat=F2}x}"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                           FontFamily="Consolas" FontSize="12" />

                <Rectangle Width="1" Height="20" Fill="#3F3F46" Margin="4,0" />

                <StackPanel Orientation="Horizontal" Margin="8,0">
                    <Path Data="M 3 9H 5L 9 5H 11V 19H 9V 15H 5V 9 Z"
                          Width="16" Height="16" Stretch="Uniform"
                          Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                          VerticalAlignment="Center" />
                    <Slider x:Name="VolumeSlider"
                            Minimum="0" Maximum="150" Value="{Binding VolumeValue}"
                            VerticalAlignment="Center" Width="120" />

                    <Button x:Name="BtnMute" Margin="4,0,0,0"
                            Click="OnToggleMute"
                            ToolTip.Tip="Mute (M)"
                            Width="32" Height="28">
                        <Path Data="M 3 9H 5L 9 5H 11V 19H 9V 15H 5V 9 Z M 13 9L 17 5V 19L 13 15Z"
                              Stretch="Uniform"
                              Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    </Button>
                </StackPanel>

                <Rectangle Width="1" Height="20" Fill="#3F3F46" Margin="8,0" />

                <StackPanel Orientation="Horizontal" Margin="8,0">
                    <Button x:Name="BtnScreenshot"
                            Click="OnScreenshot"
                            ToolTip.Tip="Screenshot (S)"
                            Width="32" Height="28">
                        <Path Data="M 4 4H 20V 20H 4V 4 Z M 8 8H 10V 16H 8V 8 Z M 12 8H 14V 16H 12V 8 Z M 16 8H 18V 16H 16V 8 Z"
                              Stretch="Uniform"
                              Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    </Button>

                    <Button x:Name="BtnFullscreen" Margin="4,0,0,0"
                            Click="OnToggleFullscreen"
                            ToolTip.Tip="Fullscreen (F)"
                            Width="32" Height="28">
                        <Path Data="M 4 4H 6V 6H 4V 4 Z M 8 4H 10V 6H 8V 4 Z M 12 4H 14V 6H 12V 4 Z M 16 4H 18V 6H 16V 4 Z M 4 8H 6V 10H 4V 8 Z M 16 8H 18V 10H 16V 8 Z M 4 12H 6V 14H 4V 12 Z M 12 12H 14V 14H 12V 12 Z M 4 16H 6V 18H 4V 16 Z M 8 16H 10V 18H 8V 16 Z M 12 16H 14V 18H 12V 16 Z M 16 16H 18V 18H 16V 16 Z"
                              Stretch="Uniform"
                              Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    </Button>

                    <Button x:Name="BtnNextChapter" Margin="8,0,0,0"
                            Click="OnNextChapter"
                            ToolTip.Tip="Next Chapter (P)"
                            Width="32" Height="28">
                        <Path Data="M 8 5V 19L 16 12L 8 5 Z"
                              Stretch="Uniform"
                              Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    </Button>

                    <Button x:Name="BtnPrevChapter" Margin="4,0,0,0"
                            Click="OnPrevChapter"
                            ToolTip.Tip="Previous Chapter (Shift+P)"
                            Width="32" Height="28">
                        <Path Data="M 16 5V 19L 8 12L 16 5 Z"
                              Stretch="Uniform"
                              Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ======================== -->
        <!--  VIDEO PANEL             -->
        <!-- ======================== -->
        <Grid Grid.Row="1">
            <Grid.Background>
                <SolidColorBrush Color="Black" />
            </Grid.Background>
            <ctrl:D3D11VideoHost x:Name="VideoHost" />

            <!-- Position overlay (bottom-left) -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="8" Padding="6,3"
                    Background="#80000000" CornerRadius="3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PositionText, Mode=OneWay}"
                               Foreground="White" FontFamily="Consolas" FontSize="13"
                               VerticalAlignment="Center" />
                    <TextBlock Text=" / " Foreground="Gray"
                               FontFamily="Consolas" FontSize="13"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DurationText, Mode=OneWay}"
                               Foreground="White" FontFamily="Consolas" FontSize="13"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Chapter badge (top-right) -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="8" Padding="6,3"
                    Background="#80000000" CornerRadius="3">
                <TextBlock Text="{Binding ChapterTitle, Mode=OneWay}"
                           Foreground="White" FontSize="12"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- ======================== -->
        <!--  SEEK BAR                -->
        <!-- ======================== -->
        <Border Grid.Row="2" Background="#E0000000">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="8,4">
                <TextBlock Grid.Column="0" Text="{Binding PositionText, Mode=OneWay}"
                           Foreground="White" FontFamily="Consolas" FontSize="13"
                           VerticalAlignment="Center" />
                <Slider Grid.Column="1" x:Name="SeekSlider"
                        Minimum="0" Maximum="1" Value="{Binding SeekValue, Mode=TwoWay}"
                        VerticalAlignment="Center" Margin="8,0" />
                <TextBlock Grid.Column="2" Text="{Binding DurationText, Mode=OneWay}"
                           Foreground="White" FontFamily="Consolas" FontSize="13"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>