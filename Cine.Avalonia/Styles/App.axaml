<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="Background" Value="#1E1E1E" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="Button.transport">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.transport:hover">
        <Setter Property="Background" Value="#3E3E40" />
    </Style>

    <Style Selector="Button.transport:pressed">
        <Setter Property="Background" Value="#5A5A5A" />
    </Style>

    <Style Selector="Slider.volume">
        <Setter Property="Width" Value="120" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="150" />
    </Style>

    <Style Selector="Slider.seek">
        <Setter Property="Height" Value="32" />
    </Style>

    <Style Selector="TextBlock.status-label">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Consolas, Courier New, monospace" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
</Styles>