<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Cine.Avalonia.Views.Components.ReplayOverlay"
             x:Name="ReplayOverlayRoot">
    <Border x:Name="ReplayOverlayBorder"
            ZIndex="30" IsVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{StaticResource AppOverlayLight}" CornerRadius="{StaticResource radius-md}" Padding="{StaticResource space-5}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" OffsetY="4" Color="#40000000" />
        </Border.Effect>
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.100" />
            </Transitions>
        </Border.Transitions>
        <StackPanel Spacing="8" HorizontalAlignment="Center">
            <Button x:Name="BtnReplay"
                    Classes="circular-transport" Width="56" Height="56"
                    Click="OnReplayClick">
                <materialIcons:MaterialIcon Kind="Play" Width="24" Height="24"
                    Foreground="{StaticResource OsdForeground}" />
            </Button>
            <TextBlock Text="Replay" Foreground="{StaticResource OsdForeground}"
                       Classes="md3-body2" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
