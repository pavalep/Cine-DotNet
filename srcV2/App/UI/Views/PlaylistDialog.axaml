<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Cine.Avalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
        x:Class="Cine.Avalonia.Views.PlaylistDialog"
        x:DataType="vm:MainViewModel"
        Title="Playlist"
        Width="600" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}"
        ExtendClientAreaToDecorationsHint="True">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0" Height="50" ColumnDefinitions="Auto,*,Auto" Background="{StaticResource HeaderBackground}">
            <Button Grid.Column="0" 
                    Classes="flat" 
                    Margin="8,0"
                    Click="OnAddFilesClick"
                    ToolTip.Tip="Add Files">
                <Path Data="{StaticResource PlaylistAddIcon}" Width="16" Height="16" Fill="{StaticResource OsdForeground}" Stretch="Uniform" />
            </Button>
            <TextBlock Grid.Column="1" Text="Playlist" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Grid>

        <!-- Main Content -->
        <Panel Grid.Row="1">
            <ScrollViewer>
                <ListBox ItemsSource="{Binding PlaylistItems}" 
                         Background="Transparent"
                         SelectionMode="Single"
                         Margin="8">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="Margin" Value="0,2" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlaylistItemViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <!-- Playing Icon -->
                                <Path Grid.Column="0" 
                                      Data="{StaticResource PlayIcon}" 
                                      Width="12" Height="12" 
                                      Fill="{StaticResource AccentBrush}" 
                                      Stretch="Uniform" 
                                      Margin="0,0,12,0"
                                      IsVisible="{Binding IsPlaying}" />
                                
                                <!-- File Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Directory}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Title}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Play Button -->
                                <Button Grid.Column="2" 
                                        Classes="circular-transport" 
                                        Command="{Binding Play}"
                                        Width="32" Height="32">
                                    <Path Data="{StaticResource PlayIcon}" Width="12" Height="12" Fill="{StaticResource OsdForeground}" Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <!-- Drop Indicator -->
            <Border x:Name="DropIndicatorRevealer" 
                    IsVisible="False" 
                    Background="#80000000" 
                    CornerRadius="8" 
                    Margin="16">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <Path Data="{StaticResource PlaylistAddIcon}" Width="64" Height="64" Fill="{StaticResource OsdForeground}" Stretch="Uniform" />
                    <TextBlock Text="Add to Playlist" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Panel>
    </Grid>
</Window>