<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Cine.Avalonia.Dialogs.PipWindow"
        Title="Cine — PIP"
        Width="480" Height="320"
        MinWidth="280" MinHeight="180"
        MaxWidth="1920" MaxHeight="1080"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        WindowDecorations="None"
        Background="{StaticResource AppBackground}"
        PointerMoved="OnPipWindowPointerMoved">

    <Window.Styles>
        <Style Selector="Border.pip-container">
            <Setter Property="CornerRadius" Value="{StaticResource radius-lg}" />
            <Setter Property="Background" Value="{StaticResource AppBackground}" />
            <!-- BoxShadow removed: avoid parsing platform-specific tokens (e.g., 'px') that break Avalonia XAML parsing -->
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.pip-resize-edge">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Border.pip-hover-overlay">
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.pip-top-bar">
            <Setter Property="Background" Value="#AA000000" />
        </Style>
        <Style Selector="Grid.pip-bottom-bar">
            <Setter Property="Background" Value="#AA000000" />
        </Style>
        <Style Selector="Button.pip-btn">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource radius-md}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.pip-btn:pointerover">
            <Setter Property="Background" Value="{StaticResource ButtonHoverBackground}" />
        </Style>
        <Style Selector="Button.pip-center-play">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#33000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource radius-full}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.pip-center-play:pointerover">
            <Setter Property="Background" Value="#55000000" />
        </Style>
        <Style Selector="Border.pip-seek-thumb">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="{StaticResource radius-sm}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.12" Easing="{StaticResource ease-standard}" />
                    <DoubleTransition Property="Height" Duration="0:0:0.12" Easing="{StaticResource ease-standard}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.pip-seek-thumb:pointerover">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="{StaticResource radius-md}" />
        </Style>
    </Window.Styles>

    <!-- Single Grid: video container + controls + resize handles -->
    <Grid>
        <Border Classes="pip-container">
            <Grid>
                <!-- Video container for child HWND (render API path - frame delivered via UpdateFrame) -->
                <Border x:Name="VideoArea"
                        Background="{StaticResource AppBackground}"
                        ClipToBounds="True"
                        CornerRadius="{StaticResource radius-lg}">
                    <Image x:Name="PipVideoFrame"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           Stretch="Uniform"
                           IsHitTestVisible="False" />
                </Border>

                <!-- Loading overlay -->
                <Border x:Name="LoadingOverlay"
                        Background="#99000000"
                        IsVisible="False"
                        IsHitTestVisible="False"
                        CornerRadius="{StaticResource radius-lg}">
                    <TextBlock Text="Starting Picture-in-Picture&#x2026;"
                               Foreground="White"
                               Classes="md3-caption"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                </Border>

                <!-- Hover overlay: controls on top of DWM video, clipped DWM avoids them -->
                <Border x:Name="HoverOverlay"
                        Classes="pip-hover-overlay"
                        Opacity="1">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- ROW 0: Top bar (drag to move + return + close) -->
                        <Grid Grid.Row="0" Classes="pip-top-bar"
                              Height="40"
                              ColumnDefinitions="*,Auto"
                              PointerPressed="OnTopBarPointerPressed"
                              PointerEntered="OnTopBarPointerEntered"
                              PointerExited="OnTopBarPointerExited">
                            <TextBlock Grid.Column="0" x:Name="PipFileName"
                                       Classes="md3-body2"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Text="Cine PiP" />
                            <Button Grid.Column="1" x:Name="ExpandButton"
                                    Classes="pip-btn"
                                    ToolTip.Tip="Return to Main Window"
                                    AutomationProperties.Name="Return to main window"
                                    Click="OnExpandClick">
                                <materialIcons:MaterialIcon Kind="PictureInPictureBottomRightOutline"
                                    Width="16" Height="16"
                                    Foreground="White" />
                            </Button>
                        </Grid>

                        <!-- ROW 1: Center play/pause -->
                        <Button Grid.Row="1" x:Name="PlayPauseButton"
                                Classes="pip-center-play"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                PointerEntered="OnCenterPointerEntered"
                                PointerExited="OnCenterPointerExited"
                                Click="OnPlayPauseClick"
                                AutomationProperties.Name="Play or pause">
                            <materialIcons:MaterialIcon x:Name="PlayPauseIcon"
                                Kind="Play" Width="22" Height="22"
                                Foreground="White" />
                        </Button>

                        <!-- ROW 2: Bottom bar (seek + mute) -->
                        <Grid Grid.Row="2" Classes="pip-bottom-bar"
                              ColumnDefinitions="*,Auto"
                              Height="36"
                              PointerEntered="OnBottomBarPointerEntered"
                              PointerExited="OnBottomBarPointerExited">
                            <Grid Grid.Column="0" x:Name="PipSeekArea"
                                  Height="24"
                                  Margin="10,0,6,0"
                                  Background="Transparent"
                                  VerticalAlignment="Center"
                                  PointerMoved="OnPipSeekPointerMoved"
                                  PointerPressed="OnPipSeekPointerPressed"
                                  PointerReleased="OnPipSeekPointerReleased"
                                  PointerExited="OnPipSeekPointerExited"
                                  Cursor="Hand">
                                <Border x:Name="PipSeekTrack"
                                        Height="4" CornerRadius="2"
                                        Background="#40FFFFFF"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False" />
                                <Border x:Name="PipSeekFill"
                                        Height="4" CornerRadius="2"
                                        HorizontalAlignment="Left"
                                        Background="White"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False" />
                                <Border x:Name="PipSeekThumb"
                                        Classes="pip-seek-thumb"
                                        IsVisible="False" />
                            </Grid>
                            <Button Grid.Column="1" x:Name="MuteButton"
                                    Classes="pip-btn"
                                    ToolTip.Tip="Toggle mute"
                                    Margin="0,0,6,0"
                                    Click="OnMuteToggle"
                                    AutomationProperties.Name="Toggle mute">
                                <materialIcons:MaterialIcon x:Name="MuteIcon"
                                    Kind="VolumeHigh"
                                    Width="16" Height="16"
                                    Foreground="White" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- Resize handles (ZIndex ensures they stay on top of pip-container) -->
        <Border Background="Transparent" IsHitTestVisible="True" ZIndex="100"
                HorizontalAlignment="Stretch" VerticalAlignment="Top"
                Height="8" Cursor="SizeNorthSouth"
                PointerPressed="OnTopEdgePointerPressed" />
        <Border Background="Transparent" IsHitTestVisible="True" ZIndex="100"
                HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                Height="8" Cursor="SizeNorthSouth"
                PointerPressed="OnBottomEdgePointerPressed" />
        <Border Background="Transparent" IsHitTestVisible="True" ZIndex="100"
                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                Width="8" Cursor="SizeWestEast"
                PointerPressed="OnLeftEdgePointerPressed" />
        <Border Background="Transparent" IsHitTestVisible="True" ZIndex="100"
                HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Width="8" Cursor="SizeWestEast"
                PointerPressed="OnRightEdgePointerPressed" />
        <Border Background="Transparent" IsHitTestVisible="True" ZIndex="101"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Width="14" Height="14" Cursor="TopLeftCorner"
                PointerPressed="OnTopLeftCornerPointerPressed" />
        <Border Background="Transparent" IsHitTestVisible="True" ZIndex="101"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="14" Height="14" Cursor="TopRightCorner"
                PointerPressed="OnTopRightCornerPointerPressed" />
        <Border Background="Transparent" IsHitTestVisible="True" ZIndex="101"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Width="14" Height="14" Cursor="BottomLeftCorner"
                PointerPressed="OnBottomLeftCornerPointerPressed" />
        <Border Background="Transparent" IsHitTestVisible="True" ZIndex="101"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Width="14" Height="14" Cursor="BottomRightCorner"
                PointerPressed="OnBottomRightCornerPointerPressed" />
    </Grid>
</Window>
