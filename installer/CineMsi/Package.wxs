<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <!--
        Package.wxs — Auto-generated by `wix harvest` during build.
        This is a placeholder for IDE support. The actual file is generated
        by the build script (build.bat) using:
            wix harvest dir <publish_dir> -componentGroups CineFiles -out Package.wxs
    -->
    <Fragment>
        <ComponentGroup Id="CineFiles" Directory="INSTALLDIR">
            <!-- Harvested files will be listed here at build time -->
        </ComponentGroup>
    </Fragment>
</Wix>
