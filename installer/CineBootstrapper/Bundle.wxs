<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/util">

    <Bundle Name="Cine Media Player"
            Version="!(bind.packageVersion.CineMsi)"
            Manufacturer="Cine"
            UpgradeCode="B5A1C2D3-E4F5-6789-ABCD-EF0123456789"
            IconSourceFile="..\Assets\Logo.png"
            HelpUrl="https://github.com/diegopvlk/Cine">

        <!-- Custom Burn theme with multi-page wizard -->
        <BootstrapperApplication>
            <bal:WixStandardBootstrapperApplication
                ThemeFile="Theme\Theme.xml"
                LocalizationFile="Theme\Theme.wxl"
                LogoFile="..\Assets\Logo.png"
                BackgroundCacheFolder="CineSetup" />
        </BootstrapperApplication>

        <!-- =========================================================================
             .NET 10 Runtime Detection
             Searches registry for installed .NET 10 Desktop Runtime.
             ========================================================================= -->

        <util:RegistrySearch Id="DotNet10Search"
                             Root="HKLM"
                             Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedfx\Microsoft.NETCore.App\10.0.0"
                             Value="Version"
                             Variable="DotNet10Version"
                             Result="value" />

        <util:RegistrySearch Id="DotNet10DesktopSearch"
                             Root="HKLM"
                             Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedfx\Microsoft.WindowsDesktop.App\10.0.0"
                             Value="Version"
                             Variable="DotNet10DesktopVersion"
                             Result="value" />

        <util:RegistrySearch Id="DotNet10BaseSearch"
                             Root="HKLM"
                             Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedfx\Microsoft.NETCore.App"
                             Variable="DotNet10Base"
                             Result="exists" />

        <!-- =========================================================================
             Variables & Properties
             ========================================================================= -->

        <Variable Name="InstallFolder"
                  Type="string"
                  Value="[ProgramFiles64Folder]Cine" />

        <!-- Track whether .NET runtime is needed (for UI conditional display) -->
        <Variable Name="DotNetNeeded" Type="numeric" Value="0" />
        <Variable Name="DotNetDownloadUrl"
                  Type="string"
                  Value="https://download.visualstudio.microsoft.com/download/pr/12345678-90ab-cdef-1234-567890abcdef/1234567890abcdef1234567890abcdef/windowsdesktop-runtime-10.0.0-win-x64.exe" />

        <!-- =========================================================================
             Chain: Steps executed in order
             ========================================================================= -->
        <Chain>
            <!-- Step 1: Download & install .NET 10 Desktop Runtime if missing -->
            <ExePackage Id="DotNetRuntime"
                        Name="Microsoft .NET 10 Desktop Runtime"
                        DisplayName=".NET 10 Desktop Runtime"
                        Description="Required by Cine Media Player"
                        Cache="no"
                        Compressed="no"
                        Permanent="yes"
                        Vital="yes"
                        DownloadUrl="!(bind.Variable.DotNetDownloadUrl)"
                        DetectCondition="DotNet10DesktopVersion"
                        InstallCommand="/install /quiet /norestart"
                        RepairCommand="/repair /quiet /norestart"
                        UninstallCommand="/uninstall /quiet /norestart"
                        Protocol="netfx4">

                <!-- WiX reports download progress automatically to the bootstrapper UI -->
                <ExitCode Behavior="forceReboot" />
            </ExePackage>

            <!-- Step 2: Install the Cine MSI -->
            <MsiPackage Id="CineMsi"
                        SourceFile="..\CineMsi\bin\Release\Cine.msi"
                        DisplayInternalUI="no"
                        Vital="yes"
                        Compressed="yes"
                        After="DotNetRuntime">
                <MsiProperty Name="ARPPRODUCTICON" Value="AppIcon.ico" />
                <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
            </MsiPackage>
        </Chain>

        <!-- Logging -->
        <Log PathVariable="%TEMP%\CineSetup.log" Prefix="CineSetup_" Extension=".log" />
    </Bundle>
</Wix>
