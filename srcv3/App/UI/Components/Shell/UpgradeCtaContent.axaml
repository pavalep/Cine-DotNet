<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="140"
             x:Class="Cine.Avalonia.Components.UpgradeCtaContent"
             MinWidth="200">
    <Border Background="#2A2A2A"
            CornerRadius="8"
            Padding="20"
            BorderBrush="#FFA500"
            BorderThickness="1">
        <StackPanel Spacing="12" HorizontalAlignment="Center">
            <!-- Lock icon -->
            <Border Background="#3A3A3A"
                    CornerRadius="20"
                    Width="40" Height="40"
                    HorizontalAlignment="Center">
                <TextBlock Text="&#x1F512;"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <!-- Heading -->
            <TextBlock Text="Premium Feature"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center" />

            <!-- Description -->
            <TextBlock Text="This feature is available in the full version. Upgrade to unlock all capabilities."
                       FontSize="12"
                       Foreground="#B0B0B0"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <!-- Upgrade button -->
            <Button x:Name="UpgradeBtn"
                    Content="Upgrade Now"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Padding="16 6"
                    Background="#FFA500"
                    Foreground="#1A1A1A"
                    BorderThickness="0"
                    CornerRadius="4"
                    Cursor="Hand"
                    HorizontalAlignment="Center"
                    Click="OnUpgradeClick" />
        </StackPanel>
    </Border>
</UserControl>
