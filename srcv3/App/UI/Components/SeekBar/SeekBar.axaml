<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cine.Avalonia.ViewModels"
             x:Class="Cine.Avalonia.Components.SeekBar"
             x:DataType="vm:MainViewModel"
             x:Name="SeekBarRoot">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{StaticResource space-spacing-1}">

        <!-- Seek Area (hexpand, with chapter markers) -->
        <Grid Grid.Column="0"
              x:Name="SeekArea"
              Margin="{StaticResource space-h-2}"
              PointerMoved="OnSeekAreaPointerMoved"
              PointerExited="OnSeekAreaPointerExited"
              PointerWheelChanged="OnSeekAreaPointerWheelChanged"
              PointerPressed="OnSeekAreaPointerPressed"
              PointerReleased="OnSeekAreaPointerReleased"
              Background="Transparent">

            <Border x:Name="SeekTrack"
                    Background="{StaticResource ProgressTroughBackground}"
                    CornerRadius="2"
                    Height="4"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False" />

            <Border x:Name="SeekFill"
                    Background="{StaticResource SeekFillGradient}"
                    CornerRadius="2"
                    Height="4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" OffsetY="0" Color="#4D5B9BD5" />
                </Border.Effect>
            </Border>

            <Border x:Name="SeekThumb"
                    Width="16" Height="16"
                    CornerRadius="8"
                    Background="{StaticResource ProgressSliderBackground}"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" OffsetY="1.5" Color="#4D5B9BD5" />
                </Border.Effect>
            </Border>

            <ItemsControl x:Name="ChapterMarkersControl"
                          ItemsSource="{Binding ChapterMarkers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas IsHitTestVisible="False" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="3" Height="12"
                              Background="Transparent">
                            <Rectangle Width="3" Height="12"
                                       Fill="{StaticResource OsdForeground}"
                                       Opacity="0.6"
                                       AutomationProperties.Name="Chapter marker" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="ChapterPreviewPopover"
                    IsVisible="True"
                    Opacity="0"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{StaticResource PopoverBackground}"
                    CornerRadius="4"
                    Padding="6,3"
                    BoxShadow="{StaticResource elevation-4}"
                    RenderTransformOrigin="0,0">
                <Border.RenderTransform>
                    <TranslateTransform X="0" Y="-26" />
                </Border.RenderTransform>
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                    </Transitions>
                </Border.Transitions>
                <TextBlock x:Name="ChapterPreviewText"
                           Text="Chapter"
                           FontSize="11"
                           Foreground="{StaticResource OsdForeground}" />
            </Border>
        </Grid>

        <TextBlock Grid.Column="1"
                   x:Name="PositionTimeLabel"
                   Classes="time-label"
                   MinWidth="45"
                   Text="00:00"
                   VerticalAlignment="Center"
                   Margin="{StaticResource space-h-1}"
                   PointerPressed="OnPositionTimeLabelPressed"
                   Cursor="Hand" />

        <Border Grid.Column="2"
                Width="2" Height="16"
                Margin="{StaticResource space-h-2}"
                CornerRadius="2"
                Background="{StaticResource TimeSeparatorBackground}"
                Opacity="0.5"
                VerticalAlignment="Center" />

        <TextBlock Grid.Column="3"
                   x:Name="DurationTimeLabel"
                   Classes="time-label"
                   MinWidth="45"
                   Text="00:00"
                   Margin="{StaticResource space-h-1}"
                   VerticalAlignment="Center"
                   AutomationProperties.Name="Total duration" />
    </Grid>
</UserControl>
