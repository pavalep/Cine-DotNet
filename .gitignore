# Windows-Native .gitignore
# -------------------------

# Build outputs
bin/
obj/
Debug/
Release/
publish/
publish-sc/
resources/
video/
reference/

# MSIX packaging output
dist/
*.msix
*.msixbundle
*.appinstaller

# Certificates (never commit)
*.pfx
*.p12
*.cer
# Self-signed dev cert is generated locally

# Test results
*.trx
TestResults/

# IDE files
.vs/
*.suo
*.user
*.userosscache
*.csproj.user
.idea/
*.sln.DotSettings.user

# OS files
Thumbs.db
[Dd]esktop.ini
.DS_Store

# Backup/temp files
*.bak
*.tmp
*~
*.log

# NuGet packages
packages/
*.nupkg
project.nuget.cache
*.nuget.props
*.nuget.targets

# Compiled app output
Cine.exe.zip
Cine.WinUI.exe

# Python reference build artifacts
build/
*.flatpak
*.flatpak-builder

# dotnet tool
.dotnet/

# Editor temp files
*.swp
*.swo
*.swn